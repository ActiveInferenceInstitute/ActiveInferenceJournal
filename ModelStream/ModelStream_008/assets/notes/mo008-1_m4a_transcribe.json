xt': 'multi', 'start': 3276662, 'end': 3276966, 'confidence': 0.54179, 'speaker': 'A'}, {'text': 'objective,', 'start': 3276998, 'end': 3277542, 'confidence': 0.9997, 'speaker': 'A'}, {'text': "it's", 'start': 3277606, 'end': 3277846, 'confidence': 0.9891, 'speaker': 'A'}, {'text': 'multidimensional,', 'start': 3277878, 'end': 3278694, 'confidence': 0.59613, 'speaker': 'A'}, {'text': "it's", 'start': 3278742, 'end': 3278998, 'confidence': 0.79199, 'speaker': 'A'}, {'text': 'multi', 'start': 3279014, 'end': 3279318, 'confidence': 0.87389, 'speaker': 'A'}, {'text': 'goal.', 'start': 3279334, 'end': 3279686, 'confidence': 0.6335, 'speaker': 'A'}], 'speaker': 'A'}, {'text': "But it doesn't have to be multi objective with empowerment.", 'start': 3279718, 'end': 3287850, 'confidence': 1.0, 'words': [{'text': 'But', 'start': 3279718, 'end': 3279866, 'confidence': 1.0, 'speaker': 'A'}, {'text': 'it', 'start': 3279888, 'end': 3280026, 'confidence': 0.99997, 'speaker': 'A'}, {'text': "doesn't", 'start': 3280048, 'end': 3280246, 'confidence': 0.99896, 'speaker': 'A'}, {'text': 'have', 'start': 3280278, 'end': 3280426, 'confidence': 0.99999, 'speaker': 'A'}, {'text': 'to', 'start': 3280448, 'end': 3280586, 'confidence': 1.0, 'speaker': 'A'}, {'text': 'be', 'start': 3280608, 'end': 3280746, 'confidence': 1.0, 'speaker': 'A'}, {'text': 'multi', 'start': 3280768, 'end': 3281138, 'confidence': 0.98478, 'speaker': 'A'}, {'text': 'objective', 'start': 3281174, 'end': 3282030, 'confidence': 0.87893, 'speaker': 'A'}, {'text': 'with', 'start': 3286930, 'end': 3287294, 'confidence': 0.99993, 'speaker': 'A'}, {'text': 'empowerment.', 'start': 3287332, 'end': 3287850, 'confidence': 0.98991, 'speaker': 'A'}], 'speaker': 'A'}, {'text': "You don't have weighted combinations of empowerment.", 'start': 3287930, 'end': 3290510, 'confidence': 0.99999, 'words': [{'text': 'You', 'start': 3287930, 'end': 3288126, 'confidence': 0.99999, 'speaker': 'A'}, {'text': "don't", 'start': 3288148, 'end': 3288