ans'], 'to': 'Africans'}, {'from': ['ai'], 'to': 'AI'}, {'from': ['albarrassin', 'albarracin'], 'to': 'Albarracin'}, {'from': ['ander'], 'to': 'Ander'}, {'from': ['anthony'], 'to': 'Anthony'}, {'from': ['atlantic'], 'to': 'Atlantic'}, {'from': ['australia'], 'to': 'Australia'}, {'from': ['avil', 'aval', 'avel'], 'to': 'Avel'}, {'from': ["avel's", "aval's", "avel's"], 'to': "Avel's"}, {'from': ['bayesian'], 'to': 'Bayesian'}, {'from': ['ben'], 'to': 'Ben'}, {'from': ['bryn'], 'to': 'Bryn'}, {'from': ['carhartt'], 'to': 'Carhart'}, {'from': ['carl'], 'to': 'Karl'}, {'from': ['chomsky'], 'to': 'Chomsky'}, {'from': ['clio'], 'to': 'Clio'}, {'from': ['daniel'], 'to': 'Daniel'}, {'from': ['davis'], 'to': 'Davis'}, {'from': ['democrats'], 'to': 'Democrats'}, {'from': ['desantis'], 'to': 'DeSantis'}, {'from': ['deuhurst'], 'to': 'Dewhurst'}, {'from': ['donald'], 'to': 'Donald'}, {'from': ['efe'], 'to': 'EFE'}, {'from': ['english'], 'to': 'English'}, {'from': ['france'], 'to': 'France'}, {'from': ['french'], 'to': 'French'}, {'from': ['friston', 'fristen'], 'to': 'Friston'}, {'from': ['gina'], 'to': 'Gina'}, {'from': ['howie'], 'to': 'Hohwy'}, {'from': ['gonzala'], 'to': 'Gonzala'}, {'from': ['hungarian'], 'to': 'Hungarian'}, {'from': ['icelandic'], 'to': 'Icelandic'}, {'from': ['july'], 'to': 'July'}, {'from': ['kairos'], 'to': 'Kairos'}, {'from': ['laurence', 'lawrence'], 'to': 'Laurence'}, {'from': ['lgbtq'], 'to': 'LGBTQ'}, {'from': ['lippmann'], 'to': 'Lippmann'}, {'from': ['mao', 'mahault'], 'to': 'Mahault'}, {'from': ['michael'], 'to': 'Michael'}, {'from': ['miller'], 'to': 'Miller'}, {'from': ['montréal'], 'to': 'Montréal'}, {'from': ['napoleon'], 'to': 'Napoleon'}, {'from': ['phd'], 'to': 'PhD'}, {'from': ['prussia'], 'to': 'Prussia'}, {'from': ['québec'], 'to': 'Québec'}, {'from': ['ramstard'], 'to': 'Ramstead'}, {'from': ['renaissance'], 'to': 'Renaissance'}, {'from': ['republicans'], 'to': 'Republicans'}, {'from': ['reykjavik'], 'to': 'Reykjavik'}, {'from': ['robin'], 'to': 'Robin'}, {'from': ['ron'], 'to': 'Ron'}, {'from': ['scott'], 'to': 'Scott'}, {'from': ["scott's"], 'to': "Scott's"}, {'from': ['senegal'], 'to': 'Senegal'}, {'from': ['slav'], 'to': 'Slav'}, {'from': ['sumato'], 'to': 'Sumato'}, {'from': ['sussex'], 'to': 'Sussex'}, {'from': ['svamato'], 'to': 'Svamato'}, {'from': ['triomphe'], 'to': 'Triomphe'}, {'from': ['trump'], 'to': 'Trump'}, {'from': ['tv'], 'to': 'TV'}, {'from': ['u.s.'], 'to': 'U.S.'}, {'from': ['université'], 'to': 'Université'}, {'from': ['waddington'], 'to': 'Waddington'}, {'from': ["waddington's"], 'to': "Waddington's"}, {'from': ['wade'], 'to': 'Wade'}, {'from': ['walter'], 'to': 'Walter'}, {'from': ['wikipedia'], 'to': 'Wikipedia'}, {'from': ['wollongong'], 'to': 'Wollongong'}, {'from': ['youtube'], 'to': 'YouTube'}], 'throttled': None, 'auto_chapters': True, 'summarization': False, 'summary_type': None, 'summary_model': None, 'custom_topics': False, 'topics': [], 'speech_threshold': None, 'disfluencies': False, 'sentiment_analysis': True, 'chapters': [{'summary': "You. All right. And we are in the discussion section, basics of Active Inference. This is the first discussion section that we've had for this course. And it's going to be regarding the topics that Ben White introduced in his recent lecture. Perhaps some of our first time live streaming guests.", 'gist': '', 'headline': 'Discussion section on basics of Active Inference begins July 25, 2023', 'start': 420, 'end': 55240}, {'summary': "Darius is a Master's student at UCL in social distributed cognition. Francisco Balsan is a PhD student at the University of Bologna, Italy. Working on intersection between artificial intelligence and education. Currently interested in multiscale active inference models of scientific cognition.", 'gist': 'Active Inference in Scientific Cognition', 'headline': 'Francisco Balsan is interested in active inference models of scientific cognition', 'start': 67850, 'end': 185020}, {'summary': "Would anybody else like to introduce themselves before we start? So you go first. I'm using perceptual control theory at the minute to model examples of effective practice in organizations. How might that level of abstraction be useful in what I'm doing?", 'gist': 'In the Know: Perceptual Control Theory', 'headline': "Would anybody else like to introduce themselves before we start? So you go first. I'm Regina Sagin", 'start': 188760, 'end': 332260}, {'summary': "The lecture last week was on the basics of active inference. The objective really was to lay the groundwork for future weeks in this course. In the subsequent weeks, we're going to be looking at topics like collective behavior, social cognition, shared norms. The questions here don't have to be specifically tethered to that lecture.", 'gist': 'Basic questions on Active Inference', 'headline': 'The lecture last week was on the basics of active inference', 'start': 333350, 'end': 469858}, {'summary': 'How does creativity and science in general enter active imperents? How does trying to be creative and not doing what you predict enter this room? Feel free to jump in whenever you want.', 'gist': 'Dark Room and Creativity', 'headline': 'How does trying to be creative enter active imperents in science', 'start': 470024, 'end': 1004038}, {'summary': "There's something really special in the creation of art, especially in a public sphere, that I think is so interesting. There's a new collection coming out in Philosophical Trans B on Art and Predictive Processing. There are ways that we can bring our Generative model out and put it into the public sphere.", 'gist': 'Art and Predictive Processing', 'headline': 'There are ways we can bring our Generative model out and put it into public sphere', 'start': 1004134, 'end': 1099800}, {'summary': "There's lots and lots of stuff on the value of uncertainty. It kind of is very much at the forefront of some of the really interesting philosophical applications of the framework. Also, we have a new paper coming out on horror movies. I'm pretty interested in this, but it's the same as going to the magic show.", 'gist': 'Ah, the Value of Uncertainty', 'headline': 'There are some interesting papers on the value of uncertainty in predictive processing', 'start': 1101390, 'end': 1532360}, {'summary': 'Darius: My question is regarding the notion of affordances. I was just wondering whether, as philosophers, you and Mark have thought about what is it like for the whole system to be in the business of reducing its prediction error. Could affordances change based on the agent arena relationship?', 'gist': 'On the Fluidity of Affordances', 'headline': "Eric Brunsten: I'm interested in flow states and affordances", 'start': 1534730, 'end': 1891000}, {'summary': "Ben: There's a distinction between a landscape of affordances and a field of affordance. The distinction is directly targeting the dynamic, shifting, very affective nature of affordedances. As soon as you provoke affordance, you're provoking phenomenology, Ben says.", 'gist': 'Exploring the Landscape of Affordances', 'headline': 'Ben: Darius makes a distinction between landscape and field of affordances', 'start': 1891450, 'end': 2166126}, {'summary': "The symmetry of agents and environment is a property of active inference. There are basically three position you can have on that. One is that active inference is correct. Another is that we don't have affordances based on whatever is the formal presentation. And the third is thatactive inference is wrong.", 'gist': 'Active Inference and Phenomenology', 'headline': 'Frazier principle says that agents and environment have affordances', 'start': 2166228, 'end': 2383990}, {'summary': "Anybody else want to come in on a question of affordances? Because I know affordance has played a fairly substantial role in the lecture. Anybody has any questions related to affordances or action perception affordances, then now's the time.", 'gist': 'A Question on Affordances in AI', 'headline': 'Anybody else want to come in on a question of affordances', 'start': 2387210, 'end': 2481090}, {'summary': "Darius: There's a point at which the theory of affordances starts to break down to ambient technology. Early stages of a paper on the role of generative AI in classrooms. I'm trying to follow it through the active inference framework from a multi level perspective.", 'gist': 'The role of generative AI in classrooms', 'headline': 'Early stages of a paper on the role of generative AI in classrooms', 'start': 2481160, 'end': 2675350}, {'summary': 'Ben mark: Is there a conflict there between the general priors that the system has and then violating those expectations by going over and above them? How do you kind of resolve that tension? Mark: Precision is going to be weighted in lots of different ways. The real frontier of this research is to find how these things are instantiated.', 'gist': 'Measuring the quality of predictions', 'headline': 'Ben Marks: System is monitoring its own predictive processing regimes', 'start': 2677930, 'end': 3202620}, {'summary': "In organizations, there tends to be a drift towards risk aversion. How does the value of uncertainty translate onto how is it scalable in that sense? One of the things we're going to see in subsequent weeks is how it scales up to larger systems.", 'gist': 'The value of uncertainty in business', 'headline': 'Ryan Smith: How does the value of uncertainty translate onto how is it scalable', 'start': 3207060, 'end': 3662976}, {'summary': "You can take an active role in mindfully observing your own reactions to volatility. Something really special happens when the system models its own reaction. How that translates into business, I'm not sure. I know tolerance to uncertainty is a marker of business success.", 'gist': 'Understanding the Value of Risk', 'headline': 'Systems learn to tolerate uncertainty when it models its own reaction to volatility', 'start': 3663158, 'end': 3722100}, {'summary': 'Mark Whitaker: Is there anything about the role of language in kind of modulating those metacognitive? He says language might help by invoking cognitive flexibility. Whitaker says we can also manage volatility by redeploying precision in a better way.', 'gist': 'The role of language in the management of uncertainty', 'headline': 'Nick Clark: Language can help manage volatility by invoking cognitive flexibility', 'start': 3722440, 'end': 4130856}, {'summary': "Risk and danger are two things that I've been really interested in across a kind of variety of different contexts. Even in the case of a collective like a business, you still have to take into account the environment in which the business is operating. This is something that's probably going to come up again in subsequent weeks.", 'gist': 'Contextualization of Risk and Danger', 'headline': 'I would emphasize the importance of external context here as well', 'start': 4130878, 'end': 4229960}, {'summary': "Flow is a phenomenological offshoot of being optimally reducing prediction error. It seems to me that that becomes a regulatory function when that optimality is reduced. I'm wondering how deep that runs and what we can say about the role of agency and selfhood.", 'gist': 'The Limits of Self-Language', 'headline': 'Flow seems to reduce self consciousness when optimally producing prediction error', 'start': 4230030, 'end': 4445708}, {'summary': "There's some really interesting work on psychedelics by George Dean and some of George Dean's co conspirators. A paper recently showed the efficacy of internal self talk on sports performance. It calls into question to what extent are these psychotechnologies effective?", 'gist': 'Self-talk and the neuroscience of consciousness', 'headline': "There's some interesting work on psychedelics by George Dean and others", 'start': 4445794, 'end': 4587690}, {'summary': 'Self food is a high level construct that emerges from the ability we have to compare our activity to a socially embedded model of our activity. This enables a very deep, very profound and robust transmission of cultural knowledge and transmission of norms. If anybody has any final kind of quick questions or comments, maybe we can move towards wrapping it up.', 'gist': 'A final discussion on Self-Food', 'headline': 'Self food is the ability to compare our activity to a socially embedded model', 'start': 4588380, 'end': 4708770}, {'summary': 'How can a framework whose imperative is surprise, minimization and bounding be used to generate novelty? People provided a lot of really cool answers. We eventually plan to develop a transcript which will be curated and published, and eventually enabled with speech modeling to generate podcast quality audio.', 'gist': 'The Future of Creativity', 'headline': 'The talk started with surprise and creativity and ended with self talk', 'start': 4712180, 'end': 4960000}, {'summary': "There's a tendency to think of creativity as still like it's almost like the last bastion of internal cognitiveist thinking. But creativity is just as much extended and embedded as everything else. Even the most creative processes are subject to external agent environment system.", 'gist': 'Cognitive Science: Creativity and the Extended Mind', 'headline': 'Could I just add something on the topic of creativity under active inference', 'start': 4961060, 'end': 5144748}, {'summary': 'Michael: What would people like to learn or focus on about collective behavior? creativity is intrinsically very hard to model because by definition, creativity is something that brings about something new. Anyone else want to give a thought on collective behavior or on any other aspect?', 'gist': 'Collective Behavior', 'headline': 'Michael: What would people like to learn about about collective behavior', 'start': 5144914, 'end': 5428580}, {'summary': 'What comes to mind for me at the know, I mentioned units of collective. What might be some of the most well understood limiting beliefs about when we use language of collective that keeps us repeating the same blind spots? How might we think differently about collective so that we escape those predispositions?', 'gist': 'Unpacking the Units of Collective', 'headline': "I'm looking forward to the solo lecture on collective thinking", 'start': 5429800, 'end': 5526690}, {'summary': 'All right, then. Hope everyone is enjoying the course so far. Thanks, Avel, again for coordinating it. And to Ben for this great section. See you all next time.', 'gist': 'Courses 1,2', 'headline': 'All right, then. Hope everyone is enjoying the course so far', 'start': 5532170, 'end': 5554660}], 'sentiment_analysis_results': [{'text': 'You.', 'start': 420, 'end': 970, 'sentiment': 'NEUTRAL', 'confidence': 0.546256959438324, 'speaker': 'A'}, {'text': 'All right.', 'start': 5180, 'end': 5896, 'sentiment': 'NEUTRAL', 'confidence': 0.4896697998046875, 'speaker': 'B'}, {'text': 'July 25, 2023.', 'start': 5998, 'end': 7896, 'sentiment': 'NEUTRAL', 'confidence': 0.7935150861740112, 'speaker': 'C'}, {'text': 'And we are in the discussion section, basics of Active Inference.', 'start': 7918, 'end': 13780, 'sentiment': 'NEUTRAL', 'confidence': 0.8907151222229004, 'speaker': 'C'}, {'text': "This is the first discussion section that we've had for this course, so thank you all for joining.", 'start': 13860, 'end': 20148, 'sentiment': 'POSITIVE', 'confidence': 0.9640112519264221, 'speaker': 'C'}, {'text': "And it's going to be regarding the topics that Ben White introduced in his recent lecture.", 'start': 20324, 'end': 27260, 'sentiment': 'NEUTRAL', 'confidence': 0.8387646675109863, 'speaker': 'C'}, {'text': 'So everyone will be welcome to pop in and introduce themselves.', 'start': 27420, 'end': 33810, 'sentiment': 'POSITIVE', 'confidence': 0.9196909666061401, 'speaker': 'C'}, {'text': 'And then I know that Ben has some ideas to discuss and many other spontaneous and written questions will come into play.', 'start': 34260, 'end': 44468, 'sentiment': 'NEUTRAL', 'confidence': 0.8141082525253296, 'speaker': 'C'}, {'text': 'So with that exit for now and pass to perhaps some of our first time live streaming guests.', 'start': 44634, 'end': 55240, 'sentiment': 'NEUTRAL', 'confidence': 0.878035306930542, 'speaker': 'C'}, {'text': "I guess I've already spoken, so I may as well continue.", 'start': 67850, 'end': 71686, 'sentiment': 'NEUTRAL', 'confidence': 0.8164643049240112, 'speaker': 'D'}, {'text': "So I'm Darius.", 'start': 71788, 'end': 73050, 'sentiment': 'NEUTRAL', 'confidence': 0.7840184569358826, 'speaker': 'D'}, {'text': "I am Master's student.", 'start': 73790, 'end': 75002, 'sentiment': 'NEUTRAL', 'confidence': 0.8548741340637207, 'speaker': 'D'}, {'text': "I'm just about to finish at UCL in sort of social distributed cognition.", 'start': 75056, 'end': 80006, 'sentiment': 'NEUTRAL', 'confidence': 0.906737744808197, 'speaker': 'D'}, {'text': 'I work in a social cognition lab looking at salience regulation and attentional mechanisms within social contexts, but all within an active inference framework, within the Bayesian brain hypothesis framework.', 'start': 80118, 'end': 94202, 'sentiment': 'NEUTRAL', 'confidence': 0.8028303384780884, 'speaker': 'D'}, {'text': "And, yeah, it's a sort of recent discovery and obsession.", 'start': 94346, 'end': 98762, 'sentiment': 'NEUTRAL', 'confidence': 0.7448081374168396, 'speaker': 'D'}, {'text': "And so I'm sort of getting to grips with both the high road and the low road.", 'start': 98826, 'end': 102740, 'sentiment': 'NEUTRAL', 'confidence': 0.8164845705032349, 'speaker': 'D'}, {'text': "And so I've had the opportunity to chat to Mark and some other researchers who have been super informative, but always looking to learn more and get my head around even more of the sort of philosophical and mathematical theory.", 'start': 103350, 'end': 113430, 'sentiment': 'POSITIVE', 'confidence': 0.9093448519706726, 'speaker': 'D'}, {'text': 'Cool.', 'start': 115770, 'end': 116520, 'sentiment': 'POSITIVE', 'confidence': 0.84200119972229, 'speaker': 'A'}, {'text': 'Sounds good.', 'start': 117530, 'end': 118600, 'sentiment': 'POSITIVE', 'confidence': 0.9471787214279175, 'speaker': 'A'}, {'text': 'Hi, everyone.', 'start': 124170, 'end': 124822, 'sentiment': 'NEUTRAL', 'confidence': 0.5403040051460266, 'speaker': 'E'}, {'text': 'Can you hear me?', 'start': 124876, 'end': 125880, 'sentiment': 'NEUTRAL', 'confidence': 0.8097810745239258, 'speaker': 'E'}, {'text': 'Yep.', 'start': 126410, 'end': 127298, 'sentiment': 'NEUTRAL', 'confidence': 0.560655415058136, 'speaker': 'A'}, {'text': "I'm Francisco Balsan.", 'start': 127474, 'end': 129022, 'sentiment': 'NEUTRAL', 'confidence': 0.8386948108673096, 'speaker': 'E'}, {'text': "I'm a PhD student at the University of Bologna, Italy, actually working on intersection between artificial intelligence and education.", 'start': 129106, 'end': 137040, 'sentiment': 'NEUTRAL', 'confidence': 0.6882557272911072, 'speaker': 'E'}, {'text': 'I have a background in cognitive anthropology and philosophy of science, and I met Axel and Maxlin a few years ago.', 'start': 137890, 'end': 146494, 'sentiment': 'NEUTRAL', 'confidence': 0.7766591310501099, 'speaker': 'E'}, {'text': 'So I dive into the rabbit hole of active inference and currently pretty much interested in multiscale active inference models of scientific cognition.', 'start': 146692, 'end': 160222, 'sentiment': 'POSITIVE', 'confidence': 0.6910268664360046, 'speaker': 'E'}, {'text': 'So pretty interested about the agent level modeling of scientific reasoning assumption that might emerge from the interaction with a scientific environment.', 'start': 160286, 'end': 169842, 'sentiment': 'POSITIVE', 'confidence': 0.9046385288238525, 'speaker': 'E'}, {'text': "So we're referring to scientific nature, construction and all these type of top down and bottom up interactions.", 'start': 169906, 'end': 176398, 'sentiment': 'NEUTRAL', 'confidence': 0.8504559397697449, 'speaker': 'E'}, {'text': 'So super interested to hear something from you.', 'start': 176434, 'end': 180202, 'sentiment': 'POSITIVE', 'confidence': 0.9760401248931885, 'speaker': 'E'}, {'text': 'Thank you.', 'start': 180336, 'end': 181260, 'sentiment': 'POSITIVE', 'confidence': 0.8529649972915649, 'speaker': 'A'}, {'text': 'Thank you very much.', 'start': 183630, 'end': 185020, 'sentiment': 'POSITIVE', 'confidence': 0.9599630236625671, 'speaker': 'A'}, {'text': 'Would anybody else like to introduce themselves before we start?', 'start': 188760, 'end': 191990, 'sentiment': 'NEUTRAL', 'confidence': 0.9211029410362244, 'speaker': 'A'}, {'text': 'So you go first.', 'start': 194840, 'end': 196310, 'sentiment': 'NEUTRAL', 'confidence': 0.7793062925338745, 'speaker': 'A'}, {'text': 'Okay.', 'start': 196840, 'end': 197348, 'sentiment': 'NEUTRAL', 'confidence': 0.584351658821106, 'speaker': 'F'}, {'text': "Hi, I'm Regina Sagin.", 'start': 197434, 'end': 199504, 'sentiment': 'NEUTRAL', 'confidence': 0.821316659450531, 'speaker': 'F'}, {'text': 'You can call me Gina.', 'start': 199632, 'end': 200844, 'sentiment': 'NEUTRAL', 'confidence': 0.8521580696105957, 'speaker': 'F'}, {'text': "I'm from Guatemala.", 'start': 200912, 'end': 202340, 'sentiment': 'NEUTRAL', 'confidence': 0.8259249329566956, 'speaker': 'F'}, {'text': "And well, I'm not from the social sciences.", 'start': 202420, 'end': 205348, 'sentiment': 'NEUTRAL', 'confidence': 0.5858137607574463, 'speaker': 'F'}, {'text': 'I come from biology and neuroscience.', 'start': 205444, 'end': 207828, 'sentiment': 'NEUTRAL', 'confidence': 0.8430191874504089, 'speaker': 'F'}, {'text': "And I'm here because I'm working on a project as a technical operator in this big project in the Xscape and material minds.", 'start': 207924, 'end': 218008, 'sentiment': 'NEUTRAL', 'confidence': 0.5613861680030823, 'speaker': 'F'}, {'text': 'And I do the technical part and experiments, but I want to learn the philosophical part.', 'start': 218104, 'end': 224680, 'sentiment': 'NEUTRAL', 'confidence': 0.7691895961761475, 'speaker': 'F'}, {'text': "That's the background that makes the theory of everything.", 'start': 224770, 'end': 228880, 'sentiment': 'NEUTRAL', 'confidence': 0.8359853625297546, 'speaker': 'F'}, {'text': "We're going to experiment.", 'start': 228950, 'end': 231436, 'sentiment': 'NEUTRAL', 'confidence': 0.8079877495765686, 'speaker': 'F'}, {'text': "So I'm here to learn.", 'start': 231548, 'end': 233330, 'sentiment': 'NEUTRAL', 'confidence': 0.7701315879821777, 'speaker': 'F'}, {'text': 'And also, I am like when you see the Olympics, that you see all the swimmers, and I wish there was a normal guy to see how good these people are so you could compare.', 'start': 234340, 'end': 246384, 'sentiment': 'NEUTRAL', 'confidence': 0.46918997168540955, 'speaker': 'F'}, {'text': "So that's me today, right?", 'start': 246432, 'end': 248292, 'sentiment': 'NEUTRAL', 'confidence': 0.8226778507232666, 'speaker': 'F'}, {'text': "I understand half of what's going on, but I'm happy to be here, so yeah.", 'start': 248426, 'end': 253656, 'sentiment': 'POSITIVE', 'confidence': 0.8895686268806458, 'speaker': 'F'}, {'text': 'Hi.', 'start': 253758, 'end': 254410, 'sentiment': 'NEUTRAL', 'confidence': 0.5325649380683899, 'speaker': 'F'}, {'text': 'Sorry.', 'start': 261560, 'end': 261924, 'sentiment': 'NEGATIVE', 'confidence': 0.509212851524353, 'speaker': 'A'}, {'text': "I'm Leigh.", 'start': 261962, 'end': 262736, 'sentiment': 'NEUTRAL', 'confidence': 0.7025122046470642, 'speaker': 'G'}, {'text': 'So my name is Lee.', 'start': 262848, 'end': 264128, 'sentiment': 'NEUTRAL', 'confidence': 0.7676509022712708, 'speaker': 'G'}, {'text': "I'm a PhD student at the University of York studying systems transformation.", 'start': 264224, 'end': 270120, 'sentiment': 'NEUTRAL', 'confidence': 0.9163766503334045, 'speaker': 'G'}, {'text': "And I'm joining because I'm using perceptual control theory at the minute to model examples of effective practice in organizations.", 'start': 271420, 'end': 283748, 'sentiment': 'POSITIVE', 'confidence': 0.5431267023086548, 'speaker': 'G'}, {'text': "And I've read quite a lot of active inference papers, and I understand that there's a lot of resonance overlap between perceptual control theory and active inference, although I understand it's within a predictive framework.", 'start': 283844, 'end': 299404, 'sentiment': 'NEUTRAL', 'confidence': 0.6935843229293823, 'speaker': 'G'}, {'text': "And also it's kind of a level of abstraction higher, so you're able to kind of quantify the difference between sort of the predictive state or the outcome state and the current state.", 'start': 299532, 'end': 311684, 'sentiment': 'NEUTRAL', 'confidence': 0.8600203990936279, 'speaker': 'G'}, {'text': "So what I'm really trying to understand is how might that level of abstraction be useful in what I'm doing, actually, because I understand it's a much more kind of concurrent theory and framework than perceptual control theory.", 'start': 311802, 'end': 327080, 'sentiment': 'NEUTRAL', 'confidence': 0.726503849029541, 'speaker': 'G'}, {'text': 'Yeah, very cool.', 'start': 330950, 'end': 332260, 'sentiment': 'POSITIVE', 'confidence': 0.9540662169456482, 'speaker': 'A'}, {'text': 'Anybody else?', 'start': 333350, 'end': 334500, 'sentiment': 'NEUTRAL', 'confidence': 0.7172255516052246, 'speaker': 'A'}, {'text': 'Is that everybody?', 'start': 337830, 'end': 338980, 'sentiment': 'NEUTRAL', 'confidence': 0.7712940573692322, 'speaker': 'A'}, {'text': 'Okay, well, has everybody seen the lecture that I gave a couple of weeks ago?', 'start': 341670, 'end': 349240, 'sentiment': 'NEUTRAL', 'confidence': 0.847224235534668, 'speaker': 'A'}, {'text': "Okay, so I think it might be helpful then, if I kind of very briefly go over what we covered in that lecture just to kind of jog people's memories, and then we can maybe pick up some questions from there.", 'start': 350170, 'end': 362540, 'sentiment': 'POSITIVE', 'confidence': 0.5562635660171509, 'speaker': 'A'}, {'text': 'So the lecture last week was on the basics of active inference, and it was intended to be an introduction to the framework on a very abstract, philosophical level.', 'start': 363070, 'end': 373374, 'sentiment': 'NEUTRAL', 'confidence': 0.682892382144928, 'speaker': 'A'}, {'text': 'So it left out all of the kind of mathematics and technical aspects of the framework.', 'start': 373412, 'end': 377818, 'sentiment': 'NEUTRAL', 'confidence': 0.6492314338684082, 'speaker': 'A'}, {'text': 'And the objective really was to lay the groundwork for future weeks in this course, because this is obviously a course on active inference in the social sciences.', 'start': 377994, 'end': 389454, 'sentiment': 'NEUTRAL', 'confidence': 0.8273401856422424, 'speaker': 'A'}, {'text': "And so in the subsequent weeks, we're going to be looking at topics like collective behavior, social cognition, shared norms, and niche construction.", 'start': 389582, 'end': 398914, 'sentiment': 'NEUTRAL', 'confidence': 0.8423524498939514, 'speaker': 'A'}, {'text': 'And so what I wanted to do was to put on the table a kind of fully fleshed out picture of what the individual agent looks like in active inference.', 'start': 399042, 'end': 410534, 'sentiment': 'NEUTRAL', 'confidence': 0.8835188150405884, 'speaker': 'A'}, {'text': 'And so to do this, we looked at emotion, agency, mind, so we looked at kind of the role of action and perception, the role of internal representations in active inference.', 'start': 410662, 'end': 427066, 'sentiment': 'NEUTRAL', 'confidence': 0.8705742359161377, 'speaker': 'A'}, {'text': "And then as a case study, we looked at an active inference based account of addiction to kind of bring all of these threads together, to kind of articulate a lot of the things that I'd said in the previous sections.", 'start': 427178, 'end': 441490, 'sentiment': 'NEUTRAL', 'confidence': 0.8993029594421387, 'speaker': 'A'}, {'text': "The questions here don't have to be specifically tethered to that lecture.", 'start': 446250, 'end': 450786, 'sentiment': 'NEUTRAL', 'confidence': 0.7491850256919861, 'speaker': 'A'}, {'text': 'I suppose we can just start with any general questions about active inference and philosophy and how active inference applies to individual agents, or if anybody did want to pick up on any threads from the lecture, then we can go from there.', 'start': 450898, 'end': 461980, 'sentiment': 'NEUTRAL', 'confidence': 0.8640114665031433, 'speaker': 'A'}, {'text': 'Can I ask something just for the basic questions?', 'start': 466210, 'end': 469858, 'sentiment': 'NEUTRAL', 'confidence': 0.8640369176864624, 'speaker': 'F'}, {'text': 'Yeah, of course.', 'start': 470024, 'end': 471140, 'sentiment': 'NEUTRAL', 'confidence': 0.5765852928161621, 'speaker': 'A'}, {'text': "I don't understand because I think you explain it later, but how does creativity and science in general enters active imperents?", 'start': 471830, 'end': 482770, 'sentiment': 'NEUTRAL', 'confidence': 0.5423322319984436, 'speaker': 'F'}, {'text': 'How does trying to be creative and not doing what you predict enters this room?', 'start': 483130, 'end': 490360, 'sentiment': 'NEGATIVE', 'confidence': 0.48804202675819397, 'speaker': 'F'}, {'text': 'Yeah, this is a really good question.', 'start': 490810, 'end': 493640, 'sentiment': 'POSITIVE', 'confidence': 0.9551777839660645, 'speaker': 'A'}, {'text': 'Did you see the lecture?', 'start': 495710, 'end': 497210, 'sentiment': 'NEUTRAL', 'confidence': 0.8426229357719421, 'speaker': 'A'}, {'text': 'Yeah, but I remember half of it.', 'start': 498670, 'end': 501100, 'sentiment': 'NEUTRAL', 'confidence': 0.7503365278244019, 'speaker': 'F'}, {'text': "That's fine, but do you remember the dark room problem?", 'start': 501630, 'end': 506620, 'sentiment': 'NEUTRAL', 'confidence': 0.7930019497871399, 'speaker': 'A'}, {'text': "Yeah, I know that's where the answer is.", 'start': 507090, 'end': 510000, 'sentiment': 'NEUTRAL', 'confidence': 0.6872494220733643, 'speaker': 'F'}, {'text': 'I think there are several interesting dark room problem, some of them more interesting than others.', 'start': 513090, 'end': 521410, 'sentiment': 'POSITIVE', 'confidence': 0.9468338489532471, 'speaker': 'A'}, {'text': "And I tried to cover I obviously didn't have time to cover all of those in the lecture.", 'start': 521480, 'end': 525890, 'sentiment': 'NEUTRAL', 'confidence': 0.4757654070854187, 'speaker': 'A'}, {'text': "But for those that perhaps aren't familiar, the dark room problem is this kind of canonical philosophical worry about predictive processing and active inference that says essentially, if all we're trying to do is minimize prediction errors, why don't we just find maximally predictable environments?", 'start': 527750, 'end': 548810, 'sentiment': 'NEUTRAL', 'confidence': 0.6201332211494446, 'speaker': 'A'}, {'text': 'And why do we not just lay in a dark room hooked up to an intravenous drip and enjoy kind of error free lifestyle?', 'start': 549150, 'end': 556250, 'sentiment': 'NEUTRAL', 'confidence': 0.5760122537612915, 'speaker': 'A'}, {'text': "So I think that's the question that you're articulating there.", 'start': 556910, 'end': 560894, 'sentiment': 'NEUTRAL', 'confidence': 0.8464134931564331, 'speaker': 'A'}, {'text': 'I just quickly see a hand from Darius.', 'start': 561092, 'end': 563306, 'sentiment': 'NEUTRAL', 'confidence': 0.862256646156311, 'speaker': 'A'}, {'text': 'Darius, did you want to jump in, or was it a separate question?', 'start': 563338, 'end': 565760, 'sentiment': 'NEUTRAL', 'confidence': 0.9020272493362427, 'speaker': 'A'}, {'text': "It's a separate question.", 'start': 567490, 'end': 568814, 'sentiment': 'NEUTRAL', 'confidence': 0.8072672486305237, 'speaker': 'D'}, {'text': 'So I thought I would just do it in advance.', 'start': 568932, 'end': 570794, 'sentiment': 'NEUTRAL', 'confidence': 0.7614536881446838, 'speaker': 'D'}, {'text': 'But yeah, no, ignore me.', 'start': 570842, 'end': 571806, 'sentiment': 'NEGATIVE', 'confidence': 0.5029982924461365, 'speaker': 'D'}, {'text': "I'll circle a call background in a second then.", 'start': 571828, 'end': 573218, 'sentiment': 'NEUTRAL', 'confidence': 0.8499592542648315, 'speaker': 'A'}, {'text': 'But feel free, I should say.', 'start': 573224, 'end': 575506, 'sentiment': 'NEUTRAL', 'confidence': 0.5379385948181152, 'speaker': 'A'}, {'text': "Actually, this is the first time I've kind of chaired a discussion like this, so I'll be explicit and say people should just feel free to jump in whenever they want.", 'start': 575528, 'end': 584514, 'sentiment': 'NEUTRAL', 'confidence': 0.5908802151679993, 'speaker': 'A'}, {'text': "If you want to take the disco, if you want to kind of add something or kind of build on a question that we're answering, feel free to jump in.", 'start': 584552, 'end': 591880, 'sentiment': 'NEUTRAL', 'confidence': 0.7298332452774048, 'speaker': 'A'}, {'text': "But, yeah, with the dark room problem, as I'm aware, the first answer to that question and this is something that I did cover in the lecture, is essentially a big part of active inference is to recognize that agents are it's a kind of fundamentally embodied framework, okay?", 'start': 592970, 'end': 610510, 'sentiment': 'NEUTRAL', 'confidence': 0.8253755569458008, 'speaker': 'A'}, {'text': 'So that can be kind of cashed out in various ways.', 'start': 610580, 'end': 614462, 'sentiment': 'NEUTRAL', 'confidence': 0.8599046468734741, 'speaker': 'A'}, {'text': 'But one of the most important ways is that the expected states of the organism or that the agent are necessarily rooted in the phenotype of the organism and the kind of evolutionary biological needs that come with having a particular body.', 'start': 614516, 'end': 630210, 'sentiment': 'NEUTRAL', 'confidence': 0.7417095899581909, 'speaker': 'A'}, {'text': "So there was a paper that I referenced in a lecture by there's three authors on this paper.", 'start': 630360, 'end': 636774, 'sentiment': 'NEUTRAL', 'confidence': 0.8586033582687378, 'speaker': 'A'}, {'text': "It's andy Clark, Karl Friston, and then I'm forgetting the name of the third author.", 'start': 636892, 'end': 641794, 'sentiment': 'NEUTRAL', 'confidence': 0.6858000755310059, 'speaker': 'A'}, {'text': 'If anybody can recall, feel free to drop it in the chat.', 'start': 641842, 'end': 645494, 'sentiment': 'NEUTRAL', 'confidence': 0.8726421594619751, 'speaker': 'A'}, {'text': 'But this is an answer to the dark room, where it builds on that notion of embodiment and says, look, creatures like us, human agents, could sit in the dark room and do nothing and just kind of enjoy the very predictable march of hunger, thirst, et cetera.', 'start': 645622, 'end': 665146, 'sentiment': 'NEUTRAL', 'confidence': 0.5363256931304932, 'speaker': 'A'}, {'text': 'But obviously, those particular biologists out of the room.', 'start': 665178, 'end': 668110, 'sentiment': 'NEUTRAL', 'confidence': 0.6088433265686035, 'speaker': 'A'}, {'text': 'And so you have this very fundamental level.', 'start': 668260, 'end': 671060, 'sentiment': 'NEUTRAL', 'confidence': 0.7886621356010437, 'speaker': 'A'}, {'text': 'We have this very fundamental kind of basis upon which we have these needs that need to be met.', 'start': 673830, 'end': 679314, 'sentiment': 'NEUTRAL', 'confidence': 0.8466964960098267, 'speaker': 'A'}, {'text': "And so we need to engage in exploratory behaviors on the topic of novelty, because that's a kind of base.", 'start': 679352, 'end': 686614, 'sentiment': 'NEUTRAL', 'confidence': 0.6762626767158508, 'speaker': 'A'}, {'text': 'I take that to be a kind of baseline answer.', 'start': 686652, 'end': 689160, 'sentiment': 'NEUTRAL', 'confidence': 0.8773618340492249, 'speaker': 'A'}, {'text': 'But there are clearly kinds of activities and behaviors that we do engage in going beyond the dark room kind of curiosity play, creativity, engaging in kind of why do we create works of art?', 'start': 689770, 'end': 706230, 'sentiment': 'NEUTRAL', 'confidence': 0.719567060470581, 'speaker': 'A'}, {'text': "And there's not an obvious link between those kinds of behaviors and the kinds of biological needs that are emphasized in the original answer to the dark room worry.", 'start': 706400, 'end': 716990, 'sentiment': 'NEGATIVE', 'confidence': 0.494266152381897, 'speaker': 'A'}, {'text': "So in answer to Regina's question about creativity, I think that a good starting point for this is the section on aerodynamics that I introduced in the lecture.", 'start': 717970, 'end': 730174, 'sentiment': 'POSITIVE', 'confidence': 0.8669648766517639, 'speaker': 'A'}, {'text': "So this was the idea that there's this strong connection between affectivity as a kind of emotional, embodied feeling state and the changes to the rate in prediction error minimization.", 'start': 730222, 'end': 744690, 'sentiment': 'NEUTRAL', 'confidence': 0.8295315504074097, 'speaker': 'A'}, {'text': "So I don't know.", 'start': 744850, 'end': 746070, 'sentiment': 'NEUTRAL', 'confidence': 0.6297039985656738, 'speaker': 'A'}, {'text': "I am now very much articulating Mark's work here.", 'start': 746220, 'end': 749994, 'sentiment': 'NEUTRAL', 'confidence': 0.6278085708618164, 'speaker': 'A'}, {'text': "So I don't know if Mark wants to jump in at any point and do a much better job than I can.", 'start': 750032, 'end': 754940, 'sentiment': 'NEGATIVE', 'confidence': 0.5147870779037476, 'speaker': 'A'}, {'text': "I think there's certainly work on the horizon.", 'start': 758530, 'end': 762170, 'sentiment': 'POSITIVE', 'confidence': 0.6953840255737305, 'speaker': 'A'}, {'text': 'I know that there are people who are currently building up theories of artisticity that are based on this idea of aerodynamics.', 'start': 762330, 'end': 772770, 'sentiment': 'NEUTRAL', 'confidence': 0.8336614966392517, 'speaker': 'A'}, {'text': "So Mark's paper on play with Mark Anderson that I mentioned has a really interesting idea where if you explore playful behaviors which are kind of fundamentally creative and it's an inherently creative exercise, I think the really interesting idea that comes out of that is one thing that we engage in because it feels good is we create niches of very manageable prediction error that we can then minimize.", 'start': 773110, 'end': 805290, 'sentiment': 'POSITIVE', 'confidence': 0.9724881649017334, 'speaker': 'A'}, {'text': "So, yeah, that's playful behavior is the answer to the puzzle of play.", 'start': 807410, 'end': 812382, 'sentiment': 'POSITIVE', 'confidence': 0.5888967514038086, 'speaker': 'A'}, {'text': "So the puzzle of play is why do we engage in metabolically quite costly and they don't have any obvious benefit.", 'start': 812436, 'end': 823374, 'sentiment': 'NEGATIVE', 'confidence': 0.6048761010169983, 'speaker': 'A'}, {'text': "And the idea there is that, well, there's kind of several ideas in there, but one of them is that it just literally feels good because minimizing prediction error feels good to us.", 'start': 823502, 'end': 833566, 'sentiment': 'POSITIVE', 'confidence': 0.8960092663764954, 'speaker': 'A'}, {'text': 'So whenever we do better than expect at minimizing prediction error, it feels good.', 'start': 833608, 'end': 837480, 'sentiment': 'POSITIVE', 'confidence': 0.9149097204208374, 'speaker': 'A'}, {'text': "Obviously, I don't know for sure, but I think that any answer that we give regarding artistic creativity is going to fall within that kind of bulb that essentially we engage in.", 'start': 840010, 'end': 851980, 'sentiment': 'NEUTRAL', 'confidence': 0.8317066431045532, 'speaker': 'A'}, {'text': 'The part of the creative process is just constructing those that give us tasks of manageable prediction error that ideally fit at the boundaries of our skilled capabilities.', 'start': 852350, 'end': 869306, 'sentiment': 'NEUTRAL', 'confidence': 0.7391327023506165, 'speaker': 'A'}, {'text': 'Can I add two quick things there, Ben?', 'start': 869338, 'end': 871170, 'sentiment': 'NEUTRAL', 'confidence': 0.8896574974060059, 'speaker': 'B'}, {'text': 'So that was a great explanation, but just to hit two points a little bit harder, one, you might think all that matters error.', 'start': 871510, 'end': 881250, 'sentiment': 'NEUTRAL', 'confidence': 0.5173985362052917, 'speaker': 'B'}, {'text': "That's why it looked a little bit paradoxical that we also create antithetical to our modus operandi, which is to reduce error.", 'start': 882250, 'end': 891938, 'sentiment': 'NEGATIVE', 'confidence': 0.6516022682189941, 'speaker': 'B'}, {'text': 'But when you remember that for our kind prediction error minimizing system, we have a really deep temporal model.', 'start': 892034, 'end': 898330, 'sentiment': 'NEUTRAL', 'confidence': 0.6943957805633545, 'speaker': 'B'}, {'text': "We're managing uncertainty at a big horizon, maybe even multigenerational, where we're thinking about our kids or our kids.", 'start': 898480, 'end': 906310, 'sentiment': 'NEUTRAL', 'confidence': 0.7511594891548157, 'speaker': 'B'}, {'text': 'I mean, who knows how deep the Generative model actually runs?', 'start': 906400, 'end': 909354, 'sentiment': 'NEUTRAL', 'confidence': 0.6908501982688904, 'speaker': 'B'}, {'text': 'It turns out that error over that stops developing error minimizing skills and abilities and just hangs out in one microniche, because that microniche is going to be upset sooner, right?', 'start': 909482, 'end': 929490, 'sentiment': 'NEGATIVE', 'confidence': 0.6908882260322571, 'speaker': 'B'}, {'text': "I mean, it's such a great example of where we thought we were in a really set vector state and then suddenly it gets jostled and all of us go, oh my goodness, what do we do?", 'start': 929560, 'end': 939014, 'sentiment': 'NEUTRAL', 'confidence': 0.444419801235199, 'speaker': 'B'}, {'text': "We've been bumped.", 'start': 939052, 'end': 940230, 'sentiment': 'NEUTRAL', 'confidence': 0.592689573764801, 'speaker': 'B'}, {'text': 'And it turns out that the best error minimize will be the two kinds of errors that are hates.', 'start': 940810, 'end': 951174, 'sentiment': 'NEGATIVE', 'confidence': 0.4616859257221222, 'speaker': 'B'}, {'text': 'Those errors are digestible.', 'start': 951222, 'end': 953782, 'sentiment': 'NEUTRAL', 'confidence': 0.6434359550476074, 'speaker': 'B'}, {'text': "So that means not too complex that you can't do anything with it, you can't learn anything from it, but also not so boring that there's nothing to learn.", 'start': 953926, 'end': 959614, 'sentiment': 'NEGATIVE', 'confidence': 0.4262303113937378, 'speaker': 'B'}, {'text': "If we hang out, if we're sensitive to and we hang out at the edge of our capability, then we keep developing new error minimizing abilities, which actually sets us up to be good error minimizing systems over the long run.", 'start': 959732, 'end': 971714, 'sentiment': 'POSITIVE', 'confidence': 0.7517982721328735, 'speaker': 'B'}, {'text': "So even though we're investing metabolism now, we're setting ourselves up to be able to manage, especially in the deep end of the pool, black swans manage uncertainty that we're not going to be able to predict.", 'start': 971752, 'end': 982978, 'sentiment': 'NEUTRAL', 'confidence': 0.6274870038032532, 'speaker': 'B'}, {'text': "They're really unpredictable.", 'start': 983074, 'end': 984242, 'sentiment': 'NEGATIVE', 'confidence': 0.6944743990898132, 'speaker': 'B'}, {'text': 'Unpredictable that comes from hanging out at this edge.', 'start': 984306, 'end': 988050, 'sentiment': 'NEGATIVE', 'confidence': 0.6617169380187988, 'speaker': 'B'}, {'text': 'So part of our curiosity and playfulness and creativity are going to be about us making and digesting novel slopes of Volatility.', 'start': 988130, 'end': 997906, 'sentiment': 'POSITIVE', 'confidence': 0.5835339426994324, 'speaker': 'B'}, {'text': "I think that's one really great answer for why you get playfulness and curiosity out of this and creativity.", 'start': 998018, 'end': 1004038, 'sentiment': 'POSITIVE', 'confidence': 0.9251992106437683, 'speaker': 'B'}, {'text': "I'll just drop one more and we don't have to get into it too deeply here.", 'start': 1004134, 'end': 1007194, 'sentiment': 'NEUTRAL', 'confidence': 0.823130190372467, 'speaker': 'B'}, {'text': "But here's one other one that we're thinking of.", 'start': 1007232, 'end': 1009580, 'sentiment': 'NEUTRAL', 'confidence': 0.8409956693649292, 'speaker': 'B'}, {'text': "There's something really special in the creation of art, especially in a public sphere, that I think is so interesting and that somebody needs to be sort of looking at this.", 'start': 1010030, 'end': 1018640, 'sentiment': 'POSITIVE', 'confidence': 0.9692948460578918, 'speaker': 'B'}, {'text': "There's actually a new collection coming out in Philosophical Trans B on Art and Predictive Processing, which I think you should check out if you're interested in these topics.", 'start': 1019330, 'end': 1029730, 'sentiment': 'POSITIVE', 'confidence': 0.7961505055427551, 'speaker': 'B'}, {'text': "But the idea that we've been thinking about is there are ways that we can bring our Generative model out and put it into a public sphere.", 'start': 1030310, 'end': 1037922, 'sentiment': 'NEUTRAL', 'confidence': 0.5482221245765686, 'speaker': 'B'}, {'text': 'You can take something which is typically on the inside and you can put it outside, and then you can have other error minimizing systems look at it and fiddle around with it and then we can reimbibe it.', 'start': 1038066, 'end': 1049580, 'sentiment': 'NEUTRAL', 'confidence': 0.6262415051460266, 'speaker': 'B'}, {'text': "We're doing this all the time.", 'start': 1050110, 'end': 1051674, 'sentiment': 'NEUTRAL', 'confidence': 0.8007394075393677, 'speaker': 'B'}, {'text': "That's what language allows us to do and what writing allows us to do.", 'start': 1051792, 'end': 1054554, 'sentiment': 'NEUTRAL', 'confidence': 0.6221433877944946, 'speaker': 'B'}, {'text': 'Think about maths.', 'start': 1054592, 'end': 1055542, 'sentiment': 'NEUTRAL', 'confidence': 0.7764422297477722, 'speaker': 'B'}, {'text': "You're bringing up part of your predictive understanding, you're laying it out and then other predictive agents can fiddle around with it and then you can take it back in as part of your updating your own model.", 'start': 1055606, 'end': 1065150, 'sentiment': 'NEUTRAL', 'confidence': 0.8023385405540466, 'speaker': 'B'}, {'text': "And I don't know how much more I can say here.", 'start': 1065300, 'end': 1067902, 'sentiment': 'NEGATIVE', 'confidence': 0.5346524715423584, 'speaker': 'B'}, {'text': 'I just think this is a kind of horizon.', 'start': 1068036, 'end': 1069834, 'sentiment': 'NEUTRAL', 'confidence': 0.6102436184883118, 'speaker': 'B'}, {'text': "But I think there's a really juicy thing to say here.", 'start': 1069882, 'end': 1071906, 'sentiment': 'POSITIVE', 'confidence': 0.6764832139015198, 'speaker': 'B'}, {'text': 'About where real art is.', 'start': 1072008, 'end': 1074434, 'sentiment': 'NEUTRAL', 'confidence': 0.8087528944015503, 'speaker': 'B'}, {'text': 'Like Tolstoy.', 'start': 1074472, 'end': 1075214, 'sentiment': 'NEUTRAL', 'confidence': 0.7519111633300781, 'speaker': 'B'}, {'text': "Maybe Leo Tolstoy was already on this, where you put something of the Creator in the Creation and then other people receive that and then they can do something else with it, and then you're able to sort of take it back in all under the guise of sort of Minimizing Volatility or understanding Volatility, maybe.", 'start': 1075262, 'end': 1095574, 'sentiment': 'NEUTRAL', 'confidence': 0.8341416716575623, 'speaker': 'B'}, {'text': 'That was a bit deep.', 'start': 1095612, 'end': 1096790, 'sentiment': 'NEUTRAL', 'confidence': 0.6615753173828125, 'speaker': 'B'}, {'text': 'No, that was really good.', 'start': 1097130, 'end': 1099046, 'sentiment': 'POSITIVE', 'confidence': 0.9282854199409485, 'speaker': 'A'}, {'text': 'Yeah.', 'start': 1099148, 'end': 1099800, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'A'}, {'text': 'So in the chat I just dropped a link to yeah, so somebody just asked about papers related to hanging out at Edge of Our Capabilities.', 'start': 1101390, 'end': 1110554, 'sentiment': 'NEUTRAL', 'confidence': 0.8866896629333496, 'speaker': 'A'}, {'text': "I'll do that right now.", 'start': 1110682, 'end': 1111920, 'sentiment': 'NEUTRAL', 'confidence': 0.7579621076583862, 'speaker': 'B'}, {'text': 'There sure are some papers on that.', 'start': 1112370, 'end': 1114446, 'sentiment': 'NEUTRAL', 'confidence': 0.8338371515274048, 'speaker': 'A'}, {'text': "Mark's got a few.", 'start': 1114548, 'end': 1115598, 'sentiment': 'NEUTRAL', 'confidence': 0.6896330714225769, 'speaker': 'A'}, {'text': "I already dropped a link in there to an Aon article by some of the old Expect project crew, including Mark Kate Nave, George Dean and Andy Clark on the value of uncertainty, which is I think it's a really good start point for some of these questions.", 'start': 1115684, 'end': 1131380, 'sentiment': 'POSITIVE', 'confidence': 0.8998052477836609, 'speaker': 'A'}, {'text': "Just because Aeon is a kind of non academic place where, you know, it's a non technical introduction.", 'start': 1132390, 'end': 1140642, 'sentiment': 'NEUTRAL', 'confidence': 0.7564897537231445, 'speaker': 'A'}, {'text': "And there's a wonderful example in that paper of a guy named I think it's Max Hawkings.", 'start': 1140706, 'end': 1145922, 'sentiment': 'POSITIVE', 'confidence': 0.93314129114151, 'speaker': 'A'}, {'text': 'Is that right?', 'start': 1145986, 'end': 1146474, 'sentiment': 'NEUTRAL', 'confidence': 0.7965733408927917, 'speaker': 'A'}, {'text': 'Mark?', 'start': 1146512, 'end': 1146810, 'sentiment': 'NEUTRAL', 'confidence': 0.7144628167152405, 'speaker': 'A'}, {'text': 'Max who?', 'start': 1146880, 'end': 1148314, 'sentiment': 'NEUTRAL', 'confidence': 0.7910289168357849, 'speaker': 'A'}, {'text': "He's a kind of tech guy and he realized he was getting kind of bored with his life.", 'start': 1148512, 'end': 1153338, 'sentiment': 'NEGATIVE', 'confidence': 0.49688684940338135, 'speaker': 'A'}, {'text': "He'd inadvertently trapped himself in a dark room because his life had become so rote and scheduled and systematic.", 'start': 1153504, 'end': 1161850, 'sentiment': 'NEGATIVE', 'confidence': 0.7782512903213501, 'speaker': 'A'}, {'text': 'He realized that he would be kind of incredibly easy to kidnap because he was in the same place at the same time every single day and he took drastic action to break out of that dark room.', 'start': 1161930, 'end': 1172722, 'sentiment': 'NEUTRAL', 'confidence': 0.5395401120185852, 'speaker': 'A'}, {'text': 'So he kind of introduced a randomization algorithm that it would kind of choose for him where he was going to eat, where he was going to go, which shows he was going to attend.', 'start': 1172776, 'end': 1184498, 'sentiment': 'NEUTRAL', 'confidence': 0.9182873368263245, 'speaker': 'A'}, {'text': 'And this example is a really nice centerpiece in this article.', 'start': 1184674, 'end': 1188310, 'sentiment': 'POSITIVE', 'confidence': 0.968235433101654, 'speaker': 'A'}, {'text': "I think this is a nice place to start because it's also grounded in discussions about epistemic actions as well, because there's also as cool as play and art and creativity are there's also really good reasons that uncertainty is valuable as well?", 'start': 1189370, 'end': 1204202, 'sentiment': 'POSITIVE', 'confidence': 0.9652709364891052, 'speaker': 'A'}, {'text': 'Right?', 'start': 1204256, 'end': 1204522, 'sentiment': 'NEUTRAL', 'confidence': 0.7360090017318726, 'speaker': 'A'}, {'text': 'Because while we might want to exploit all of the opportunities for kind of nourishment and valuable prediction error minimization in our environment, there are of course going to be times where those opportunities are exhausted and we need to go and explore different ones.', 'start': 1204576, 'end': 1223282, 'sentiment': 'NEUTRAL', 'confidence': 0.6227468252182007, 'speaker': 'A'}, {'text': "And I think there's some stuff in there as well on epistemic actions within the context of navigation as well.", 'start': 1223416, 'end': 1230482, 'sentiment': 'NEUTRAL', 'confidence': 0.9139562845230103, 'speaker': 'A'}, {'text': "So sometimes we're going to have to temporarily move further away from our target in order to minimize our uncertainty about where we're going.", 'start': 1230536, 'end': 1239014, 'sentiment': 'NEUTRAL', 'confidence': 0.6455457806587219, 'speaker': 'A'}, {'text': "So there's lots and lots of stuff on the value of uncertainty and it kind of is very much at the forefront of some of the really interesting philosophical applications of the framework.", 'start': 1239132, 'end': 1250230, 'sentiment': 'POSITIVE', 'confidence': 0.8957132697105408, 'speaker': 'A'}, {'text': 'For sure.', 'start': 1250310, 'end': 1251100, 'sentiment': 'NEUTRAL', 'confidence': 0.5574129819869995, 'speaker': 'A'}, {'text': 'Okay, by all means.', 'start': 1252110, 'end': 1254522, 'sentiment': 'NEUTRAL', 'confidence': 0.6667354106903076, 'speaker': 'A'}, {'text': "Yeah, we've got time.", 'start': 1254576, 'end': 1255660, 'sentiment': 'NEUTRAL', 'confidence': 0.5203197002410889, 'speaker': 'A'}, {'text': 'I know you have a question that is but with the value of uncertainty.', 'start': 1256350, 'end': 1260442, 'sentiment': 'NEUTRAL', 'confidence': 0.7790988087654114, 'speaker': 'F'}, {'text': "It's just that I'm thinking because I've been working a lot with the magicians and there's a way of using uncertainty as entertainment that it's very difficult to understand as a concept for entertainment.", 'start': 1260506, 'end': 1275406, 'sentiment': 'NEGATIVE', 'confidence': 0.5348576903343201, 'speaker': 'F'}, {'text': 'Why would you like to be in a place where you want to predict but you cannot, and you still want to participate in this activity?', 'start': 1275438, 'end': 1283458, 'sentiment': 'NEGATIVE', 'confidence': 0.4966859817504883, 'speaker': 'F'}, {'text': "So for me, magic shows, it's kind of breaking a little.", 'start': 1283554, 'end': 1287320, 'sentiment': 'NEUTRAL', 'confidence': 0.5113704800605774, 'speaker': 'F'}, {'text': "Spoke to I forget the person's name, but there was an Xcape meeting here at Sussex and I spoke to one of the guys on Escape who had been working on magic.", 'start': 1290730, 'end': 1300998, 'sentiment': 'NEUTRAL', 'confidence': 0.8822294473648071, 'speaker': 'A'}, {'text': "I don't know if you know who I'm talking about, but I think they have a book on magic.", 'start': 1301174, 'end': 1305210, 'sentiment': 'NEUTRAL', 'confidence': 0.836908221244812, 'speaker': 'A'}, {'text': "And I think that's really cool to think about from a predictive processing perspective, the idea that magic is just these wonderful kind of violations of expectations.", 'start': 1305710, 'end': 1314410, 'sentiment': 'POSITIVE', 'confidence': 0.9757048487663269, 'speaker': 'A'}, {'text': 'In a certain sense, I think predictive processing provides a nice, really intuitive framework for thinking about those kinds of things.', 'start': 1314570, 'end': 1321300, 'sentiment': 'POSITIVE', 'confidence': 0.8770984411239624, 'speaker': 'A'}, {'text': 'One little point there, Regina.', 'start': 1321670, 'end': 1323502, 'sentiment': 'NEUTRAL', 'confidence': 0.813517689704895, 'speaker': 'B'}, {'text': 'Just about again, if it feels paradoxical just to sort of complexify your view, remember that this is always happening in a hierarchical system.', 'start': 1323566, 'end': 1333998, 'sentiment': 'NEUTRAL', 'confidence': 0.626110851764679, 'speaker': 'B'}, {'text': "So just because you have errors at one level of the system doesn't mean you're going to have sort of critical, cascading, unbearable errors at higher levels.", 'start': 1334184, 'end': 1342802, 'sentiment': 'NEGATIVE', 'confidence': 0.754831850528717, 'speaker': 'B'}, {'text': "So that's why it's fun to go to horror movies.", 'start': 1342946, 'end': 1345826, 'sentiment': 'POSITIVE', 'confidence': 0.8517723083496094, 'speaker': 'B'}, {'text': 'So I dropped the paper here.', 'start': 1345938, 'end': 1347334, 'sentiment': 'NEUTRAL', 'confidence': 0.6084022521972656, 'speaker': 'B'}, {'text': 'Also, we have a new paper coming out on horror movies.', 'start': 1347372, 'end': 1349606, 'sentiment': 'NEUTRAL', 'confidence': 0.8150122165679932, 'speaker': 'B'}, {'text': "I'm pretty interested in this, but it's the same as going to the magic show in some way.", 'start': 1349638, 'end': 1354714, 'sentiment': 'POSITIVE', 'confidence': 0.9066901206970215, 'speaker': 'B'}, {'text': "Now, the reason why those errors are fun is because we're safe in a theater.", 'start': 1354832, 'end': 1361150, 'sentiment': 'POSITIVE', 'confidence': 0.6103087067604065, 'speaker': 'B'}, {'text': "We're with our friends.", 'start': 1361570, 'end': 1363054, 'sentiment': 'POSITIVE', 'confidence': 0.6228154301643372, 'speaker': 'B'}, {'text': 'We have lots of sugar in our system from eating popcorn and candy.', 'start': 1363252, 'end': 1366910, 'sentiment': 'NEGATIVE', 'confidence': 0.8148411512374878, 'speaker': 'B'}, {'text': 'We can control the amount of scary by covering our eyes.', 'start': 1367490, 'end': 1373220, 'sentiment': 'NEUTRAL', 'confidence': 0.7028262615203857, 'speaker': 'B'}, {'text': "There's lots of control here.", 'start': 1374870, 'end': 1376738, 'sentiment': 'NEUTRAL', 'confidence': 0.7412645816802979, 'speaker': 'B'}, {'text': "And yet we're getting media that's pinging all of our evolutionarily ancient error tracking systems so that we're getting jumps in the physiology as if there's a bunch of volatility that we need to manage, and yet we're in a completely safe space, which is really fun for our kind of system because we're hierarchically deep predictive systems.", 'start': 1376824, 'end': 1395490, 'sentiment': 'POSITIVE', 'confidence': 0.7668731808662415, 'speaker': 'B'}, {'text': "The high level here isn't jeopardized.", 'start': 1395570, 'end': 1397798, 'sentiment': 'NEUTRAL', 'confidence': 0.6065211892127991, 'speaker': 'B'}, {'text': "It knows I'm in a theater, but the low level stuff is still registering all sorts of literal volatilities.", 'start': 1397974, 'end': 1404054, 'sentiment': 'NEGATIVE', 'confidence': 0.4910990297794342, 'speaker': 'B'}, {'text': 'But of course, they get squashed.', 'start': 1404102, 'end': 1405574, 'sentiment': 'NEGATIVE', 'confidence': 0.6241371631622314, 'speaker': 'B'}, {'text': "They don't cascade all the way up.", 'start': 1405702, 'end': 1407740, 'sentiment': 'NEUTRAL', 'confidence': 0.6601732969284058, 'speaker': 'B'}, {'text': "Or if you're the kind of person where they do tend to cascade all the way up, then you're also the kind of person who doesn't like going to horror movies because it kind of scares you.", 'start': 1408990, 'end': 1418286, 'sentiment': 'NEGATIVE', 'confidence': 0.8453240394592285, 'speaker': 'B'}, {'text': 'Go home and think, oh, goodness, maybe ghosts are real and maybe I live with them.', 'start': 1418388, 'end': 1422626, 'sentiment': 'NEUTRAL', 'confidence': 0.5940628051757812, 'speaker': 'B'}, {'text': "You wouldn't be going there then.", 'start': 1422648, 'end': 1423650, 'sentiment': 'NEUTRAL', 'confidence': 0.6307246088981628, 'speaker': 'B'}, {'text': "So with magic, it's the same sort of thing with error.", 'start': 1423720, 'end': 1431570, 'sentiment': 'NEUTRAL', 'confidence': 0.7401474714279175, 'speaker': 'B'}, {'text': "I don't know if you've ever who does the really extreme magic.", 'start': 1432810, 'end': 1441938, 'sentiment': 'NEUTRAL', 'confidence': 0.6570945382118225, 'speaker': 'B'}, {'text': 'David Blaine, where he was in a block.', 'start': 1442034, 'end': 1444002, 'sentiment': 'NEUTRAL', 'confidence': 0.8135828375816345, 'speaker': 'B'}, {'text': 'Yeah, david Blaine, have you ever seen him?', 'start': 1444066, 'end': 1445318, 'sentiment': 'NEUTRAL', 'confidence': 0.828724205493927, 'speaker': 'B'}, {'text': 'He goes to Haiti where you have a community that really believes in magic, and he does some magic and he gets into trouble.', 'start': 1445324, 'end': 1449270, 'sentiment': 'NEUTRAL', 'confidence': 0.6346544027328491, 'speaker': 'B'}, {'text': "Like suddenly all the young men are, no, no, that's no bueno.", 'start': 1449350, 'end': 1454550, 'sentiment': 'NEGATIVE', 'confidence': 0.6890082359313965, 'speaker': 'B'}, {'text': "That you're doing this.", 'start': 1454710, 'end': 1455834, 'sentiment': 'NEUTRAL', 'confidence': 0.7399013638496399, 'speaker': 'B'}, {'text': "And then the camera pans back and he, no, no, hold you here, I'll show you how it's done.", 'start': 1455872, 'end': 1460326, 'sentiment': 'NEUTRAL', 'confidence': 0.7944827675819397, 'speaker': 'B'}, {'text': 'It was just a trick.', 'start': 1460368, 'end': 1461514, 'sentiment': 'NEUTRAL', 'confidence': 0.6913089156150818, 'speaker': 'B'}, {'text': "I'll just show you outside.", 'start': 1461642, 'end': 1462494, 'sentiment': 'NEUTRAL', 'confidence': 0.8201072216033936, 'speaker': 'B'}, {'text': "It's not real magic because there they're not having fun with it anymore.", 'start': 1462532, 'end': 1466410, 'sentiment': 'NEGATIVE', 'confidence': 0.7950870990753174, 'speaker': 'B'}, {'text': "They're like, no, that's not a good thing to do.", 'start': 1466490, 'end': 1470434, 'sentiment': 'NEGATIVE', 'confidence': 0.9288825392723083, 'speaker': 'B'}, {'text': 'So it just goes to show that our engagement with magic is mostly a sort of scary play, I think.', 'start': 1470632, 'end': 1479794, 'sentiment': 'NEGATIVE', 'confidence': 0.5071012377738953, 'speaker': 'B'}, {'text': 'One thing I just kind of sorry about the seagulls.', 'start': 1479832, 'end': 1482526, 'sentiment': 'NEGATIVE', 'confidence': 0.9052518606185913, 'speaker': 'A'}, {'text': "I don't know if you can hear those.", 'start': 1482558, 'end': 1483574, 'sentiment': 'NEUTRAL', 'confidence': 0.5243358016014099, 'speaker': 'A'}, {'text': 'There are seagulls going crazy just outside my window.', 'start': 1483612, 'end': 1486710, 'sentiment': 'NEUTRAL', 'confidence': 0.5427897572517395, 'speaker': 'A'}, {'text': 'One thing I would add is, I think, another aspect to this part of the framework wherein you have this value of prediction error, kind of epistemic and effective emotional value of prediction error.', 'start': 1487450, 'end': 1501526, 'sentiment': 'NEUTRAL', 'confidence': 0.8386868834495544, 'speaker': 'A'}, {'text': "It's one of the kind of key elements in this notion of agency get in active inference that I think is really going to be really important to in mind as you go through the further weeks of this course.", 'start': 1501558, 'end': 1513902, 'sentiment': 'POSITIVE', 'confidence': 0.7322760820388794, 'speaker': 'A'}, {'text': "As well, like I said in the lecture, it's not necessarily speaking to the metaphysical question of free will, but it's certainly moving us away from this picture of the agent as a kind of automaton that's just following rules.", 'start': 1513956, 'end': 1527822, 'sentiment': 'NEUTRAL', 'confidence': 0.753237247467041, 'speaker': 'A'}, {'text': "There's real space here for kind of individuality and creativity as well.", 'start': 1527886, 'end': 1532360, 'sentiment': 'POSITIVE', 'confidence': 0.5258752107620239, 'speaker': 'A'}, {'text': "Okay, Darius has been waiting a little while, so let's go over to him.", 'start': 1534730, 'end': 1540310, 'sentiment': 'NEUTRAL', 'confidence': 0.8673121929168701, 'speaker': 'A'}, {'text': 'Happily patient, happily mean.', 'start': 1540460, 'end': 1543846, 'sentiment': 'POSITIVE', 'confidence': 0.8127453327178955, 'speaker': 'D'}, {'text': "This is this question, I guess, is deriving from my thoughts about the meeting of the high road and the low road, some of the recent work that's been coming out of Maxwell Ramstead and actually a conversation I had with him, which is that the generative model.", 'start': 1543868, 'end': 1559420, 'sentiment': 'NEUTRAL', 'confidence': 0.9097013473510742, 'speaker': 'D'}, {'text': 'So my question, given that given and.', 'start': 1562450, 'end': 1567006, 'sentiment': 'NEUTRAL', 'confidence': 0.8589624166488647, 'speaker': 'D'}, {'text': 'Talk.', 'start': 1567108, 'end': 1567760, 'sentiment': 'NEUTRAL', 'confidence': 0.6679844856262207, 'speaker': 'E'}, {'text': "Is regarding the notion of affordances, I think it's natural that as cognitive scientists and philosophers, we take the perspective intuitively of the agent in the agent arena relationship and how the agent is in the business of reducing prediction error.", 'start': 1569810, 'end': 1584002, 'sentiment': 'NEUTRAL', 'confidence': 0.7672463059425354, 'speaker': 'D'}, {'text': 'I was just wondering whether, as philosophers, you and Mark have thought about what is it like for the whole system to be in the business of reducing its prediction error?', 'start': 1584146, 'end': 1596354, 'sentiment': 'NEUTRAL', 'confidence': 0.8658958077430725, 'speaker': 'D'}, {'text': "So I'm interested in flow states.", 'start': 1596402, 'end': 1598578, 'sentiment': 'POSITIVE', 'confidence': 0.6738324165344238, 'speaker': 'D'}, {'text': "And so, for example, my thinking is that in a canonical example of a flow state, let's say a rock climber, the climbing wall, is also in the business of reducing its prediction error as to afford the opportunity for it to be exploited stealth or themselves are in the business of reducing prediction error.", 'start': 1598764, 'end': 1617514, 'sentiment': 'NEUTRAL', 'confidence': 0.8026328682899475, 'speaker': 'D'}, {'text': "So I'm wondering whether this expansion of affordances is bi directional trial, infinitely directional, better?", 'start': 1617562, 'end': 1624500, 'sentiment': 'NEUTRAL', 'confidence': 0.7827123999595642, 'speaker': 'D'}, {'text': "That's an amazing question.", 'start': 1629430, 'end': 1632020, 'sentiment': 'POSITIVE', 'confidence': 0.9059880971908569, 'speaker': 'A'}, {'text': 'You mentioned Axel constant, but somebody else.', 'start': 1633050, 'end': 1642150, 'sentiment': 'NEUTRAL', 'confidence': 0.7089260220527649, 'speaker': 'A'}, {'text': 'Someone else.', 'start': 1642220, 'end': 1642646, 'sentiment': 'NEUTRAL', 'confidence': 0.6128636598587036, 'speaker': 'D'}, {'text': "But I spoke to Maxwell Ramsey's last week.", 'start': 1642668, 'end': 1645240, 'sentiment': 'NEUTRAL', 'confidence': 0.9117639660835266, 'speaker': 'D'}, {'text': "There's a paper on I'll find it in a second.", 'start': 1648350, 'end': 1651210, 'sentiment': 'NEUTRAL', 'confidence': 0.8002246022224426, 'speaker': 'A'}, {'text': 'On niche construction and affordances.', 'start': 1651280, 'end': 1657462, 'sentiment': 'NEUTRAL', 'confidence': 0.8053233623504639, 'speaker': 'A'}, {'text': "I think it's Axel comps.", 'start': 1657526, 'end': 1660250, 'sentiment': 'NEUTRAL', 'confidence': 0.767538845539093, 'speaker': 'A'}, {'text': 'They talk about the kind of the symmetry between a niche and an agent.', 'start': 1662110, 'end': 1668640, 'sentiment': 'NEUTRAL', 'confidence': 0.8705787658691406, 'speaker': 'A'}, {'text': 'Very much in the same vein as you were just talking about.', 'start': 1669250, 'end': 1671634, 'sentiment': 'NEUTRAL', 'confidence': 0.7799971699714661, 'speaker': 'A'}, {'text': "There this idea that there's not just this unidirectional kind of fit between the agent and the environment or the niche is actually modeling generative model of the agent as well, implicitly.", 'start': 1671672, 'end': 1685510, 'sentiment': 'NEUTRAL', 'confidence': 0.8701016902923584, 'speaker': 'A'}, {'text': "So I think the best I can do there direction of some really interesting work on that, but certainly it's not something that plays a central role in my thinking recently.", 'start': 1686250, 'end': 1698250, 'sentiment': 'NEUTRAL', 'confidence': 0.4781120717525482, 'speaker': 'A'}, {'text': 'Yeah.', 'start': 1698590, 'end': 1698954, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'A'}, {'text': 'So we have the participants chat.', 'start': 1698992, 'end': 1702650, 'sentiment': 'NEUTRAL', 'confidence': 0.868851900100708, 'speaker': 'A'}, {'text': 'Yeah.', 'start': 1703470, 'end': 1704220, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'A'}, {'text': 'A variation approach to niche construction.', 'start': 1704590, 'end': 1706886, 'sentiment': 'NEUTRAL', 'confidence': 0.863412082195282, 'speaker': 'A'}, {'text': 'Yeah.', 'start': 1706998, 'end': 1707274, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'A'}, {'text': "I don't know if Mark has anything to add or anybody else worth thinking about.", 'start': 1707312, 'end': 1715082, 'sentiment': 'NEGATIVE', 'confidence': 0.5094971060752869, 'speaker': 'A'}, {'text': 'Yeah.', 'start': 1715136, 'end': 1715798, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'B'}, {'text': 'Darius, can I just check one thing?', 'start': 1715984, 'end': 1717406, 'sentiment': 'NEUTRAL', 'confidence': 0.8556791543960571, 'speaker': 'B'}, {'text': 'You asked.', 'start': 1717428, 'end': 1717822, 'sentiment': 'NEUTRAL', 'confidence': 0.7501002550125122, 'speaker': 'B'}, {'text': "I don't know how much I need to add here, but did you think that the wall was reducing free energy relative to the climber?", 'start': 1717876, 'end': 1725006, 'sentiment': 'NEUTRAL', 'confidence': 0.6889093518257141, 'speaker': 'B'}, {'text': 'Did you say that?', 'start': 1725038, 'end': 1725954, 'sentiment': 'NEUTRAL', 'confidence': 0.766930341720581, 'speaker': 'B'}, {'text': "That's right.", 'start': 1726072, 'end': 1726980, 'sentiment': 'NEUTRAL', 'confidence': 0.5689783096313477, 'speaker': 'D'}, {'text': "I don't know how that can that be the case?", 'start': 1729270, 'end': 1731042, 'sentiment': 'NEGATIVE', 'confidence': 0.7112667560577393, 'speaker': 'B'}, {'text': 'Can that be the case?', 'start': 1731096, 'end': 1732280, 'sentiment': 'NEUTRAL', 'confidence': 0.7885685563087463, 'speaker': 'B'}, {'text': 'The wall as a thing is maintaining itself relative self evidencing.', 'start': 1732650, 'end': 1739202, 'sentiment': 'NEUTRAL', 'confidence': 0.8113126754760742, 'speaker': 'B'}, {'text': 'Right?', 'start': 1739266, 'end': 1739494, 'sentiment': 'NEUTRAL', 'confidence': 0.7360090017318726, 'speaker': 'H'}, {'text': 'Yeah.', 'start': 1739532, 'end': 1740214, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'B'}, {'text': "But it's not really a duet of one here.", 'start': 1740412, 'end': 1742454, 'sentiment': 'NEUTRAL', 'confidence': 0.7872673273086548, 'speaker': 'B'}, {'text': "It's not like it has a generative model that's deep, where it's modeling the climber, modeling it the same way as tango dancers do.", 'start': 1742492, 'end': 1749740, 'sentiment': 'NEUTRAL', 'confidence': 0.5383119583129883, 'speaker': 'B'}, {'text': 'A tango duo are having cooperative flow states because each movement opens a vista of possible error, minimizing opportunities for the partner, who in turn opens a vista of error minimizing opportunities for the partner and backwards and forwards into this ever opening expanse of affordance capabilities.', 'start': 1750830, 'end': 1771466, 'sentiment': 'NEUTRAL', 'confidence': 0.7487816214561462, 'speaker': 'B'}, {'text': "But an inanimate object and an agent don't really have that same dynamic.", 'start': 1771578, 'end': 1774926, 'sentiment': 'NEUTRAL', 'confidence': 0.5437918305397034, 'speaker': 'B'}, {'text': 'So I was wondering what you were thinking there.', 'start': 1774958, 'end': 1776642, 'sentiment': 'NEUTRAL', 'confidence': 0.844143807888031, 'speaker': 'B'}, {'text': 'So my thinking was that this kind of bleeds into the notion of fluidity of affordances in the kind of Gibsonian sense and the fluidity of concepts.', 'start': 1776776, 'end': 1786610, 'sentiment': 'NEUTRAL', 'confidence': 0.7337145209312439, 'speaker': 'D'}, {'text': 'So I agree in the sense of physical self evidencing, it needs to model the rain, it needs to model the physical environment so as to maintain itself.', 'start': 1786690, 'end': 1794762, 'sentiment': 'NEUTRAL', 'confidence': 0.855757474899292, 'speaker': 'D'}, {'text': "But what about as it's a for it's it's so a sheer rock face is not a climbing wall.", 'start': 1794896, 'end': 1807498, 'sentiment': 'NEUTRAL', 'confidence': 0.7912217974662781, 'speaker': 'D'}, {'text': "And that's because it doesn't self evidence as a climbing wall, it doesn't offer the affordances to be climbed.", 'start': 1807584, 'end': 1812378, 'sentiment': 'NEGATIVE', 'confidence': 0.543999433517456, 'speaker': 'D'}, {'text': "That's why I was kind of referring to which is that affordances change based on the agent arena relationship, right.", 'start': 1812474, 'end': 1818606, 'sentiment': 'NEUTRAL', 'confidence': 0.8930537104606628, 'speaker': 'D'}, {'text': "Your car's affordances change whether it's working or broken down.", 'start': 1818628, 'end': 1821150, 'sentiment': 'NEUTRAL', 'confidence': 0.6838465332984924, 'speaker': 'D'}, {'text': "Similarly, the climbing wall changes whether it's got footholds handholds or whether it's just a sheer rock face.", 'start': 1821220, 'end': 1825762, 'sentiment': 'NEUTRAL', 'confidence': 0.8845227956771851, 'speaker': 'D'}, {'text': 'That was my thinking.', 'start': 1825816, 'end': 1826740, 'sentiment': 'NEUTRAL', 'confidence': 0.8158707022666931, 'speaker': 'D'}, {'text': "It seems slightly spooky to me that we'd think of the wall as self evidencing in that way.", 'start': 1827590, 'end': 1832660, 'sentiment': 'NEGATIVE', 'confidence': 0.600517213344574, 'speaker': 'B'}, {'text': 'I think the language that we tend to use because Julian Kirsten, Eric Reitfeld, Yelly Brunberg and folks often use the idea of affordances and fields of affordances in the active inference way.', 'start': 1833190, 'end': 1844600, 'sentiment': 'NEUTRAL', 'confidence': 0.874743640422821, 'speaker': 'B'}, {'text': "The radical end of the pool there is typically that the affordances don't only happen on the agent side, but rather happen from a dynamic of the changing volatile environment and the generative model of the agent and that they're collaborating in dynamic ongoing ways such that the affordances are emergent between them.", 'start': 1846250, 'end': 1865360, 'sentiment': 'NEUTRAL', 'confidence': 0.8038251996040344, 'speaker': 'B'}, {'text': 'That certainly seems right to me.', 'start': 1866050, 'end': 1868142, 'sentiment': 'POSITIVE', 'confidence': 0.6817827224731445, 'speaker': 'B'}, {'text': "The idea to push it a little bit further and think about the wall self evidencing, I think it's a step too spooky for me.", 'start': 1868276, 'end': 1875300, 'sentiment': 'NEGATIVE', 'confidence': 0.5269047021865845, 'speaker': 'B'}, {'text': "I think I would feel safer a little bit closer to thinking about the affordances are changing relative to the dynamics of the wall, but I don't know what it would mean for the wall to be evidencing, the climber or itself.", 'start': 1875750, 'end': 1891000, 'sentiment': 'NEUTRAL', 'confidence': 0.6754929423332214, 'speaker': 'B'}, {'text': "Ben that's stirred a couple of thoughts a little longer on the work by affordances because there's this really nice distinction in their work between what they call well, I'm not sure if they I think I think that the term landscape of affordances is a little bit older, but they make this distinction between a landscape of affordances and a field of affordances.", 'start': 1891450, 'end': 1922290, 'sentiment': 'POSITIVE', 'confidence': 0.5229587554931641, 'speaker': 'A'}, {'text': 'And I think the reason this is really important to get on the table is because this distinction is kind of directly targeting the dynamic, shifting, very affective nature of affordances.', 'start': 1922710, 'end': 1935762, 'sentiment': 'NEUTRAL', 'confidence': 0.566964328289032, 'speaker': 'A'}, {'text': 'So on the one hand, you have this landscape of affordances that is relatively static.', 'start': 1935826, 'end': 1941030, 'sentiment': 'NEUTRAL', 'confidence': 0.7830274701118469, 'speaker': 'A'}, {'text': 'So right now my landscape of affordances is Brighton.', 'start': 1941850, 'end': 1945510, 'sentiment': 'NEUTRAL', 'confidence': 0.8833712339401245, 'speaker': 'A'}, {'text': 'And the landscape of affordances in that sense is not really going to change very rapidly unless I kind of jump on a plane and go somewhere else.', 'start': 1946250, 'end': 1953018, 'sentiment': 'NEUTRAL', 'confidence': 0.5196682214736938, 'speaker': 'A'}, {'text': 'But the field of affordances has this thoroughly kind of normative, affective character to it.', 'start': 1953184, 'end': 1960030, 'sentiment': 'NEUTRAL', 'confidence': 0.8354582190513611, 'speaker': 'A'}, {'text': 'So depending on my internal state at any given time, depending on my expectations or my desires, say, my field of affordances is going to shift very rapidly.', 'start': 1960180, 'end': 1970746, 'sentiment': 'NEUTRAL', 'confidence': 0.8191483020782471, 'speaker': 'A'}, {'text': 'So not just predicated on my internal state, but also kind of contextual cues as well.', 'start': 1970938, 'end': 1976066, 'sentiment': 'NEUTRAL', 'confidence': 0.8912298083305359, 'speaker': 'A'}, {'text': "So if something were to happen in the environment that was afforded very high precision weight in, then that's likely to shift my field of affordances significantly.", 'start': 1976168, 'end': 1984710, 'sentiment': 'NEUTRAL', 'confidence': 0.7552300691604614, 'speaker': 'A'}, {'text': "I think that the reason that I'm kind of emphasizing this to Darius's point is and kind of building on what Mark said, it doesn't seem like this distinction at least would apply from the perspective of the wall, say, because this kind of affectivity and normativity just isn't a feature of the wall's experience of the world.", 'start': 1986570, 'end': 2008154, 'sentiment': 'NEUTRAL', 'confidence': 0.5203486084938049, 'speaker': 'A'}, {'text': 'And also to kind of run with affordances.', 'start': 2008272, 'end': 2011482, 'sentiment': 'NEUTRAL', 'confidence': 0.8096894025802612, 'speaker': 'A'}, {'text': 'Perhaps you could say a bit more about how you would kind of think about this.', 'start': 2011626, 'end': 2014926, 'sentiment': 'NEUTRAL', 'confidence': 0.8819807767868042, 'speaker': 'A'}, {'text': 'Darius because affordances are kind of opportunities for to.', 'start': 2014948, 'end': 2023594, 'sentiment': 'NEUTRAL', 'confidence': 0.7539286017417908, 'speaker': 'A'}, {'text': "There's some debate about this, but I like to think of them as like a relational property between you have the skilled capabilities of an embodied agent and then you have some feature of the environment.", 'start': 2023652, 'end': 2033150, 'sentiment': 'NEUTRAL', 'confidence': 0.7174307703971863, 'speaker': 'A'}, {'text': "So I think when you're thinking from the perspective of the wall, you have the features of the environment because you.", 'start': 2033310, 'end': 2038854, 'sentiment': 'NEUTRAL', 'confidence': 0.849873960018158, 'speaker': 'A'}, {'text': 'Have the embodied characteristics of the agent are kind of playing that role.', 'start': 2038892, 'end': 2043522, 'sentiment': 'NEUTRAL', 'confidence': 0.9047204852104187, 'speaker': 'A'}, {'text': "But it's not clear to me what the kind of skilled capabilities of the wall is.", 'start': 2043666, 'end': 2048506, 'sentiment': 'NEUTRAL', 'confidence': 0.5779763460159302, 'speaker': 'A'}, {'text': 'So yeah, if you could just say a bit more about that.', 'start': 2048608, 'end': 2051226, 'sentiment': 'NEUTRAL', 'confidence': 0.8352087736129761, 'speaker': 'A'}, {'text': 'Yeah, I mean, it may be the case, as you pointed out, that actually the technical term affordance as being opportunities for action is misplaced.', 'start': 2051408, 'end': 2059450, 'sentiment': 'NEUTRAL', 'confidence': 0.5816502571105957, 'speaker': 'D'}, {'text': "This is a lot of this I've been formulating, having read this very new paper by Ramsey and colleagues on Bayesian mechanics of physics of and by beliefs, where he really rams home this point, that the system, the generative model is the system of the kind of stochastic differential equations across the state space.", 'start': 2061390, 'end': 2080370, 'sentiment': 'NEUTRAL', 'confidence': 0.8011672496795654, 'speaker': 'D'}, {'text': 'So across the Marko blanca, across the particle with its Marko blanket and the external states.', 'start': 2080440, 'end': 2085398, 'sentiment': 'NEUTRAL', 'confidence': 0.8830382227897644, 'speaker': 'D'}, {'text': 'And that is the system which is in that system itself is in the business of reducing free energy.', 'start': 2085564, 'end': 2091638, 'sentiment': 'NEUTRAL', 'confidence': 0.5762547850608826, 'speaker': 'D'}, {'text': "So it's not just the active inference agent, it's the whole system which is embedded in a whole system of other things.", 'start': 2091724, 'end': 2098282, 'sentiment': 'NEUTRAL', 'confidence': 0.7927365899085999, 'speaker': 'D'}, {'text': 'And so that was my general thinking, is that just on the prerequisite that these systems exist just on that a prior axiom, there has to be some kind of self evidencing of that system itself.', 'start': 2098336, 'end': 2110446, 'sentiment': 'NEUTRAL', 'confidence': 0.8269145488739014, 'speaker': 'D'}, {'text': 'So maybe affordance is the wrong word.', 'start': 2110548, 'end': 2112640, 'sentiment': 'NEGATIVE', 'confidence': 0.6531553864479065, 'speaker': 'D'}, {'text': 'That might be the trick right there.', 'start': 2114850, 'end': 2116142, 'sentiment': 'NEUTRAL', 'confidence': 0.7779300808906555, 'speaker': 'B'}, {'text': "As soon as you provoke affordance, you're provoking phenomenology.", 'start': 2116196, 'end': 2120538, 'sentiment': 'NEUTRAL', 'confidence': 0.791370153427124, 'speaker': 'B'}, {'text': "And so now we're not talking just about statistical variations.", 'start': 2120634, 'end': 2123582, 'sentiment': 'NEUTRAL', 'confidence': 0.5524540543556213, 'speaker': 'B'}, {'text': "Now we're talking about lived experience.", 'start': 2123646, 'end': 2125460, 'sentiment': 'NEUTRAL', 'confidence': 0.8510234355926514, 'speaker': 'B'}, {'text': 'That might be the linchpin right there, I think.', 'start': 2126310, 'end': 2128994, 'sentiment': 'NEUTRAL', 'confidence': 0.8838158249855042, 'speaker': 'B'}, {'text': 'I think that is right.', 'start': 2129112, 'end': 2130034, 'sentiment': 'POSITIVE', 'confidence': 0.6482130885124207, 'speaker': 'A'}, {'text': 'Yeah.', 'start': 2130072, 'end': 2130418, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'A'}, {'text': "And I would say I think, Darius, you're absolutely on the right track and there is this ambiguity about affordances.", 'start': 2130504, 'end': 2136858, 'sentiment': 'POSITIVE', 'confidence': 0.6584498286247253, 'speaker': 'A'}, {'text': "But aside from that, I think you're absolutely mean it's just nonsensical to think about an agent absent an environment under active to.", 'start': 2136894, 'end': 2148154, 'sentiment': 'NEGATIVE', 'confidence': 0.7884793281555176, 'speaker': 'A'}, {'text': "It is this agent environment system in its totality that's minimizing free energy.", 'start': 2148352, 'end': 2152860, 'sentiment': 'NEUTRAL', 'confidence': 0.7265670299530029, 'speaker': 'A'}, {'text': 'They have to be taken together as one.', 'start': 2153310, 'end': 2154986, 'sentiment': 'NEUTRAL', 'confidence': 0.6787237524986267, 'speaker': 'A'}, {'text': "And I know Avel, you've had your hand up for a little while there.", 'start': 2155008, 'end': 2158366, 'sentiment': 'NEUTRAL', 'confidence': 0.8304846882820129, 'speaker': 'A'}, {'text': 'Is there something you wanted to add?', 'start': 2158468, 'end': 2160080, 'sentiment': 'NEUTRAL', 'confidence': 0.8935360908508301, 'speaker': 'A'}, {'text': 'Yes.', 'start': 2162050, 'end': 2162798, 'sentiment': 'POSITIVE', 'confidence': 0.46103888750076294, 'speaker': 'H'}, {'text': 'Do you hear me?', 'start': 2162964, 'end': 2163886, 'sentiment': 'NEUTRAL', 'confidence': 0.7720435261726379, 'speaker': 'H'}, {'text': 'Well, we do.', 'start': 2163908, 'end': 2165230, 'sentiment': 'NEUTRAL', 'confidence': 0.7311861515045166, 'speaker': 'A'}, {'text': 'I do anyway.', 'start': 2165300, 'end': 2166126, 'sentiment': 'NEUTRAL', 'confidence': 0.5834073424339294, 'speaker': 'A'}, {'text': 'Okay, so about the afferences world having afferences and basically the symmetry of agents and environment is a property of active inference.', 'start': 2166228, 'end': 2177070, 'sentiment': 'NEUTRAL', 'confidence': 0.8638351559638977, 'speaker': 'H'}, {'text': 'Well, of the frenzy principle.', 'start': 2177150, 'end': 2179038, 'sentiment': 'NEUTRAL', 'confidence': 0.7787895202636719, 'speaker': 'H'}, {'text': 'So if you buy the frenzy principle and you also buy that it entails that agent have affordances or any approximal notion, then you also buy that walls have affordances.', 'start': 2179214, 'end': 2193106, 'sentiment': 'NEUTRAL', 'confidence': 0.8003242015838623, 'speaker': 'H'}, {'text': 'So there are basically three position you can have on that.', 'start': 2193298, 'end': 2197100, 'sentiment': 'NEUTRAL', 'confidence': 0.8898339867591858, 'speaker': 'H'}, {'text': 'One is that active inference is correct.', 'start': 2198030, 'end': 2200746, 'sentiment': 'NEUTRAL', 'confidence': 0.5937017798423767, 'speaker': 'H'}, {'text': 'Wall are fucking affordances and they do self evidencing, which I would not go with.', 'start': 2200848, 'end': 2205900, 'sentiment': 'NEGATIVE', 'confidence': 0.9598032832145691, 'speaker': 'H'}, {'text': 'Another option is that you have basically devolved in the detail.', 'start': 2206450, 'end': 2213038, 'sentiment': 'NEUTRAL', 'confidence': 0.758147656917572, 'speaker': 'H'}, {'text': 'So, for example, maybe the adjunct environment is not the wall.', 'start': 2213124, 'end': 2217358, 'sentiment': 'NEUTRAL', 'confidence': 0.7233341932296753, 'speaker': 'H'}, {'text': "It's something that is broader, like Gaia system, whatever, and it just happens.", 'start': 2217444, 'end': 2223058, 'sentiment': 'NEUTRAL', 'confidence': 0.8352316617965698, 'speaker': 'H'}, {'text': 'It includes the wall, but it is not the wall.', 'start': 2223144, 'end': 2226562, 'sentiment': 'NEUTRAL', 'confidence': 0.5864124894142151, 'speaker': 'H'}, {'text': 'And it does do self balancing.', 'start': 2226616, 'end': 2229010, 'sentiment': 'NEUTRAL', 'confidence': 0.8420088887214661, 'speaker': 'H'}, {'text': 'And the third is that active inference is wrong.', 'start': 2229830, 'end': 2232774, 'sentiment': 'NEGATIVE', 'confidence': 0.7766114473342896, 'speaker': 'H'}, {'text': "We don't have affordances based on whatever is the formal presentation of active inference.", 'start': 2232972, 'end': 2239030, 'sentiment': 'NEUTRAL', 'confidence': 0.5090923309326172, 'speaker': 'H'}, {'text': 'And I would go in that direction of this phenomenology stuff.', 'start': 2239450, 'end': 2247402, 'sentiment': 'NEUTRAL', 'confidence': 0.8502054214477539, 'speaker': 'H'}, {'text': 'So we have, I would say, philosophical evidence in the sense that denying this would lead to nonsense.', 'start': 2247456, 'end': 2255334, 'sentiment': 'NEUTRAL', 'confidence': 0.5902075171470642, 'speaker': 'H'}, {'text': 'But information is based on observation, and some system do observing much more actively than others.', 'start': 2255382, 'end': 2263198, 'sentiment': 'NEUTRAL', 'confidence': 0.7201265692710876, 'speaker': 'H'}, {'text': "And maybe it's a good thing to have in your formalism.", 'start': 2263364, 'end': 2265946, 'sentiment': 'POSITIVE', 'confidence': 0.7052206993103027, 'speaker': 'H'}, {'text': "I'd say so.", 'start': 2266058, 'end': 2268400, 'sentiment': 'NEUTRAL', 'confidence': 0.7331358790397644, 'speaker': 'H'}, {'text': 'You have maybe a stronger case for the way phenomenology affordances are constructed in the quantum formulation of the FEP, if there is such a thing, which, like Chris Fields, someone who we should baseline believe claims there is.', 'start': 2269190, 'end': 2286726, 'sentiment': 'NEUTRAL', 'confidence': 0.7628551125526428, 'speaker': 'H'}, {'text': 'Because then you have formalization which is not in terms of dynamics per se, so causal constraints, but observation and indirectly phenomenology.', 'start': 2286908, 'end': 2298486, 'sentiment': 'NEUTRAL', 'confidence': 0.8319295048713684, 'speaker': 'H'}, {'text': 'Maybe you have something that is stronger there.', 'start': 2298598, 'end': 2300522, 'sentiment': 'POSITIVE', 'confidence': 0.5389315485954285, 'speaker': 'H'}, {'text': 'But right now, the link sorry, there is actually a bunch of people who have a quite good hold on science, which are the ecological activity and cognition on one hand and between cognition and the metabolism, the constitution of the living thing that cognites on the other and one of their definition of agency cognition.', 'start': 2300576, 'end': 2334210, 'sentiment': 'POSITIVE', 'confidence': 0.5264936089515686, 'speaker': 'H'}, {'text': 'Pick one entails interactional, asymmetry I think is the word.', 'start': 2334290, 'end': 2341480, 'sentiment': 'NEUTRAL', 'confidence': 0.8109616637229919, 'speaker': 'H'}, {'text': 'That is something we would need to translate into active inference, well into the FEP for active inference to have a strong grip over this affordancing.', 'start': 2346670, 'end': 2357530, 'sentiment': 'NEUTRAL', 'confidence': 0.8180897235870361, 'speaker': 'H'}, {'text': 'Until then, we have a kind of handwriting way.', 'start': 2358030, 'end': 2362046, 'sentiment': 'NEUTRAL', 'confidence': 0.8597522377967834, 'speaker': 'H'}, {'text': 'It relates it to more conceptual approaches that are related to an active and ecological approach to psychology.', 'start': 2362068, 'end': 2369950, 'sentiment': 'NEUTRAL', 'confidence': 0.6652222275733948, 'speaker': 'H'}, {'text': 'And, yeah, the formalism lags basically behind the concept for now.', 'start': 2370110, 'end': 2377460, 'sentiment': 'NEGATIVE', 'confidence': 0.679322361946106, 'speaker': 'H'}, {'text': 'Sorry for the long talk.', 'start': 2378230, 'end': 2380260, 'sentiment': 'NEGATIVE', 'confidence': 0.6870955228805542, 'speaker': 'H'}, {'text': 'No, that was great.', 'start': 2381690, 'end': 2382758, 'sentiment': 'POSITIVE', 'confidence': 0.8244106769561768, 'speaker': 'A'}, {'text': 'Much appreciated.', 'start': 2382844, 'end': 2383990, 'sentiment': 'POSITIVE', 'confidence': 0.9306212663650513, 'speaker': 'A'}, {'text': 'Anybody else want to come in on a question of affordances?', 'start': 2387210, 'end': 2390834, 'sentiment': 'NEUTRAL', 'confidence': 0.8791057467460632, 'speaker': 'A'}, {'text': 'Because I know affordance has played a fairly substantial role in the lecture.', 'start': 2390882, 'end': 2396410, 'sentiment': 'NEUTRAL', 'confidence': 0.7279812097549438, 'speaker': 'A'}, {'text': "Anybody has any questions related to affordances or action perception affordances, then now's the time.", 'start': 2403870, 'end': 2412080, 'sentiment': 'NEUTRAL', 'confidence': 0.833426833152771, 'speaker': 'A'}, {'text': "Yeah, I do have one, but it's not well structured yet.", 'start': 2413090, 'end': 2417678, 'sentiment': 'NEGATIVE', 'confidence': 0.6592355966567993, 'speaker': 'E'}, {'text': "That's really fine.", 'start': 2417844, 'end': 2418960, 'sentiment': 'POSITIVE', 'confidence': 0.9304569363594055, 'speaker': 'A'}, {'text': "Something that I've been thinking about for the last month because I started to depend on artificial intelligence field coming from a humanities background and philosophical background.", 'start': 2420130, 'end': 2430094, 'sentiment': 'NEUTRAL', 'confidence': 0.8528971076011658, 'speaker': 'E'}, {'text': "So I'm mixing many things in this period, mainly following the active inference as a crossroad between many disciplines, and this is very beautiful about the framework.", 'start': 2430142, 'end': 2441602, 'sentiment': 'POSITIVE', 'confidence': 0.9556254148483276, 'speaker': 'E'}, {'text': "And I was super curious about the question proposed by Darius, and I was then thinking about now we're actually facing a new environment and a new landscape in which we're interacting with actually generating over revolutionary time and synchronizing over evolution.", 'start': 2441746, 'end': 2467418, 'sentiment': 'POSITIVE', 'confidence': 0.5648746490478516, 'speaker': 'E'}, {'text': 'Technological alien agencies operating within our landscape and field of affordances.', 'start': 2467594, 'end': 2475406, 'sentiment': 'NEUTRAL', 'confidence': 0.687252402305603, 'speaker': 'A'}, {'text': "So I think there's a lot of really interesting work to potentially be done there.", 'start': 2475518, 'end': 2481090, 'sentiment': 'POSITIVE', 'confidence': 0.9693875908851624, 'speaker': 'A'}, {'text': "I will take the opportunity to shamelessly plug a preprint that Mark and I have released recently, where one thing that I'm really interested in, that I can kind of speak with some confidence on is the fact that I do think there's a point at which the theory of affordances or the language of affordances, starts to break down to.", 'start': 2481160, 'end': 2503980, 'sentiment': 'NEUTRAL', 'confidence': 0.5369252562522888, 'speaker': 'A'}, {'text': "So the preprint I'll share around is looking at ambient technology specifically.", 'start': 2507410, 'end': 2515002, 'sentiment': 'NEUTRAL', 'confidence': 0.8718968629837036, 'speaker': 'A'}, {'text': "So this is technology that the whole kind of impetus behind its design and conceptualization is that the user doesn't have to actually do anything.", 'start': 2515066, 'end': 2524626, 'sentiment': 'NEUTRAL', 'confidence': 0.6703087687492371, 'speaker': 'A'}, {'text': 'So it precedes the user Pragmatically and epistemically.', 'start': 2524808, 'end': 2528062, 'sentiment': 'NEUTRAL', 'confidence': 0.8555638194084167, 'speaker': 'A'}, {'text': 'It knows what kinds of things you want it to do, and it just does them in the background.', 'start': 2528126, 'end': 2532354, 'sentiment': 'NEUTRAL', 'confidence': 0.8525374531745911, 'speaker': 'A'}, {'text': 'And it works by shifting kind of it subtly shifts the material environment such that it impacts your field of affordances in real time.', 'start': 2532482, 'end': 2541480, 'sentiment': 'NEUTRAL', 'confidence': 0.833121657371521, 'speaker': 'A'}, {'text': "And the argument that we make in that paper is essentially that the affordances approach doesn't really work for this and that we need to kind of think again, I think that that might be how to conceptualize generative AI, for example, under the affordances framework.", 'start': 2542890, 'end': 2562122, 'sentiment': 'NEUTRAL', 'confidence': 0.5088552832603455, 'speaker': 'A'}, {'text': "I don't know of anybody that's done any work on that, but it would certainly make a really cool project.", 'start': 2562266, 'end': 2566720, 'sentiment': 'POSITIVE', 'confidence': 0.9522356986999512, 'speaker': 'A'}, {'text': 'You are making it right now.', 'start': 2570090, 'end': 2572440, 'sentiment': 'POSITIVE', 'confidence': 0.8323299288749695, 'speaker': 'H'}, {'text': "What's that?", 'start': 2573770, 'end': 2574840, 'sentiment': 'NEUTRAL', 'confidence': 0.7330603003501892, 'speaker': 'A'}, {'text': 'You are making it right now.', 'start': 2576410, 'end': 2578246, 'sentiment': 'POSITIVE', 'confidence': 0.8323299288749695, 'speaker': 'H'}, {'text': 'I know because you sent me the paper to review.', 'start': 2578268, 'end': 2580840, 'sentiment': 'NEUTRAL', 'confidence': 0.8037756681442261, 'speaker': 'H'}, {'text': 'Oh, yeah.', 'start': 2581450, 'end': 2582520, 'sentiment': 'NEUTRAL', 'confidence': 0.5585339665412903, 'speaker': 'A'}, {'text': 'Thank you.', 'start': 2584910, 'end': 2585820, 'sentiment': 'POSITIVE', 'confidence': 0.8529649972915649, 'speaker': 'E'}, {'text': 'Early stages of a paper on the role of generative AI in classrooms.', 'start': 2590030, 'end': 2594914, 'sentiment': 'NEUTRAL', 'confidence': 0.8225982785224915, 'speaker': 'A'}, {'text': "So, from the perspective of thinking about what kinds of affordance does generative AI represent in a learning environment, particularly, we're kind of applying active inference to classroom design and looking at it from the angles of different educational and pedagogical theories.", 'start': 2595062, 'end': 2614210, 'sentiment': 'NEUTRAL', 'confidence': 0.8386902213096619, 'speaker': 'A'}, {'text': "But it's very early days.", 'start': 2614630, 'end': 2617700, 'sentiment': 'NEUTRAL', 'confidence': 0.6627600789070129, 'speaker': 'A'}, {'text': 'It probably depends on your view of generative II in general.', 'start': 2620070, 'end': 2623122, 'sentiment': 'NEUTRAL', 'confidence': 0.8575495481491089, 'speaker': 'A'}, {'text': 'I mean, it depends whether you would consider it a real cognitive agent or not.', 'start': 2623176, 'end': 2627640, 'sentiment': 'NEUTRAL', 'confidence': 0.818335235118866, 'speaker': 'A'}, {'text': 'I think some people are more inclined to think of it as this is a thing that has agency, it has real understanding, and other people are maybe less inclined to think of it in those terms.', 'start': 2628490, 'end': 2641162, 'sentiment': 'NEUTRAL', 'confidence': 0.6892711520195007, 'speaker': 'A'}, {'text': 'And I think that might bear significantly on how you think of it.', 'start': 2641216, 'end': 2645580, 'sentiment': 'NEUTRAL', 'confidence': 0.8608832359313965, 'speaker': 'A'}, {'text': "Yeah, that's super cool.", 'start': 2646930, 'end': 2647966, 'sentiment': 'POSITIVE', 'confidence': 0.9848061203956604, 'speaker': 'E'}, {'text': 'That basically the last project you mentioned is very in line with my PhD project right now because my main PhD.', 'start': 2647988, 'end': 2655514, 'sentiment': 'POSITIVE', 'confidence': 0.6355573534965515, 'speaker': 'E'}, {'text': "Project is our European foundings, and it's about the AI for personalized education, and I'm trying to follow it through the active inference framework from a multi level perspective.", 'start': 2655562, 'end': 2665410, 'sentiment': 'NEUTRAL', 'confidence': 0.5317949652671814, 'speaker': 'E'}, {'text': 'Very cool.', 'start': 2667350, 'end': 2668130, 'sentiment': 'POSITIVE', 'confidence': 0.9677404165267944, 'speaker': 'A'}, {'text': 'Yeah, we should we should probably talk more about that.', 'start': 2668200, 'end': 2670500, 'sentiment': 'NEUTRAL', 'confidence': 0.6897581815719604, 'speaker': 'A'}, {'text': 'Okay.', 'start': 2673690, 'end': 2674342, 'sentiment': 'NEUTRAL', 'confidence': 0.584351658821106, 'speaker': 'A'}, {'text': 'Darius.', 'start': 2674476, 'end': 2675350, 'sentiment': 'NEUTRAL', 'confidence': 0.6827870011329651, 'speaker': 'A'}, {'text': 'Yeah?', 'start': 2677930, 'end': 2678294, 'sentiment': 'NEUTRAL', 'confidence': 0.7381101250648499, 'speaker': 'B'}, {'text': 'I wanted to ask I mean, this may be directed more mark so I know this is kind of his work in terms of slopes of uncertainty and about doing better than expected at reducing prediction error over time.', 'start': 2678332, 'end': 2691820, 'sentiment': 'NEUTRAL', 'confidence': 0.6217035055160522, 'speaker': 'D'}, {'text': "I was wondering kind of how the architecture of that is built into the particle, into the generative model because we have the kind of for me, I don't know if it's an hour and out sort of conflict, but we have these kind of implicit priors that we're going to fulfill certain expectations or minimize prediction error regarding certain things.", 'start': 2692350, 'end': 2713602, 'sentiment': 'NEUTRAL', 'confidence': 0.7911458611488342, 'speaker': 'D'}, {'text': 'Right.', 'start': 2713656, 'end': 2713826, 'sentiment': 'NEUTRAL', 'confidence': 0.5664746165275574, 'speaker': 'H'}, {'text': 'So homeostatic priors or happiness, well being, whatever it is.', 'start': 2713848, 'end': 2718850, 'sentiment': 'NEUTRAL', 'confidence': 0.6701031923294067, 'speaker': 'D'}, {'text': 'But then your claim is that we have the higher order beliefs, the higher order predictions that over and above, that I also need to do well, better than expected at reducing prediction error over time.', 'start': 2719000, 'end': 2731958, 'sentiment': 'NEUTRAL', 'confidence': 0.5712866187095642, 'speaker': 'D'}, {'text': "So it's still quite fuzzy in my mind.", 'start': 2732124, 'end': 2735434, 'sentiment': 'NEUTRAL', 'confidence': 0.7366185188293457, 'speaker': 'D'}, {'text': 'But is there a kind of potential conflict there between the general priors that the system has and then actually, in a sense, violating those expectations by going over and above them, which itself constitutes an expectation?', 'start': 2735472, 'end': 2751002, 'sentiment': 'NEGATIVE', 'confidence': 0.5108585357666016, 'speaker': 'D'}, {'text': 'How do you kind of resolve that tension?', 'start': 2751066, 'end': 2754110, 'sentiment': 'NEUTRAL', 'confidence': 0.7659983038902283, 'speaker': 'D'}, {'text': "Yeah, that's interesting, but this is very much in Ben's wheelhouse too.", 'start': 2755810, 'end': 2760366, 'sentiment': 'POSITIVE', 'confidence': 0.8324413299560547, 'speaker': 'B'}, {'text': "Ben and I have been working on sloppy stuff for almost as long as I've been doing on his original paper called We'll Get It Up.", 'start': 2760468, 'end': 2786146, 'sentiment': 'NEUTRAL', 'confidence': 0.6401664614677429, 'speaker': 'B'}, {'text': 'They do a really good job of showing technically where this sits within a deep parametric model.', 'start': 2786168, 'end': 2792500, 'sentiment': 'POSITIVE', 'confidence': 0.9307831525802612, 'speaker': 'B'}, {'text': "Lara Senved Smith's paper on metacognition also does this by showing you have these depths of modeling where models above are modeling models below, and optimizing over those models below.", 'start': 2793430, 'end': 2806278, 'sentiment': 'NEUTRAL', 'confidence': 0.7404506802558899, 'speaker': 'B'}, {'text': 'So we have some good computational backbone for thinking, for not only thinking that this is the case, but beginning to express how it does the work it does.', 'start': 2806364, 'end': 2817100, 'sentiment': 'POSITIVE', 'confidence': 0.7265035510063171, 'speaker': 'B'}, {'text': "So let's leave that for digging into it, though, technically, sort of on our own, let me say sort of at a higher, more abstract level still, hopefully it's useful.", 'start': 2817630, 'end': 2826830, 'sentiment': 'POSITIVE', 'confidence': 0.7789794206619263, 'speaker': 'B'}, {'text': "It's not weird to think that this kind of anticipatory system is not only making predictions about the world, but it's also part of what it's predicting is how fast or slow, how efficient it is in particular contexts at resolving certain kinds of errors.", 'start': 2827490, 'end': 2844462, 'sentiment': 'NEUTRAL', 'confidence': 0.5849024057388306, 'speaker': 'B'}, {'text': "That's a perfectly fine thing to think that we're also predicting slopes of engagement.", 'start': 2844606, 'end': 2849990, 'sentiment': 'POSITIVE', 'confidence': 0.5497953295707703, 'speaker': 'B'}, {'text': "And then all we're saying then is system also pays attention to when those expectations are breached and it's learning from those breaches that should just be the bread and butter for what the system does anyway.", 'start': 2851050, 'end': 2860634, 'sentiment': 'NEUTRAL', 'confidence': 0.6359196305274963, 'speaker': 'B'}, {'text': 'So precision is a second order process in much the same way precision is about how reliable are lower level predictions and then using that amount to toggle how impactful either errors or predictions are.', 'start': 2860752, 'end': 2882318, 'sentiment': 'NEUTRAL', 'confidence': 0.7429998517036438, 'speaker': 'B'}, {'text': "So we've already got baked into the system, right from early days, this idea that the system is not only making predictions, but monitoring its own predictive processing regimes and then toggling based on how reliable those substreams are.", 'start': 2882404, 'end': 2897860, 'sentiment': 'NEUTRAL', 'confidence': 0.8273999691009521, 'speaker': 'B'}, {'text': "All we're adding here is when we first thought about those mechanisms, one thing that can happen, this is just good for everybody who's interested in active inference, because I bump into this with my students all the time when we say something like precision weighting, a tendency to think of thing.", 'start': 2898310, 'end': 2915100, 'sentiment': 'POSITIVE', 'confidence': 0.831941545009613, 'speaker': 'B'}, {'text': "So we go to find this precision like where's the biological or precision weighting?", 'start': 2916830, 'end': 2924566, 'sentiment': 'NEUTRAL', 'confidence': 0.8285582661628723, 'speaker': 'B'}, {'text': 'But when we actually get into a biosystem and we look for these things, the truth is precision is going to be weighted in lots of different ways.', 'start': 2924598, 'end': 2932414, 'sentiment': 'NEUTRAL', 'confidence': 0.7660130858421326, 'speaker': 'B'}, {'text': "I mean, that's the real frontier of this research is to actually find how these things are instantiated and the answer is going to be multifarious.", 'start': 2932452, 'end': 2939086, 'sentiment': 'NEUTRAL', 'confidence': 0.706448495388031, 'speaker': 'B'}, {'text': "I mean, you're going to have precision adjustments happening throughout the system in lots of ways.", 'start': 2939118, 'end': 2943138, 'sentiment': 'NEUTRAL', 'confidence': 0.863680362701416, 'speaker': 'B'}, {'text': 'It could be synchrony and asynchronous and desynchronies between systems.', 'start': 2943224, 'end': 2947042, 'sentiment': 'NEUTRAL', 'confidence': 0.8236300945281982, 'speaker': 'B'}, {'text': 'It can be neuromodulatory chemicals, it can be structural shapes within the brain.', 'start': 2947106, 'end': 2953842, 'sentiment': 'NEUTRAL', 'confidence': 0.8675143718719482, 'speaker': 'B'}, {'text': 'I mean, precision is going to be set in lots of different ways.', 'start': 2953906, 'end': 2957718, 'sentiment': 'NEUTRAL', 'confidence': 0.8372575640678406, 'speaker': 'B'}, {'text': "So all that we're pointing out here is that one of the ways that precision is being set, one of the ways that the system is tracking how efficient it is and then upping or lowering the amount of impact error signals or predictions have, is that it's happening in an embodied way.", 'start': 2957884, 'end': 2983486, 'sentiment': 'NEUTRAL', 'confidence': 0.817521870136261, 'speaker': 'B'}, {'text': "So we've looked over to the effective search and lo and behold, there are all these signatures that we were looking for for this part of the machinery.", 'start': 2983588, 'end': 2994690, 'sentiment': 'NEUTRAL', 'confidence': 0.691169798374176, 'speaker': 'B'}, {'text': 'So not weird that the system is tracking its own regularities and adjusting.', 'start': 2996470, 'end': 3000394, 'sentiment': 'NEUTRAL', 'confidence': 0.6817412376403809, 'speaker': 'B'}, {'text': 'That was baked in right from the beginning.', 'start': 3000462, 'end': 3002338, 'sentiment': 'NEUTRAL', 'confidence': 0.6172475218772888, 'speaker': 'B'}, {'text': "How it does that, that's one of the frontiers.", 'start': 3002514, 'end': 3005826, 'sentiment': 'NEUTRAL', 'confidence': 0.6999838352203369, 'speaker': 'B'}, {'text': "It's going to happen in lots of different ways.", 'start': 3005858, 'end': 3007654, 'sentiment': 'NEUTRAL', 'confidence': 0.7731349468231201, 'speaker': 'B'}, {'text': 'Lo and behold.', 'start': 3007772, 'end': 3008594, 'sentiment': 'NEUTRAL', 'confidence': 0.527556836605072, 'speaker': 'B'}, {'text': 'Affect the dynamics, the shoe fits, they look like they do that stuff and then you bring it to the lab and you go back to like reward prediction error research and sure enough, neuromodulatory chemicals, reward systems are tuning affective dynamics relative to better than and worse than slopes of uncertainty management.', 'start': 3008642, 'end': 3027898, 'sentiment': 'NEUTRAL', 'confidence': 0.49744147062301636, 'speaker': 'B'}, {'text': "It's exactly what we would expect given the computational model.", 'start': 3027994, 'end': 3031760, 'sentiment': 'NEUTRAL', 'confidence': 0.6976091265678406, 'speaker': 'B'}, {'text': "So then it was an easy next step to start saying, well look, there's one of the ways that precision, there's one of the ways that affect system.", 'start': 3032290, 'end': 3046242, 'sentiment': 'NEUTRAL', 'confidence': 0.6835237145423889, 'speaker': 'B'}, {'text': "Now just notice there it's the only precision, it's not the only thing the affected system is doing.", 'start': 3046376, 'end': 3051554, 'sentiment': 'NEUTRAL', 'confidence': 0.82005774974823, 'speaker': 'B'}, {'text': "We never want to say we're careful not to be reductionist to say, oh, affect is always aerodynamics.", 'start': 3051592, 'end': 3057570, 'sentiment': 'NEUTRAL', 'confidence': 0.6133680939674377, 'speaker': 'B'}, {'text': "I don't think that's right.", 'start': 3057650, 'end': 3058678, 'sentiment': 'NEGATIVE', 'confidence': 0.8846431970596313, 'speaker': 'B'}, {'text': "I think it's that aerodynamics are expressed in part effectively and they have this impact on the system that we've known about for a long time, even from just the reward prediction error literature.", 'start': 3058764, 'end': 3070390, 'sentiment': 'NEUTRAL', 'confidence': 0.7438820004463196, 'speaker': 'B'}, {'text': 'Does that help or was that a bit is that okay?', 'start': 3070550, 'end': 3073340, 'sentiment': 'NEUTRAL', 'confidence': 0.8037517070770264, 'speaker': 'B'}, {'text': 'Yeah.', 'start': 3074190, 'end': 3074940, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'D'}, {'text': 'Just to add two things really quickly there because I know time is kind of catching up with us.', 'start': 3078370, 'end': 3083950, 'sentiment': 'NEUTRAL', 'confidence': 0.5779224038124084, 'speaker': 'A'}, {'text': 'I would emphasize as well, just as a kind of general .1 of the things I really like about the work on aerodynamics and affect is it has this nice kind of broad capture of the kinds of affectivity that agents can experience.', 'start': 3084020, 'end': 3097586, 'sentiment': 'POSITIVE', 'confidence': 0.9498250484466553, 'speaker': 'A'}, {'text': "So when we talk about affectivity, we're not just talking about full blooded emotions or even just moods, but we're talking about what?", 'start': 3097688, 'end': 3106934, 'sentiment': 'NEUTRAL', 'confidence': 0.6752986311912537, 'speaker': 'A'}, {'text': "One of the things I kind of drew attention to in the lecture was Matthew Ratcliffe's work on existential feelings, which I think is just such the connection between active inference and phenomenology that you find in some of this work is just insanely powerful.", 'start': 3107052, 'end': 3121142, 'sentiment': 'POSITIVE', 'confidence': 0.904721736907959, 'speaker': 'A'}, {'text': "And it's one of the things that really drew me into the framework the second thing, just building one thing that I don't think I mentioned in the lecture is active inference.", 'start': 3121206, 'end': 3133626, 'sentiment': 'NEUTRAL', 'confidence': 0.5259090065956116, 'speaker': 'A'}, {'text': 'It has been described as a quintessentially metacognitive framework.', 'start': 3133738, 'end': 3138190, 'sentiment': 'NEUTRAL', 'confidence': 0.8678843975067139, 'speaker': 'A'}, {'text': 'So you have kind of built into the architecture, you have expectations over expect, so you have kind of predictions about predictions and this has proved to be just, again, just phenomenally useful for thinking about certain aspects of phenomenology as well.', 'start': 3138350, 'end': 3154534, 'sentiment': 'POSITIVE', 'confidence': 0.6510085463523865, 'speaker': 'A'}, {'text': 'So yeah, I think that these are like real strengths of the framework.', 'start': 3154572, 'end': 3159590, 'sentiment': 'POSITIVE', 'confidence': 0.6231132745742798, 'speaker': 'A'}, {'text': "Okay, I don't know how we're doing for time.", 'start': 3165140, 'end': 3171600, 'sentiment': 'NEGATIVE', 'confidence': 0.7790949940681458, 'speaker': 'A'}, {'text': 'Are we strictly limited on or can.', 'start': 3171750, 'end': 3174256, 'sentiment': 'NEUTRAL', 'confidence': 0.8177191019058228, 'speaker': 'A'}, {'text': 'We we are not as far as I know.', 'start': 3174278, 'end': 3177190, 'sentiment': 'NEUTRAL', 'confidence': 0.6374264359474182, 'speaker': 'H'}, {'text': 'Daniel.', 'start': 3177800, 'end': 3178980, 'sentiment': 'NEUTRAL', 'confidence': 0.6503534317016602, 'speaker': 'H'}, {'text': 'Well, I can probably do I definitely do another 15 if anybody has any more questions.', 'start': 3181480, 'end': 3187270, 'sentiment': 'POSITIVE', 'confidence': 0.708082914352417, 'speaker': 'A'}, {'text': "And people, I should say as well, that doesn't mean that we're all held captive to my time frame.", 'start': 3187640, 'end': 3193284, 'sentiment': 'NEUTRAL', 'confidence': 0.6785396337509155, 'speaker': 'A'}, {'text': "So if people do need to leave within the next five or ten minutes, that's absolutely fine, but I'm certainly happy to carry on if anybody has any more questions or comments.", 'start': 3193332, 'end': 3202620, 'sentiment': 'POSITIVE', 'confidence': 0.6133822798728943, 'speaker': 'A'}, {'text': "If no one else has got any, I would quite like to go back to earlier in the discussion you were talking about the value of uncertainty because in organizations in which I'm working with, we often have conversations about uncertainty and what we find is over time there tends to be a drift towards risk aversion.", 'start': 3207060, 'end': 3229796, 'sentiment': 'NEUTRAL', 'confidence': 0.713940441608429, 'speaker': 'G'}, {'text': "So we're working with a large international construction company at the Minute, and they used to have a culture in which innovation was quite well embedded.", 'start': 3229908, 'end': 3242312, 'sentiment': 'POSITIVE', 'confidence': 0.8002852201461792, 'speaker': 'G'}, {'text': "And over time, it's kind of drifted towards very, very risk averse culture where actually, rather than learning through the process and being able to tolerate uncertainty around opportunities and what can be accomplished and that kind of surveillance that comes with the intrinsic reward, I suppose, of being able to reduce uncertainty about capabilities to a situation where they're trying to anticipate all of the risks upfront before they even get involved in the project.", 'start': 3242376, 'end': 3270900, 'sentiment': 'NEUTRAL', 'confidence': 0.592409610748291, 'speaker': 'G'}, {'text': "So there's some kind of valence switch.", 'start': 3270970, 'end': 3273616, 'sentiment': 'NEUTRAL', 'confidence': 0.8405737280845642, 'speaker': 'G'}, {'text': 'Mark and you mentioned David Blaine earlier and something about the context there was a switch in valence from yeah, this is a kind of a play, this is a safe thing to do, to actually know this has real consequences.', 'start': 3273728, 'end': 3289184, 'sentiment': 'NEUTRAL', 'confidence': 0.7321596741676331, 'speaker': 'G'}, {'text': "So I'd like to explore that a little bit more actually, if anyone's got kind of any insights or papers or comments.", 'start': 3289332, 'end': 3297100, 'sentiment': 'NEUTRAL', 'confidence': 0.7945700287818909, 'speaker': 'G'}, {'text': "Yeah, I think that's a really interesting question, actually.", 'start': 3300000, 'end': 3303090, 'sentiment': 'POSITIVE', 'confidence': 0.9398671984672546, 'speaker': 'A'}, {'text': "It seems like one of the things we've been talking about is this connection between uncertainty, prediction, error, minimization and affectivity in individual agents.", 'start': 3304900, 'end': 3317380, 'sentiment': 'NEUTRAL', 'confidence': 0.7093769311904907, 'speaker': 'A'}, {'text': "And it sounds like what you're asking is how does that translate to collectives?", 'start': 3317450, 'end': 3324576, 'sentiment': 'NEUTRAL', 'confidence': 0.7753053903579712, 'speaker': 'A'}, {'text': "So one of the things about active inference that we're going to see in subsequent weeks is how it scales up to kind of larger systems like companies or groups that are trying to achieve some kind of shared goal.", 'start': 3324688, 'end': 3338360, 'sentiment': 'NEUTRAL', 'confidence': 0.7526708245277405, 'speaker': 'A'}, {'text': 'How does the value of uncertainty translate onto how is it scalable in that sense?', 'start': 3339820, 'end': 3344764, 'sentiment': 'NEUTRAL', 'confidence': 0.8213671445846558, 'speaker': 'A'}, {'text': 'Right?', 'start': 3344802, 'end': 3345390, 'sentiment': 'NEUTRAL', 'confidence': 0.7360090017318726, 'speaker': 'A'}, {'text': 'Would that be a fair kind of.', 'start': 3345760, 'end': 3347470, 'sentiment': 'NEUTRAL', 'confidence': 0.7050967216491699, 'speaker': 'A'}, {'text': 'Yeah, I guess so.', 'start': 3348640, 'end': 3350430, 'sentiment': 'NEUTRAL', 'confidence': 0.6842135787010193, 'speaker': 'G'}, {'text': "Uncertainty often when it's talked about uncertainty is talked about as risk, which is, I suppose, is predictions or anticipation of outcomes that we don't want.", 'start': 3355940, 'end': 3366388, 'sentiment': 'NEGATIVE', 'confidence': 0.5850920677185059, 'speaker': 'G'}, {'text': 'Right.', 'start': 3366474, 'end': 3366916, 'sentiment': 'NEUTRAL', 'confidence': 0.5664746165275574, 'speaker': 'D'}, {'text': "Whereas there's also positive uncertainty, which is, I suppose, simply stated opportunities through curiosity.", 'start': 3367018, 'end': 3375824, 'sentiment': 'NEUTRAL', 'confidence': 0.5164853930473328, 'speaker': 'G'}, {'text': "What might we be able to achieve this kind of novelty seeking, I guess that new opportunities that we haven't exploited, and they're just in the kind of organizational systems.", 'start': 3375952, 'end': 3388600, 'sentiment': 'NEUTRAL', 'confidence': 0.7047962546348572, 'speaker': 'G'}, {'text': 'I think there are various pressures that cause it, but over time, you see these cultural shifts towards a very kind of risk averse where the valence is obviously quite negative, quite an unpleasant feeling for people.', 'start': 3389500, 'end': 3405570, 'sentiment': 'NEGATIVE', 'confidence': 0.9054365754127502, 'speaker': 'G'}, {'text': 'Yeah, this is good.', 'start': 3407780, 'end': 3408928, 'sentiment': 'POSITIVE', 'confidence': 0.9812131524085999, 'speaker': 'B'}, {'text': 'This is right at the heart of my current work.', 'start': 3409014, 'end': 3411090, 'sentiment': 'POSITIVE', 'confidence': 0.6434900164604187, 'speaker': 'B'}, {'text': "I'm really interested.", 'start': 3411620, 'end': 3412608, 'sentiment': 'POSITIVE', 'confidence': 0.9431540966033936, 'speaker': 'B'}, {'text': 'So we just had a big stint where active inference models were starting to be used in computational psychiatry, especially for pathological disorders.', 'start': 3412694, 'end': 3421136, 'sentiment': 'NEUTRAL', 'confidence': 0.7760461568832397, 'speaker': 'B'}, {'text': 'So addiction, depression, disassociative disorders, OCD PTSD.', 'start': 3421248, 'end': 3425780, 'sentiment': 'NEGATIVE', 'confidence': 0.8804796934127808, 'speaker': 'B'}, {'text': "It's quite a sexy framework for thinking about some of the ways that the cognitive system breaks down and the sort of new move right now.", 'start': 3427800, 'end': 3435096, 'sentiment': 'POSITIVE', 'confidence': 0.4961596429347992, 'speaker': 'B'}, {'text': 'I mean, we have a collection coming out right now in Neuroscience of Consciousness.', 'start': 3435118, 'end': 3437860, 'sentiment': 'NEUTRAL', 'confidence': 0.8495831489562988, 'speaker': 'B'}, {'text': 'Is to think about these things in terms of, okay, if we are predictive systems and we have a sufficiently rich model of how that system works in a particular niche, what sorts of ways can we intervene on that system in order to have positive outcomes, rather than just modeling what the negative outcomes are?', 'start': 3437940, 'end': 3456168, 'sentiment': 'NEUTRAL', 'confidence': 0.7339867353439331, 'speaker': 'B'}, {'text': "And I hear that a lot in what you're saying now.", 'start': 3456274, 'end': 3458224, 'sentiment': 'NEUTRAL', 'confidence': 0.6478317975997925, 'speaker': 'B'}, {'text': "So I'm just going to drop one link for you there.", 'start': 3458262, 'end': 3460976, 'sentiment': 'NEUTRAL', 'confidence': 0.8572680354118347, 'speaker': 'B'}, {'text': 'This is Casper Hess again wrote a very small paper with a nice little model called Sophisticated Affective Inference.', 'start': 3461078, 'end': 3467948, 'sentiment': 'POSITIVE', 'confidence': 0.8186506032943726, 'speaker': 'B'}, {'text': "Here's a little bot that tends towards catastrophe catastrophizing the future.", 'start': 3468044, 'end': 3473670, 'sentiment': 'NEGATIVE', 'confidence': 0.5930553078651428, 'speaker': 'B'}, {'text': "If it's given like, fun medium fun medium fun dangerous.", 'start': 3474760, 'end': 3480100, 'sentiment': 'NEUTRAL', 'confidence': 0.48037251830101013, 'speaker': 'B'}, {'text': 'Over time, it tends to expect the dangerous one.', 'start': 3480260, 'end': 3485850, 'sentiment': 'NEUTRAL', 'confidence': 0.5841273069381714, 'speaker': 'B'}, {'text': 'Like after 10,000 iterations, it basically lives in the worst possible scenario, which is a nice little this is my wife, this is most people today.', 'start': 3487100, 'end': 3497260, 'sentiment': 'NEGATIVE', 'confidence': 0.6220903396606445, 'speaker': 'B'}, {'text': 'So the question is, I want to know, given the model, why does that happen and what can we be doing to intervene?', 'start': 3497410, 'end': 3504724, 'sentiment': 'NEUTRAL', 'confidence': 0.7273459434509277, 'speaker': 'B'}, {'text': 'And part of the answer is going to be we need to become more tolerant of uncertainty.', 'start': 3504872, 'end': 3511644, 'sentiment': 'NEUTRAL', 'confidence': 0.7156062722206116, 'speaker': 'B'}, {'text': "That's one of the things that the system can be better or worse at.", 'start': 3511692, 'end': 3514384, 'sentiment': 'NEGATIVE', 'confidence': 0.4650222957134247, 'speaker': 'B'}, {'text': 'So this just takes the computational modeling and then looks to things that we already know about emotional regulation.', 'start': 3514502, 'end': 3520020, 'sentiment': 'NEUTRAL', 'confidence': 0.8203279376029968, 'speaker': 'B'}, {'text': "That's part of the story.", 'start': 3520760, 'end': 3522310, 'sentiment': 'NEUTRAL', 'confidence': 0.7621719837188721, 'speaker': 'B'}, {'text': "So we've done a little bit of work on this with our predictive dynamics of happiness and wellbeing, and Ryan Smith is definitely doing work on this with active inference and well being.", 'start': 3523480, 'end': 3533336, 'sentiment': 'POSITIVE', 'confidence': 0.8314940333366394, 'speaker': 'B'}, {'text': "So definitely check that out if you're interested here.", 'start': 3533518, 'end': 3536810, 'sentiment': 'POSITIVE', 'confidence': 0.737133264541626, 'speaker': 'B'}, {'text': "I'll just flag one interesting thing here that relates just to what we were just talking about, about layers of modeling.", 'start': 3538540, 'end': 3544860, 'sentiment': 'POSITIVE', 'confidence': 0.794136643409729, 'speaker': 'B'}, {'text': "One way that let's say two ways.", 'start': 3545600, 'end': 3548316, 'sentiment': 'NEUTRAL', 'confidence': 0.7774780988693237, 'speaker': 'B'}, {'text': "There's two ways that a system, and it's probably going to be lots.", 'start': 3548418, 'end': 3550776, 'sentiment': 'NEUTRAL', 'confidence': 0.7087785005569458, 'speaker': 'B'}, {'text': 'But the two that come to mind that a system can become more tolerant to uncertainty is one exposure.', 'start': 3550808, 'end': 3556988, 'sentiment': 'NEUTRAL', 'confidence': 0.5977464914321899, 'speaker': 'B'}, {'text': 'So this is why exposure therapy might be useful for our kind of a system.', 'start': 3557164, 'end': 3561440, 'sentiment': 'POSITIVE', 'confidence': 0.583760142326355, 'speaker': 'B'}, {'text': 'You want to expose the system to volatility at the lower and middle levels of the hierarchy and have it turn out okay.', 'start': 3561590, 'end': 3569268, 'sentiment': 'NEUTRAL', 'confidence': 0.7310594916343689, 'speaker': 'B'}, {'text': 'So that one of the things that the system can come to predict is not only particular outcomes, but it can also predict how much error is involved in particular outcomes.', 'start': 3569434, 'end': 3579588, 'sentiment': 'NEUTRAL', 'confidence': 0.591011643409729, 'speaker': 'B'}, {'text': "So, for instance, when I used to give a pro talk, I was always really nervous, and I don't know if that ever really went away, but I've had so much exposure to the anxiety of giving a professional talk that basically I don't notice it anymore.", 'start': 3579684, 'end': 3595256, 'sentiment': 'NEGATIVE', 'confidence': 0.6622477173805237, 'speaker': 'B'}, {'text': "But if you were to ask me at the beginning of my talk, mark right now, what's your phenomenology?", 'start': 3595288, 'end': 3600488, 'sentiment': 'NEUTRAL', 'confidence': 0.9221961498260498, 'speaker': 'B'}, {'text': "And I sort of meditatively looked, I'd probably say, yeah, I'm nervous.", 'start': 3600664, 'end': 3604536, 'sentiment': 'NEUTRAL', 'confidence': 0.5021248459815979, 'speaker': 'B'}, {'text': "But if you hadn't have said that and you were just like, hey, what's up?", 'start': 3604648, 'end': 3607052, 'sentiment': 'NEUTRAL', 'confidence': 0.7378330230712891, 'speaker': 'B'}, {'text': "I've been like, oh yeah, I'm great.", 'start': 3607106, 'end': 3608720, 'sentiment': 'POSITIVE', 'confidence': 0.8923346400260925, 'speaker': 'B'}, {'text': "It's all good.", 'start': 3608870, 'end': 3609424, 'sentiment': 'POSITIVE', 'confidence': 0.8811412453651428, 'speaker': 'B'}, {'text': "I don't even notice it anymore.", 'start': 3609462, 'end': 3610588, 'sentiment': 'NEUTRAL', 'confidence': 0.45399346947669983, 'speaker': 'B'}, {'text': "That's because the system knows that I have errors go up, but as soon as I start talking, they drop away.", 'start': 3610684, 'end': 3617828, 'sentiment': 'NEGATIVE', 'confidence': 0.7101297974586487, 'speaker': 'B'}, {'text': 'And because I know the arc that even error in the system, it becomes non newsworthy.', 'start': 3617914, 'end': 3622256, 'sentiment': 'NEGATIVE', 'confidence': 0.773970901966095, 'speaker': 'B'}, {'text': "It's no longer interesting volatility to be tracking that's just from exposure.", 'start': 3622288, 'end': 3626288, 'sentiment': 'NEGATIVE', 'confidence': 0.8752816915512085, 'speaker': 'B'}, {'text': "So what's happening is you're having errors at a lower or middle level that a higher level is now modeling, saying when we come here, we should expect this arc of error.", 'start': 3626464, 'end': 3634596, 'sentiment': 'NEGATIVE', 'confidence': 0.5591006278991699, 'speaker': 'B'}, {'text': 'Same thing when you work out like real gym rats, they can feel good.', 'start': 3634628, 'end': 3639370, 'sentiment': 'POSITIVE', 'confidence': 0.7376617193222046, 'speaker': 'B'}, {'text': "You're having your system right, but at the higher level, it's now learned not only that that has a natural arc, but that that's a good sign at a higher level.", 'start': 3642400, 'end': 3655360, 'sentiment': 'POSITIVE', 'confidence': 0.8951185345649719, 'speaker': 'B'}, {'text': "So now you're getting positive prediction error slope high and negative prediction error slope low.", 'start': 3655430, 'end': 3662976, 'sentiment': 'NEUTRAL', 'confidence': 0.5589913725852966, 'speaker': 'B'}, {'text': 'Okay, so one exposure.', 'start': 3663158, 'end': 3666160, 'sentiment': 'NEUTRAL', 'confidence': 0.6796293258666992, 'speaker': 'B'}, {'text': 'Two, you can model your own responses.', 'start': 3666320, 'end': 3669840, 'sentiment': 'NEUTRAL', 'confidence': 0.8074010014533997, 'speaker': 'B'}, {'text': 'This is something Ben and I work on with horror movies.', 'start': 3669920, 'end': 3672900, 'sentiment': 'NEUTRAL', 'confidence': 0.8086286187171936, 'speaker': 'B'}, {'text': 'You can take an active role in mindfully observing your own reactions to volatility.', 'start': 3675800, 'end': 3682900, 'sentiment': 'NEUTRAL', 'confidence': 0.8062405586242676, 'speaker': 'B'}, {'text': 'And this comes up in our paper on horror.', 'start': 3683060, 'end': 3685956, 'sentiment': 'NEUTRAL', 'confidence': 0.5256770253181458, 'speaker': 'B'}, {'text': "We've already dropped the link today if you want to check it out.", 'start': 3685988, 'end': 3688120, 'sentiment': 'NEUTRAL', 'confidence': 0.8568071126937866, 'speaker': 'B'}, {'text': 'Something really special happens when the system models its own reaction to volatility.', 'start': 3688190, 'end': 3692232, 'sentiment': 'NEUTRAL', 'confidence': 0.49598944187164307, 'speaker': 'B'}, {'text': "It starts to learn that even reactions to volatility, they don't need to be compounded up into dangers, that it's okay to be uncertain at certain levels of the system.", 'start': 3692376, 'end': 3703536, 'sentiment': 'NEUTRAL', 'confidence': 0.6638034582138062, 'speaker': 'B'}, {'text': "So how that translates into business, I'm not sure, other than I know tolerance to uncertainty is a marker of business success.", 'start': 3703718, 'end': 3711650, 'sentiment': 'NEUTRAL', 'confidence': 0.7992717623710632, 'speaker': 'B'}, {'text': 'And I suspect the framework in a fit with lots of mindfulness work about learning to tolerate uncertainty.', 'start': 3712180, 'end': 3722100, 'sentiment': 'NEUTRAL', 'confidence': 0.7777010202407837, 'speaker': 'B'}, {'text': 'Is there anything about the role of language in kind of modulating those metacognitive?', 'start': 3722440, 'end': 3728932, 'sentiment': 'NEUTRAL', 'confidence': 0.8980385661125183, 'speaker': 'G'}, {'text': "Oh, it's good.", 'start': 3729076, 'end': 3730024, 'sentiment': 'POSITIVE', 'confidence': 0.9699504971504211, 'speaker': 'B'}, {'text': 'If I may, I was preparing an answer on that specifically, and I was nervously waiting for opportunity.', 'start': 3730142, 'end': 3736170, 'sentiment': 'NEUTRAL', 'confidence': 0.7149224281311035, 'speaker': 'H'}, {'text': 'Sorry, Mark.', 'start': 3736540, 'end': 3737530, 'sentiment': 'NEGATIVE', 'confidence': 0.49048712849617004, 'speaker': 'A'}, {'text': "Meta in terms of evolutionary cognitive archaeology, we don't know when language emerge, but we do know that, let's say an encouraging semantic system.", 'start': 3742400, 'end': 3753708, 'sentiment': 'NEUTRAL', 'confidence': 0.8105926513671875, 'speaker': 'H'}, {'text': 'So you can build things in language, and you can expect things in the world to correspond to things in language.', 'start': 3753794, 'end': 3760400, 'sentiment': 'NEUTRAL', 'confidence': 0.7605483531951904, 'speaker': 'H'}, {'text': "So, for example, if you that's abstract, as I say, it's abstract, but you can, for example, have a self identity, and I'm a French, and I communicate with the expectation that are embedded in that identity with other people.", 'start': 3760820, 'end': 3775924, 'sentiment': 'NEUTRAL', 'confidence': 0.8307419419288635, 'speaker': 'H'}, {'text': 'And that means we communicate over norms.', 'start': 3776042, 'end': 3777844, 'sentiment': 'NEUTRAL', 'confidence': 0.8154623508453369, 'speaker': 'H'}, {'text': 'So we have specific expectation of what we will do.', 'start': 3777892, 'end': 3781656, 'sentiment': 'NEUTRAL', 'confidence': 0.8266622424125671, 'speaker': 'H'}, {'text': 'And those expectations, they become embedded in specific symbolic markers that are embedded in language.', 'start': 3781838, 'end': 3788280, 'sentiment': 'NEUTRAL', 'confidence': 0.7700647711753845, 'speaker': 'H'}, {'text': 'And something that the thing that it was strongly evoked in my mind when you talked of tolerance to insecurity is that as far as documented history goes, Europeans well, Indo Europeans, they are pretty strong on the idea that things have a nature and they act lawfully.', 'start': 3788960, 'end': 3814240, 'sentiment': 'NEUTRAL', 'confidence': 0.689990758895874, 'speaker': 'H'}, {'text': 'And their nature and their laws, they somehow correspond to linguistic categories.', 'start': 3814680, 'end': 3819760, 'sentiment': 'NEUTRAL', 'confidence': 0.8577017784118652, 'speaker': 'H'}, {'text': "So I can say stuff like chickens quack, and that's a proper explanation of what are chicken and why they quack.", 'start': 3819920, 'end': 3829240, 'sentiment': 'NEUTRAL', 'confidence': 0.5899402499198914, 'speaker': 'H'}, {'text': 'And if you look in Chinese philosophy, as far as written history goes, you have a much accent on Wei Wu Wei.', 'start': 3829980, 'end': 3839536, 'sentiment': 'NEUTRAL', 'confidence': 0.8434748649597168, 'speaker': 'H'}, {'text': 'So a poor translation would be effortless action.', 'start': 3839588, 'end': 3845100, 'sentiment': 'NEUTRAL', 'confidence': 0.4831344783306122, 'speaker': 'H'}, {'text': 'Closer translation would be action without action.', 'start': 3846400, 'end': 3850296, 'sentiment': 'NEUTRAL', 'confidence': 0.68232661485672, 'speaker': 'H'}, {'text': "So it's something that is quite close to the phenomenology of flow in that you observe yourself doing things and you do not apply a conscious effort to the flow of what you're doing.", 'start': 3850488, 'end': 3864790, 'sentiment': 'NEUTRAL', 'confidence': 0.7955174446105957, 'speaker': 'H'}, {'text': "And that looks like something that is closer to the phenomenology you'd expect.", 'start': 3865560, 'end': 3871332, 'sentiment': 'NEUTRAL', 'confidence': 0.7189223170280457, 'speaker': 'H'}, {'text': "If you apply recursive preactive cognition with less or less heavy or more effectively integrated symbolic concurring like use of language as something that you actually expect to be meaningful and to constrain strongly your actions and marginally, I'd expect, very strongly expect that linguistic categories will map and what you build with it.", 'start': 3871386, 'end': 3898156, 'sentiment': 'NEUTRAL', 'confidence': 0.6927765607833862, 'speaker': 'H'}, {'text': "So, I don't know, self identities, plans, whatever will map cleanly onto what you observe.", 'start': 3898178, 'end': 3903420, 'sentiment': 'NEUTRAL', 'confidence': 0.7957977056503296, 'speaker': 'H'}, {'text': 'You will be very anxious about things, because that does not happen usually.', 'start': 3903500, 'end': 3907570, 'sentiment': 'NEGATIVE', 'confidence': 0.5811535716056824, 'speaker': 'H'}, {'text': 'And yeah, besides grand discourse on interpret traits, which are usually not that constructive sorry, I got lost because I did.', 'start': 3910020, 'end': 3924676, 'sentiment': 'NEGATIVE', 'confidence': 0.6367630362510681, 'speaker': 'H'}, {'text': 'Not let me just say one thing before we move off this point.', 'start': 3924698, 'end': 3930330, 'sentiment': 'NEUTRAL', 'confidence': 0.7503963112831116, 'speaker': 'B'}, {'text': 'A simple way that language might help is by invoking cognitive flexibility.', 'start': 3931340, 'end': 3935396, 'sentiment': 'POSITIVE', 'confidence': 0.5712705254554749, 'speaker': 'B'}, {'text': 'So oftentimes we think about the management of error being either updating predictions or acting on the world.', 'start': 3935508, 'end': 3942844, 'sentiment': 'NEUTRAL', 'confidence': 0.7898938655853271, 'speaker': 'B'}, {'text': "That's the dyad.", 'start': 3943042, 'end': 3944072, 'sentiment': 'NEUTRAL', 'confidence': 0.5807886719703674, 'speaker': 'B'}, {'text': 'Usually what it overlooks is the third one, which is we can also manage volatility by redeploying precision in a better way.', 'start': 3944136, 'end': 3951868, 'sentiment': 'NEUTRAL', 'confidence': 0.6737999320030212, 'speaker': 'B'}, {'text': "So rather than just updating your model to fit the world or updating the world to fit your model, you can just change the set of what matters so that you're not really updating the model and you're not really changing the world.", 'start': 3952034, 'end': 3963264, 'sentiment': 'NEUTRAL', 'confidence': 0.6072816252708435, 'speaker': 'B'}, {'text': "You're just changing the problem landscape.", 'start': 3963302, 'end': 3965308, 'sentiment': 'NEGATIVE', 'confidence': 0.4784952700138092, 'speaker': 'B'}, {'text': "And that's something language allows us to do.", 'start': 3965404, 'end': 3967620, 'sentiment': 'NEUTRAL', 'confidence': 0.6570049524307251, 'speaker': 'B'}, {'text': "It's maybe one of the really amazing things that language allows us to do is we can use language to bootstrap that kind of precision adjustment.", 'start': 3967690, 'end': 3976832, 'sentiment': 'POSITIVE', 'confidence': 0.9515309929847717, 'speaker': 'B'}, {'text': "So if the train doesn't come on time, we both notice it.", 'start': 3976896, 'end': 3980744, 'sentiment': 'NEUTRAL', 'confidence': 0.4971621632575989, 'speaker': 'B'}, {'text': 'Okay.', 'start': 3980782, 'end': 3980984, 'sentiment': 'NEUTRAL', 'confidence': 0.584351658821106, 'speaker': 'B'}, {'text': "And we feel bad that's perceptual updating.", 'start': 3981022, 'end': 3983492, 'sentiment': 'NEGATIVE', 'confidence': 0.8416550159454346, 'speaker': 'B'}, {'text': "We might go and get a taxi that's active updating.", 'start': 3983636, 'end': 3987044, 'sentiment': 'NEUTRAL', 'confidence': 0.8259223103523254, 'speaker': 'B'}, {'text': "But I might just say to you, wow, look, isn't it lovely that now we get a little bit more time to read our book or to continue our conversation or let's finish our coffee with a little bit of ease.", 'start': 3987172, 'end': 3996776, 'sentiment': 'POSITIVE', 'confidence': 0.9511275291442871, 'speaker': 'B'}, {'text': 'I mean, we get an extra 20 minutes.', 'start': 3996808, 'end': 3998060, 'sentiment': 'NEUTRAL', 'confidence': 0.805943489074707, 'speaker': 'B'}, {'text': 'Now even just saying that redeploys precision over the problem.', 'start': 3998130, 'end': 4002012, 'sentiment': 'NEUTRAL', 'confidence': 0.6206493973731995, 'speaker': 'B'}, {'text': "Space now the train being late isn't volatility in the system.", 'start': 4002066, 'end': 4006690, 'sentiment': 'NEGATIVE', 'confidence': 0.583540141582489, 'speaker': 'B'}, {'text': 'The train being late is signaling to the system that a better than expected slope has been achieved.', 'start': 4007220, 'end': 4011836, 'sentiment': 'NEUTRAL', 'confidence': 0.6024191975593567, 'speaker': 'B'}, {'text': "Isn't that so interesting?", 'start': 4012028, 'end': 4013136, 'sentiment': 'POSITIVE', 'confidence': 0.9271600842475891, 'speaker': 'B'}, {'text': "The exact same occurrence is either undigestible volatility, right, like you're going to be late.", 'start': 4013238, 'end': 4018896, 'sentiment': 'NEGATIVE', 'confidence': 0.6818840503692627, 'speaker': 'B'}, {'text': 'Oh my goodness.', 'start': 4018928, 'end': 4019600, 'sentiment': 'NEUTRAL', 'confidence': 0.45354869961738586, 'speaker': 'B'}, {'text': "Or it's an opportunity for an improvement in the system, which is now you get more time with the person that you're taking the train with.", 'start': 4019680, 'end': 4026676, 'sentiment': 'POSITIVE', 'confidence': 0.662220299243927, 'speaker': 'B'}, {'text': 'And that was just a matter of linguistic perturbance of the way that precision is being looking at.', 'start': 4026778, 'end': 4034552, 'sentiment': 'NEUTRAL', 'confidence': 0.8396866917610168, 'speaker': 'B'}, {'text': 'If you wanted to dig into the research here, I would look up cognitive flexibility and language or coaching cognitive flexibility is such a good point here.', 'start': 4034606, 'end': 4042750, 'sentiment': 'POSITIVE', 'confidence': 0.8591461181640625, 'speaker': 'B'}, {'text': 'So you have a paper by Nick Clark on this specific encouraging role of language.', 'start': 4045520, 'end': 4050952, 'sentiment': 'NEUTRAL', 'confidence': 0.7452872395515442, 'speaker': 'H'}, {'text': 'And something it entails is that basically you get like if the active infrastructure is correct, you flexibly predict a flow in the interoceptive proprioceptive exteriorceptive.', 'start': 4051016, 'end': 4062876, 'sentiment': 'NEUTRAL', 'confidence': 0.8344263434410095, 'speaker': 'H'}, {'text': 'Is that even a thing space?', 'start': 4062908, 'end': 4064864, 'sentiment': 'NEUTRAL', 'confidence': 0.7047873139381409, 'speaker': 'H'}, {'text': 'And that is what builds an integrated experience and integrated cognition and language.', 'start': 4065062, 'end': 4071344, 'sentiment': 'POSITIVE', 'confidence': 0.7542603611946106, 'speaker': 'H'}, {'text': 'It adds another layer of complexity.', 'start': 4071392, 'end': 4073024, 'sentiment': 'NEUTRAL', 'confidence': 0.4853915274143219, 'speaker': 'H'}, {'text': 'If you can just talk to yourself in your head, that is another dimension that you can predict and that can be coherent or incoherent with your world.', 'start': 4073072, 'end': 4081016, 'sentiment': 'NEUTRAL', 'confidence': 0.7618725895881653, 'speaker': 'H'}, {'text': 'And so that is an extremely powerful encouraging system because I just have to tell a plan to myself and boom, that pushes me, nudges me nicely throughout the plan.', 'start': 4081198, 'end': 4091228, 'sentiment': 'POSITIVE', 'confidence': 0.9622061848640442, 'speaker': 'H'}, {'text': 'But then you can have a different level of meta expectation over how language corresponds to reality.', 'start': 4091314, 'end': 4097144, 'sentiment': 'NEUTRAL', 'confidence': 0.7049145102500916, 'speaker': 'H'}, {'text': "And I'd say a very strong factor of aversion to uncertainty is whether you expect your plans or your linguistic structure to nicely map onto reality because it will not happen.", 'start': 4097192, 'end': 4109664, 'sentiment': 'NEGATIVE', 'confidence': 0.7161980271339417, 'speaker': 'H'}, {'text': 'But if you expect strongly that it will be the case, you will have to make it happen somehow.', 'start': 4109782, 'end': 4115036, 'sentiment': 'NEUTRAL', 'confidence': 0.7116177082061768, 'speaker': 'H'}, {'text': 'And here you will adapt rigid strategies and you will lose flexibility, but also language necessary for flexibility to be the case in the first place.', 'start': 4115148, 'end': 4124292, 'sentiment': 'NEUTRAL', 'confidence': 0.5419605374336243, 'speaker': 'H'}, {'text': "So it's about coupling between dimension of cognition.", 'start': 4124346, 'end': 4127960, 'sentiment': 'NEUTRAL', 'confidence': 0.8536527156829834, 'speaker': 'H'}, {'text': 'Yeah.', 'start': 4130540, 'end': 4130856, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'A'}, {'text': "And I would just kind of risk and danger are two things that I've been really interested in across a kind of variety of different contexts.", 'start': 4130878, 'end': 4141256, 'sentiment': 'POSITIVE', 'confidence': 0.5419866442680359, 'speaker': 'A'}, {'text': 'And I would say some of the.', 'start': 4141288, 'end': 4145548, 'sentiment': 'NEUTRAL', 'confidence': 0.7722464203834534, 'speaker': 'A'}, {'text': "Things that have been said like how you can influence the system by externalizing things through language and the different strategies that systems, whatever scale they're on, have minimizing prediction error, minimizing free energy.", 'start': 4145554, 'end': 4161152, 'sentiment': 'NEUTRAL', 'confidence': 0.8267934322357178, 'speaker': 'A'}, {'text': 'But also I would just emphasize the importance of external context here as well.', 'start': 4161286, 'end': 4165344, 'sentiment': 'NEUTRAL', 'confidence': 0.7855534553527832, 'speaker': 'A'}, {'text': 'So even in the case of a collective like a business, you still have to take into account the environment in which the business is operating.', 'start': 4165382, 'end': 4172432, 'sentiment': 'NEUTRAL', 'confidence': 0.820580244064331, 'speaker': 'A'}, {'text': "And I've been really interested in a particularly extreme example of context.", 'start': 4172496, 'end': 4177100, 'sentiment': 'POSITIVE', 'confidence': 0.6718517541885376, 'speaker': 'A'}, {'text': "I used to still do some work in philosophy of sport and I've been really interested in dangerous sports and why there seems to be this insane contextual effect where within a very kind of narrow contextual band of sporting practice, people seem willing to take on risks that outside of that context would just be completely insane.", 'start': 4177280, 'end': 4199020, 'sentiment': 'NEUTRAL', 'confidence': 0.45118826627731323, 'speaker': 'A'}, {'text': "And I think this is something that's probably going to come up again in subsequent weeks as well here when we talk about the way that expectations on an individual or a collective basis can be set through other minds.", 'start': 4199680, 'end': 4215620, 'sentiment': 'NEUTRAL', 'confidence': 0.8489065766334534, 'speaker': 'A'}, {'text': 'So what somebody else expect myself to do?', 'start': 4219400, 'end': 4223012, 'sentiment': 'NEUTRAL', 'confidence': 0.6575909852981567, 'speaker': 'A'}, {'text': 'And so on and so on.', 'start': 4223146, 'end': 4224710, 'sentiment': 'NEUTRAL', 'confidence': 0.7275934219360352, 'speaker': 'A'}, {'text': "Darius, you've had your hand up a while.", 'start': 4226120, 'end': 4227780, 'sentiment': 'NEUTRAL', 'confidence': 0.7404229044914246, 'speaker': 'A'}, {'text': 'Do you want to jump in?', 'start': 4227850, 'end': 4229112, 'sentiment': 'NEUTRAL', 'confidence': 0.8640403151512146, 'speaker': 'A'}, {'text': 'Yes, please.', 'start': 4229246, 'end': 4229960, 'sentiment': 'POSITIVE', 'confidence': 0.6413175463676453, 'speaker': 'D'}, {'text': "I'm not sure this is the sort of grand synthesis of any of this, but flow was mentioned.", 'start': 4230030, 'end': 4236760, 'sentiment': 'NEUTRAL', 'confidence': 0.7860957980155945, 'speaker': 'D'}, {'text': "As I said, it's a kind of pet topic of mine and something that.", 'start': 4236830, 'end': 4243596, 'sentiment': 'NEUTRAL', 'confidence': 0.77805095911026, 'speaker': 'D'}, {'text': 'We know about flow.', 'start': 4243618, 'end': 4245192, 'sentiment': 'NEUTRAL', 'confidence': 0.7645770311355591, 'speaker': 'A'}, {'text': "And this is why it's integrated into this idea of language and agency, is that at least in its original conception, success, mahali, and the sort of qualitative experience associated with flow, you would find stuff like not only the dilation of time, but also the reduction in self consciousness.", 'start': 4245256, 'end': 4262268, 'sentiment': 'NEUTRAL', 'confidence': 0.7997458577156067, 'speaker': 'D'}, {'text': 'And now this is sort of picking up a lot of work that happens at UCL and people like Jeremy Skipper how integrated language is into the sense of self.', 'start': 4262444, 'end': 4271188, 'sentiment': 'NEUTRAL', 'confidence': 0.6302734017372131, 'speaker': 'D'}, {'text': "And it seems to me, and this is kind of shooting from the hip, that all of these very deep rooted, I guess they're kind of psychotechnologies the self language seem to dissipate at this goldilocks zone, at this point of at this edge of criticality, at this flow state.", 'start': 4271354, 'end': 4290510, 'sentiment': 'NEUTRAL', 'confidence': 0.6252543926239014, 'speaker': 'D'}, {'text': 'Which makes me think if the flow state is a phenomenological offshoot of being optimally reducing prediction error, what is the kind of role of the concept of the self or linguistic functions?', 'start': 4291040, 'end': 4307068, 'sentiment': 'NEUTRAL', 'confidence': 0.7933658957481384, 'speaker': 'D'}, {'text': 'Because it seems to me that that becomes a regulatory function when that optimality is reduced, when stuff starts going wrong.', 'start': 4307244, 'end': 4313250, 'sentiment': 'NEGATIVE', 'confidence': 0.8730373978614807, 'speaker': 'D'}, {'text': "So I think you can also think about this in the kind of Heideggerian or draythe's sense of just opening a door.", 'start': 4313940, 'end': 4319408, 'sentiment': 'NEUTRAL', 'confidence': 0.862295389175415, 'speaker': 'D'}, {'text': 'You only start to represent the door in yourself.', 'start': 4319504, 'end': 4321988, 'sentiment': 'NEUTRAL', 'confidence': 0.7949738502502441, 'speaker': 'D'}, {'text': "You only give it the linguistic object of a door when you can't open it.", 'start': 4322154, 'end': 4326740, 'sentiment': 'NEGATIVE', 'confidence': 0.5971009731292725, 'speaker': 'D'}, {'text': 'When you open a door standard, there is no representation going there.', 'start': 4326810, 'end': 4330884, 'sentiment': 'NEUTRAL', 'confidence': 0.5004258155822754, 'speaker': 'D'}, {'text': "I mean, you could even argue there's no qualia there.", 'start': 4330922, 'end': 4332952, 'sentiment': 'NEUTRAL', 'confidence': 0.794069230556488, 'speaker': 'D'}, {'text': "So I'm wondering how deep that runs and what we can say about the role of agency, selfhood, maybe even consciousness because they don't seem to be that prevalent, at least from my understanding.", 'start': 4333006, 'end': 4346328, 'sentiment': 'NEUTRAL', 'confidence': 0.741199791431427, 'speaker': 'D'}, {'text': 'When we are at the edge of criticality.', 'start': 4346504, 'end': 4348700, 'sentiment': 'NEUTRAL', 'confidence': 0.7823001742362976, 'speaker': 'D'}, {'text': "The suggestion you're making there is it sounds like what you're saying that these things you call them psychotenologies, which I really like.", 'start': 4349360, 'end': 4357390, 'sentiment': 'POSITIVE', 'confidence': 0.7411468029022217, 'speaker': 'A'}, {'text': 'Like language, like certain aspects of self modeling.', 'start': 4357760, 'end': 4362604, 'sentiment': 'NEUTRAL', 'confidence': 0.8050870895385742, 'speaker': 'A'}, {'text': "They are a kind of scaffolding or like a ladder that you then kind of gets kicked away once you reach a certain kind of edge of criticality, like where the performance becomes I don't know what you're performing at such a level that you just don't need those scaffolding.", 'start': 4362652, 'end': 4381480, 'sentiment': 'NEGATIVE', 'confidence': 0.6101651191711426, 'speaker': 'A'}, {'text': 'Yeah.', 'start': 4382060, 'end': 4382664, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'D'}, {'text': "Or the self regulatory mechanisms that we harness when we're not in flow are linguistic or agentic in essence.", 'start': 4382782, 'end': 4393800, 'sentiment': 'NEUTRAL', 'confidence': 0.8046905994415283, 'speaker': 'D'}, {'text': "And you don't need that when you're at this edge of criticality.", 'start': 4393880, 'end': 4401340, 'sentiment': 'NEUTRAL', 'confidence': 0.5503488779067993, 'speaker': 'D'}, {'text': "And I only postulate that because I'm only thinking, how deep does that go?", 'start': 4402820, 'end': 4410944, 'sentiment': 'NEUTRAL', 'confidence': 0.6856203675270081, 'speaker': 'D'}, {'text': 'Because I know, obviously the active inference framework is trying to tackle in some ways the hard problem as well.', 'start': 4411142, 'end': 4416868, 'sentiment': 'NEUTRAL', 'confidence': 0.7428699135780334, 'speaker': 'D'}, {'text': "And there are some flotations of the idea, at least within the flow community, about the kind of I don't want to say elimination, but the moderation, the modulation of qualia under flow states.", 'start': 4417034, 'end': 4431496, 'sentiment': 'NEUTRAL', 'confidence': 0.8733471035957336, 'speaker': 'D'}, {'text': "So could we also consider that to be a construct which happens when we're not necessarily optimally producing prediction error, a couple of things.", 'start': 4431678, 'end': 4445708, 'sentiment': 'NEUTRAL', 'confidence': 0.5300044417381287, 'speaker': 'D'}, {'text': "So I'm certainly not the person to stop talking about consciousness, so I won't.", 'start': 4445794, 'end': 4451348, 'sentiment': 'NEUTRAL', 'confidence': 0.609370768070221, 'speaker': 'A'}, {'text': 'But some of the readings that I mentioned in the lecture might be interesting for you on this topic.', 'start': 4451544, 'end': 4459292, 'sentiment': 'POSITIVE', 'confidence': 0.8700606822967529, 'speaker': 'A'}, {'text': "So if we're talking about certain structures that seem very pervasive in our phenomenology and how those structures can sometimes kind of dissolve away and how that might be accounted for under an active inference framework, there's some really interesting work on psychedelics by George Dean and some of George Dean's co conspirators.", 'start': 4459356, 'end': 4486628, 'sentiment': 'POSITIVE', 'confidence': 0.878084123134613, 'speaker': 'A'}, {'text': "I know Mark and Sam Wilkinson worked on a paper with George so George Dean's done some work on kind of ego dissolution and certain kinds of experiences related to selfhood, kind of and I kind of don't want to overstep the mark, but I think they fall generally under this kind of rebus model of psychedelic efficacy.", 'start': 4486724, 'end': 4509004, 'sentiment': 'NEUTRAL', 'confidence': 0.8496295809745789, 'speaker': 'A'}, {'text': "So I don't know if people are familiar with this, but this kind of finds natural articulation through predictive processing and hierarchical self modeling and that kind of stuff.", 'start': 4509052, 'end': 4517200, 'sentiment': 'NEUTRAL', 'confidence': 0.8399950265884399, 'speaker': 'A'}, {'text': 'I also wanted to really quickly flag on this topic.', 'start': 4517270, 'end': 4520124, 'sentiment': 'NEUTRAL', 'confidence': 0.7638478875160217, 'speaker': 'A'}, {'text': "I'll find the paper and I'll put it up on the coder because I don't think I'll be able to find it quickly enough now.", 'start': 4520252, 'end': 4525284, 'sentiment': 'NEUTRAL', 'confidence': 0.4653216302394867, 'speaker': 'A'}, {'text': 'But there was a paper that came out very recently that showed the efficacy of internal self talk on sports performance.', 'start': 4525322, 'end': 4535400, 'sentiment': 'POSITIVE', 'confidence': 0.5183573961257935, 'speaker': 'A'}, {'text': 'They did an experiment with cyclists and they found that when cyclists were allowed to engage in kind of constant self talk with them, like an inner monologue in their head, their performance at cycling was measurably boosted, which I thought was really interesting and kind of relevant here.', 'start': 4537660, 'end': 4555984, 'sentiment': 'POSITIVE', 'confidence': 0.9458064436912537, 'speaker': 'A'}, {'text': "But it's interesting because it sounds like it might prima facia be in tension with what we were saying about flow states as well.", 'start': 4556102, 'end': 4567716, 'sentiment': 'NEUTRAL', 'confidence': 0.6111497282981873, 'speaker': 'A'}, {'text': 'Right.', 'start': 4567738, 'end': 4567924, 'sentiment': 'NEUTRAL', 'confidence': 0.5664746165275574, 'speaker': 'A'}, {'text': 'So if the real edge of performance is a place where these structures of phenomenology bleed away, it kind of calls into question, like, to what extent are these psychotechnologies effective and in what way are they effective?', 'start': 4567962, 'end': 4582680, 'sentiment': 'NEUTRAL', 'confidence': 0.634498655796051, 'speaker': 'A'}, {'text': "There's just a whole kind of universe of really interesting questions there.", 'start': 4583740, 'end': 4587690, 'sentiment': 'POSITIVE', 'confidence': 0.9220317602157593, 'speaker': 'A'}, {'text': 'So, if I may, self food, indirectly will be the central topic of the last two sessions.', 'start': 4588380, 'end': 4594620, 'sentiment': 'NEUTRAL', 'confidence': 0.9232745170593262, 'speaker': 'H'}, {'text': 'My position about it is that self food, in a sense, we use all of the time, is a quite high level construct that emerges from the ability we have to compare our activity to a socially embedded model of our activity.', 'start': 4595520, 'end': 4614344, 'sentiment': 'NEUTRAL', 'confidence': 0.8558453917503357, 'speaker': 'H'}, {'text': 'So that is something that is quite specific to humans because of their linguistic ability and or because of their tendency to what Thomaslo calls shared intentionality.', 'start': 4614492, 'end': 4626352, 'sentiment': 'NEUTRAL', 'confidence': 0.8789768815040588, 'speaker': 'H'}, {'text': 'So the ability to collectively define an.', 'start': 4626416, 'end': 4628970, 'sentiment': 'NEUTRAL', 'confidence': 0.8521925806999207, 'speaker': 'H'}, {'text': 'So basically, this is something that enables a very deep, very profound and robust transmission of cultural knowledge and transmission of norms.', 'start': 4631180, 'end': 4641368, 'sentiment': 'POSITIVE', 'confidence': 0.7420675754547119, 'speaker': 'H'}, {'text': 'This is what enables the construction of norms.', 'start': 4641464, 'end': 4643980, 'sentiment': 'NEUTRAL', 'confidence': 0.7292647361755371, 'speaker': 'H'}, {'text': "But it's quite heavy cognitively and it is predictable that if you're busy comparing what you do to what an idealized version of yourself is doing, you're going to invest less creative energy in actually doing the thing that you would if you just did a thing.", 'start': 4645360, 'end': 4662784, 'sentiment': 'NEGATIVE', 'confidence': 0.660419225692749, 'speaker': 'H'}, {'text': "So I'd say you have a pretty direct entailment of this flow thing from this model.", 'start': 4662982, 'end': 4670870, 'sentiment': 'NEUTRAL', 'confidence': 0.8760159015655518, 'speaker': 'H'}, {'text': 'Yeah.', 'start': 4675720, 'end': 4676228, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'A'}, {'text': 'Yes.', 'start': 4676314, 'end': 4676708, 'sentiment': 'POSITIVE', 'confidence': 0.46103888750076294, 'speaker': 'H'}, {'text': 'This is my conclusion.', 'start': 4676794, 'end': 4677744, 'sentiment': 'NEUTRAL', 'confidence': 0.8370274305343628, 'speaker': 'H'}, {'text': 'Sorry.', 'start': 4677792, 'end': 4678390, 'sentiment': 'NEGATIVE', 'confidence': 0.509212851524353, 'speaker': 'A'}, {'text': "So we've run almost 30 minutes over time and I know Mark's had to go and I'm going to have to go very I think I pretty much have to go.", 'start': 4680120, 'end': 4688024, 'sentiment': 'NEUTRAL', 'confidence': 0.6108999848365784, 'speaker': 'A'}, {'text': 'So I just wondered if anybody has any final kind of quick questions or comments, maybe we can move towards wrapping it up.', 'start': 4688062, 'end': 4695710, 'sentiment': 'NEUTRAL', 'confidence': 0.8975116610527039, 'speaker': 'A'}, {'text': "I'll make a few comments, but Ben, you're welcome to leave and other people welcome to stay if they would like.", 'start': 4698560, 'end': 4706130, 'sentiment': 'NEUTRAL', 'confidence': 0.5101945400238037, 'speaker': 'C'}, {'text': 'Thank you for.', 'start': 4707700, 'end': 4708770, 'sentiment': 'POSITIVE', 'confidence': 0.8983839750289917, 'speaker': 'A'}, {'text': 'Well, first, just on a logistical note, there was a little bit of lag.', 'start': 4712180, 'end': 4717856, 'sentiment': 'NEGATIVE', 'confidence': 0.607023298740387, 'speaker': 'C'}, {'text': "So I'll encourage everyone who's listening, as well as who's participating, that we eventually plan to, as with all of our live streams, develop a transcript which will be curated and published, and eventually not so far away in the future, that'll be enabled with speech modeling to generate podcast quality audio.", 'start': 4717968, 'end': 4736724, 'sentiment': 'POSITIVE', 'confidence': 0.8889966607093811, 'speaker': 'C'}, {'text': 'So the future will be smooth, we promise.', 'start': 4736852, 'end': 4739560, 'sentiment': 'POSITIVE', 'confidence': 0.8938248753547668, 'speaker': 'C'}, {'text': 'But a few really interesting pieces that I picked out while I was embodying and listening.', 'start': 4740380, 'end': 4748040, 'sentiment': 'POSITIVE', 'confidence': 0.9591444134712219, 'speaker': 'C'}, {'text': "So, Regina, you opened the discussion with surprise and creativity, and indeed, it sounds like it's going to be attention.", 'start': 4749420, 'end': 4758028, 'sentiment': 'POSITIVE', 'confidence': 0.8201000094413757, 'speaker': 'C'}, {'text': 'How can a framework whose imperative is bounded surprise as opposed to, say, maximized reward?', 'start': 4758124, 'end': 4764220, 'sentiment': 'NEUTRAL', 'confidence': 0.6687021255493164, 'speaker': 'C'}, {'text': 'How can a framework whose imperative is surprise, minimization and bounding be used to generate novelty?', 'start': 4764380, 'end': 4770704, 'sentiment': 'NEUTRAL', 'confidence': 0.7169616222381592, 'speaker': 'C'}, {'text': 'And I felt like people provided a lot of really cool answers.', 'start': 4770752, 'end': 4774224, 'sentiment': 'POSITIVE', 'confidence': 0.9556100964546204, 'speaker': 'C'}, {'text': "And one other thing it reminds me of is Doug Hofstadter's notion of spectishnish.", 'start': 4774352, 'end': 4781884, 'sentiment': 'NEUTRAL', 'confidence': 0.8342289328575134, 'speaker': 'C'}, {'text': "I don't know, how do you pronounce it, but sphexishness, and it's the specs wasp.", 'start': 4781952, 'end': 4788692, 'sentiment': 'NEUTRAL', 'confidence': 0.6633186936378479, 'speaker': 'C'}, {'text': "And so he says, well, forget this whole creativity thing, because when we talk about creativity, it's like some sort of pantheon, like divine status.", 'start': 4788836, 'end': 4798392, 'sentiment': 'NEUTRAL', 'confidence': 0.6121279001235962, 'speaker': 'C'}, {'text': 'The muses have to be called in.', 'start': 4798456, 'end': 4801116, 'sentiment': 'NEUTRAL', 'confidence': 0.7814856767654419, 'speaker': 'C'}, {'text': "And so then, oh, that's not real creativity, and this isn't real creativity.", 'start': 4801218, 'end': 4804540, 'sentiment': 'NEGATIVE', 'confidence': 0.8075814247131348, 'speaker': 'C'}, {'text': "So instead, he says, well, let's just focus on what would be the opposite.", 'start': 4804620, 'end': 4808108, 'sentiment': 'NEGATIVE', 'confidence': 0.5264297723770142, 'speaker': 'C'}, {'text': "And that would be the rote procedural following, even when there's an opportunity for what we would call creativity.", 'start': 4808284, 'end': 4815660, 'sentiment': 'NEUTRAL', 'confidence': 0.7044073343276978, 'speaker': 'C'}, {'text': "And then there's a continuum.", 'start': 4815820, 'end': 4817048, 'sentiment': 'NEUTRAL', 'confidence': 0.721049427986145, 'speaker': 'C'}, {'text': 'So why does somebody paint that painting?', 'start': 4817084, 'end': 4819056, 'sentiment': 'NEGATIVE', 'confidence': 0.5061601400375366, 'speaker': 'C'}, {'text': "Well, why didn't they invent a new genre?", 'start': 4819168, 'end': 4821328, 'sentiment': 'NEUTRAL', 'confidence': 0.5114824771881104, 'speaker': 'C'}, {'text': "Well, why didn't they invent a new media?", 'start': 4821424, 'end': 4823668, 'sentiment': 'NEGATIVE', 'confidence': 0.49595871567726135, 'speaker': 'C'}, {'text': 'And so all activity is existing within this continuum of creativeness, which has many features such as generativity and productivity, but also novelty, but abounded novelty.', 'start': 4823834, 'end': 4839204, 'sentiment': 'POSITIVE', 'confidence': 0.5134572982788086, 'speaker': 'C'}, {'text': "It's not creative to knock the chessboard pieces off in a way that there might be an elegant chess move who only somebody in a certain cognitive setting could detect the aesthetics of.", 'start': 4839252, 'end': 4851824, 'sentiment': 'NEUTRAL', 'confidence': 0.472333699464798, 'speaker': 'C'}, {'text': 'But I think that was awesome.', 'start': 4851862, 'end': 4853330, 'sentiment': 'POSITIVE', 'confidence': 0.9737138152122498, 'speaker': 'C'}, {'text': "And then the second piece that really was powerful was what mark's train.", 'start': 4854100, 'end': 4862370, 'sentiment': 'POSITIVE', 'confidence': 0.6355745792388916, 'speaker': 'C'}, {'text': "I guess the trains don't run on time where Mark is, but that's okay, because he was able to, rather than treat that as an undigestible surprise, that was able to be basically cognitively metabolized into an opportunity for friendship through language as a social medium.", 'start': 4862900, 'end': 4883000, 'sentiment': 'NEUTRAL', 'confidence': 0.5212627649307251, 'speaker': 'C'}, {'text': 'And then he connected that to cognitive flexibility and coaching.', 'start': 4883500, 'end': 4888340, 'sentiment': 'NEUTRAL', 'confidence': 0.8030664920806885, 'speaker': 'C'}, {'text': 'And then I thought about self talk and our inner monologue inner voice.', 'start': 4888500, 'end': 4894140, 'sentiment': 'NEUTRAL', 'confidence': 0.8591057062149048, 'speaker': 'C'}, {'text': "And then Darius, that was very provocative, that we aren't having self talk, potentially not even having a self in the flow, manifold experience of the self or the self talk, or again, potentially even the total actual self as a technology.", 'start': 4894800, 'end': 4913730, 'sentiment': 'NEUTRAL', 'confidence': 0.5867578387260437, 'speaker': 'C'}, {'text': 'And so then healthy self talk would guide us to the flow and be kind of like a self limiting technology because it would be used in order to not be needed to be used, which is kind of how we would hope adaptive technologies would be versus a maladaptive technology would be something that entrenches its own utilization potentially at the expense of the functionality.', 'start': 4914120, 'end': 4947576, 'sentiment': 'NEUTRAL', 'confidence': 0.5192226767539978, 'speaker': 'C'}, {'text': 'Kind of like doom scrolling status.', 'start': 4947768, 'end': 4949992, 'sentiment': 'NEUTRAL', 'confidence': 0.7179575562477112, 'speaker': 'C'}, {'text': "But that's internal rumination.", 'start': 4950136, 'end': 4951864, 'sentiment': 'NEUTRAL', 'confidence': 0.7138368487358093, 'speaker': 'C'}, {'text': 'And those are the kinds of things that people have simulated in active inference.', 'start': 4951912, 'end': 4955360, 'sentiment': 'NEUTRAL', 'confidence': 0.5541167855262756, 'speaker': 'C'}, {'text': 'So those were some really cool pieces.', 'start': 4955700, 'end': 4958412, 'sentiment': 'POSITIVE', 'confidence': 0.9669694304466248, 'speaker': 'C'}, {'text': 'That was a great discussion.', 'start': 4958476, 'end': 4960000, 'sentiment': 'POSITIVE', 'confidence': 0.9658024907112122, 'speaker': 'C'}, {'text': 'Could I just add something on the topic of creativity that I should have said earlier as well?', 'start': 4961060, 'end': 4967284, 'sentiment': 'NEUTRAL', 'confidence': 0.8830983638763428, 'speaker': 'A'}, {'text': "Because I think it's really relevant to Regina's question and just the topic of creative and novel behaviors in general under active inference.", 'start': 4967322, 'end': 4975024, 'sentiment': 'POSITIVE', 'confidence': 0.6428972482681274, 'speaker': 'A'}, {'text': "I think that whenever we talk about especially artistic creativity, there's a tendency, even for people who are kind of very well burrowed into active inference and activism and these kinds of frameworks from cognitive science, I think there's a tendency to think of creativity as still like it's almost like the last bastion of internal cognitiveist thinking.", 'start': 4975072, 'end': 5000876, 'sentiment': 'NEUTRAL', 'confidence': 0.752882182598114, 'speaker': 'A'}, {'text': 'We think creativity is something that happens in here and bursts outwards.', 'start': 5001058, 'end': 5004780, 'sentiment': 'NEUTRAL', 'confidence': 0.6155133247375488, 'speaker': 'A'}, {'text': "And so how does that happen with this kind of whatever cognitive architecture we're positing?", 'start': 5004860, 'end': 5010300, 'sentiment': 'NEUTRAL', 'confidence': 0.686672031879425, 'speaker': 'A'}, {'text': "But there's really very cool work by I have to give a shout out to Mike Wheeler, who has written some papers on the extended mind and creativity.", 'start': 5010460, 'end': 5020064, 'sentiment': 'POSITIVE', 'confidence': 0.9842286109924316, 'speaker': 'A'}, {'text': "And one thing that's not really come up very much that I didn't get time to talk about in the lecture is this really nice natural marriage between the extended mind and active inference, something that Andy Clark has been working on.", 'start': 5020192, 'end': 5031896, 'sentiment': 'POSITIVE', 'confidence': 0.6889199614524841, 'speaker': 'A'}, {'text': "And I know he's going to be doing a lot more work on it.", 'start': 5031918, 'end': 5035016, 'sentiment': 'NEUTRAL', 'confidence': 0.7151265740394592, 'speaker': 'A'}, {'text': 'But the claim Wheeler makes and some others I think Joanna Zelenska has written a little bit about this as well, is the fact that creativity itself is just as subject to kind of material, the sculpting effects of material environments and sociocultural environments as everything else is.', 'start': 5035038, 'end': 5055680, 'sentiment': 'NEUTRAL', 'confidence': 0.8552495837211609, 'speaker': 'A'}, {'text': 'So creativity is not this kind of romantic with a capital R kind of internal process that kind of bursts forth, but creative thinking is just as much extended and embedded as everything else.', 'start': 5055830, 'end': 5069204, 'sentiment': 'NEUTRAL', 'confidence': 0.7411553859710693, 'speaker': 'A'}, {'text': "And there's some really great examples in Mike Wheeler's essay.", 'start': 5069242, 'end': 5073940, 'sentiment': 'POSITIVE', 'confidence': 0.9618576765060425, 'speaker': 'A'}, {'text': "I don't know, is anybody familiar with the band Alt J?", 'start': 5074280, 'end': 5077190, 'sentiment': 'NEUTRAL', 'confidence': 0.8425531983375549, 'speaker': 'A'}, {'text': "They're a British band.", 'start': 5077640, 'end': 5079116, 'sentiment': 'NEUTRAL', 'confidence': 0.8286452889442444, 'speaker': 'A'}, {'text': 'They were kind of really big a few years ago.', 'start': 5079168, 'end': 5081080, 'sentiment': 'POSITIVE', 'confidence': 0.6658831238746643, 'speaker': 'A'}, {'text': 'They won the Mercury Music Award because they have a super original sound.', 'start': 5081150, 'end': 5085130, 'sentiment': 'POSITIVE', 'confidence': 0.963958203792572, 'speaker': 'A'}, {'text': 'So AltJ have this really quiet tinkling.', 'start': 5085900, 'end': 5089320, 'sentiment': 'NEUTRAL', 'confidence': 0.8448431491851807, 'speaker': 'A'}, {'text': 'Yeah, they are a great band.', 'start': 5089740, 'end': 5090868, 'sentiment': 'POSITIVE', 'confidence': 0.9753783941268921, 'speaker': 'A'}, {'text': "They're one of my favorites.", 'start': 5090884, 'end': 5091876, 'sentiment': 'POSITIVE', 'confidence': 0.9784144163131714, 'speaker': 'A'}, {'text': 'And they have this really quiet tinky sound that everybody kind of assumed was just the result of some kind of internal genius on the part of the band.', 'start': 5091908, 'end': 5101340, 'sentiment': 'NEUTRAL', 'confidence': 0.5827736258506775, 'speaker': 'A'}, {'text': 'And as it turns out, AltJ, originally they tried to rehearse as an indie rock band, but they were confined to rehearsing in an apartment block, and they kept getting noise complaints.', 'start': 5101840, 'end': 5114460, 'sentiment': 'NEGATIVE', 'confidence': 0.624242901802063, 'speaker': 'A'}, {'text': "And so they ended up developing this quiet tinkly sound because it was the only sound they could rehearse that wouldn't get them kicked out of their apartment.", 'start': 5114620, 'end': 5123200, 'sentiment': 'NEUTRAL', 'confidence': 0.6756986975669861, 'speaker': 'A'}, {'text': 'And I think this is a really beautiful example of how even the most creative processes that seem, on the face of it, really creative, are in fact just a subject to these external kind of this kind of agent environment system that underpins the whole framework.', 'start': 5123360, 'end': 5139024, 'sentiment': 'POSITIVE', 'confidence': 0.9266257882118225, 'speaker': 'A'}, {'text': "So that's something that's going to apply to absolutely everything.", 'start': 5139092, 'end': 5142750, 'sentiment': 'NEUTRAL', 'confidence': 0.7329691648483276, 'speaker': 'A'}, {'text': 'Awesome.', 'start': 5144000, 'end': 5144748, 'sentiment': 'POSITIVE', 'confidence': 0.918424665927887, 'speaker': 'C'}, {'text': "And just the last question, people are welcome to drop off the next section that we're heading into.", 'start': 5144914, 'end': 5152896, 'sentiment': 'POSITIVE', 'confidence': 0.668083131313324, 'speaker': 'C'}, {'text': "I'll be doing the lecture that's going to be in August, and it's going to be on collective behavior.", 'start': 5152998, 'end': 5158988, 'sentiment': 'NEUTRAL', 'confidence': 0.8386939167976379, 'speaker': 'C'}, {'text': 'So what would people like to learn or focus on about collective behavior?', 'start': 5159084, 'end': 5167220, 'sentiment': 'NEUTRAL', 'confidence': 0.905264675617218, 'speaker': 'C'}, {'text': "Anyone who hasn't spoken or it can just be a thought question, but I haven't prepared the slides at all, so I'm happy to take suggestions.", 'start': 5177640, 'end': 5189320, 'sentiment': 'NEUTRAL', 'confidence': 0.4782073497772217, 'speaker': 'C'}, {'text': 'Yeah, Darius and then anyone else?', 'start': 5192620, 'end': 5194590, 'sentiment': 'NEUTRAL', 'confidence': 0.8245015144348145, 'speaker': 'C'}, {'text': "I think what might be interesting is if we're saying that these systems are all in the business of reducing prediction error, of self evidencing.", 'start': 5194960, 'end': 5203260, 'sentiment': 'NEUTRAL', 'confidence': 0.5028728246688843, 'speaker': 'D'}, {'text': 'Why do we see a diversity why do we see a diversity of social cultures, of norms, of standards at a global scale?', 'start': 5203760, 'end': 5217080, 'sentiment': 'NEUTRAL', 'confidence': 0.6152309775352478, 'speaker': 'D'}, {'text': 'Why do we not just see some homogeneous way to reduce picture there, which would manifest as the kind of singular culture which is in the kind of business of self evidencing?', 'start': 5217260, 'end': 5232372, 'sentiment': 'NEUTRAL', 'confidence': 0.6631340980529785, 'speaker': 'D'}, {'text': 'That just kind of popped in my mind.', 'start': 5232516, 'end': 5234250, 'sentiment': 'NEUTRAL', 'confidence': 0.7262774109840393, 'speaker': 'D'}, {'text': 'Cool.', 'start': 5236060, 'end': 5236810, 'sentiment': 'POSITIVE', 'confidence': 0.84200119972229, 'speaker': 'A'}, {'text': 'Anyone else want to give a thought on collective behavior or on any other aspect?', 'start': 5241920, 'end': 5246024, 'sentiment': 'NEUTRAL', 'confidence': 0.9017841219902039, 'speaker': 'C'}, {'text': "Otherwise it's been great.", 'start': 5246152, 'end': 5247710, 'sentiment': 'POSITIVE', 'confidence': 0.8976056575775146, 'speaker': 'C'}, {'text': "I'd like to make a comment of creativity, but does anyone like at the moment, if you want to make a comment on the next session, I want to put that.", 'start': 5248320, 'end': 5261330, 'sentiment': 'NEUTRAL', 'confidence': 0.8623712062835693, 'speaker': 'H'}, {'text': 'Okay, go for it.', 'start': 5262900, 'end': 5264290, 'sentiment': 'POSITIVE', 'confidence': 0.5060662031173706, 'speaker': 'I'}, {'text': "I'd say that to complement what Ben said, that creativity is intrinsically very hard to model because by definition, creativity is something that brings about something new, let us say.", 'start': 5265460, 'end': 5280890, 'sentiment': 'NEUTRAL', 'confidence': 0.6064929366111755, 'speaker': 'H'}, {'text': 'And the mathematics we have to describe physics and life, they are not very good at new things.', 'start': 5281340, 'end': 5288410, 'sentiment': 'NEGATIVE', 'confidence': 0.7568326592445374, 'speaker': 'H'}, {'text': 'Because the most basic tool you have, the basic way to represent a system that literally everyone uses, is a stead space, which is the least of all possibilities of a system.', 'start': 5289340, 'end': 5305070, 'sentiment': 'NEUTRAL', 'confidence': 0.6061879992485046, 'speaker': 'H'}, {'text': "If you say something is creative, you're likely to think that it means it can bring about new possibilities.", 'start': 5305440, 'end': 5311404, 'sentiment': 'POSITIVE', 'confidence': 0.7291901707649231, 'speaker': 'H'}, {'text': 'And this intuition, it conflicts directly with the very basic use of math.', 'start': 5311532, 'end': 5316824, 'sentiment': 'NEGATIVE', 'confidence': 0.8336054086685181, 'speaker': 'H'}, {'text': 'Describe it.', 'start': 5316972, 'end': 5317924, 'sentiment': 'NEUTRAL', 'confidence': 0.7205078601837158, 'speaker': 'H'}, {'text': 'So it is basically the same issues I was referring to earlier when I talked about the comparison between active inference and an activist.', 'start': 5318042, 'end': 5326960, 'sentiment': 'NEUTRAL', 'confidence': 0.6885234117507935, 'speaker': 'H'}, {'text': "So let's say activity biology inspired model of cognition, and a core concept historically in those circles is autopoiesis.", 'start': 5327120, 'end': 5337364, 'sentiment': 'NEUTRAL', 'confidence': 0.8948488831520081, 'speaker': 'H'}, {'text': 'So the ability of the living to self create, literally, this is Greek for self creation.', 'start': 5337412, 'end': 5342940, 'sentiment': 'NEUTRAL', 'confidence': 0.812836229801178, 'speaker': 'H'}, {'text': 'And you had a lot of drift and conceptualization and ambiguities that were resolved or not resolved and led to the crisis of framework, blah, blah, blah.', 'start': 5343360, 'end': 5353096, 'sentiment': 'NEGATIVE', 'confidence': 0.7710438966751099, 'speaker': 'H'}, {'text': 'But today we talk of autonomy rather than autopoiesis.', 'start': 5353208, 'end': 5357476, 'sentiment': 'NEUTRAL', 'confidence': 0.7041847109794617, 'speaker': 'H'}, {'text': 'And we define autonomy as the property for a system of constraints over the activity of a system to reproduce themselves.', 'start': 5357608, 'end': 5367090, 'sentiment': 'NEUTRAL', 'confidence': 0.8677956461906433, 'speaker': 'H'}, {'text': "And because we're talking constraints, just the ability to influence causality outcomes, there is no really a prior that dynamics in this space would be conservative.", 'start': 5367480, 'end': 5379712, 'sentiment': 'NEUTRAL', 'confidence': 0.6882476806640625, 'speaker': 'H'}, {'text': 'So we have a possibility for constraints to bring about new things and reconfigure themselves.', 'start': 5379776, 'end': 5385144, 'sentiment': 'NEUTRAL', 'confidence': 0.7850883603096008, 'speaker': 'H'}, {'text': 'And the notion of Hydrancy ADUs is based on that.', 'start': 5385342, 'end': 5389050, 'sentiment': 'NEUTRAL', 'confidence': 0.8876727819442749, 'speaker': 'H'}, {'text': "It's the ability to, let's say, reconfigure constraints in your environment, and so is the notion of creativity, which would be likely a very close proxy to that.", 'start': 5389500, 'end': 5400028, 'sentiment': 'NEUTRAL', 'confidence': 0.7515552043914795, 'speaker': 'H'}, {'text': "But it's something that we do not know how to present.", 'start': 5400114, 'end': 5404110, 'sentiment': 'NEGATIVE', 'confidence': 0.5422441363334656, 'speaker': 'H'}, {'text': 'And most of the mathematics that exist are structurally enabled, represent.', 'start': 5405220, 'end': 5410316, 'sentiment': 'NEUTRAL', 'confidence': 0.8372746109962463, 'speaker': 'H'}, {'text': "And so, yeah, that's a big one.", 'start': 5410508, 'end': 5413330, 'sentiment': 'POSITIVE', 'confidence': 0.5056536793708801, 'speaker': 'H'}, {'text': 'So true.', 'start': 5417400, 'end': 5418390, 'sentiment': 'POSITIVE', 'confidence': 0.6716039180755615, 'speaker': 'C'}, {'text': 'Michael.', 'start': 5421000, 'end': 5421860, 'sentiment': 'NEUTRAL', 'confidence': 0.6781592965126038, 'speaker': 'A'}, {'text': 'Good to be here.', 'start': 5426600, 'end': 5427396, 'sentiment': 'POSITIVE', 'confidence': 0.9721079468727112, 'speaker': 'I'}, {'text': 'Sorry I was late.', 'start': 5427418, 'end': 5428580, 'sentiment': 'NEGATIVE', 'confidence': 0.7696136832237244, 'speaker': 'I'}, {'text': 'What comes to mind for me at the know, I mentioned units of collective, like, what is it, a we?', 'start': 5429800, 'end': 5435320, 'sentiment': 'NEUTRAL', 'confidence': 0.8785660266876221, 'speaker': 'I'}, {'text': 'Is it a we a pair?', 'start': 5435390, 'end': 5436840, 'sentiment': 'NEUTRAL', 'confidence': 0.8990155458450317, 'speaker': 'I'}, {'text': 'What are the units of we.', 'start': 5439420, 'end': 5440584, 'sentiment': 'NEUTRAL', 'confidence': 0.7769302129745483, 'speaker': 'I'}, {'text': 'And any thoughts or insights about that?', 'start': 5440622, 'end': 5442910, 'sentiment': 'NEUTRAL', 'confidence': 0.8653398752212524, 'speaker': 'I'}, {'text': 'The stages of the emergence of formation into a collective from a me to a we, for example, or god, I had one was on the tip of my tongue, and it just escaped me.', 'start': 5444000, 'end': 5458944, 'sentiment': 'NEUTRAL', 'confidence': 0.6259485483169556, 'speaker': 'I'}, {'text': 'Oh.', 'start': 5459062, 'end': 5459730, 'sentiment': 'NEUTRAL', 'confidence': 0.5443295240402222, 'speaker': 'I'}, {'text': "This idea of precision that I think it was Mark Miller was talking about, or Matt saying at the if there's options in the looking at collective what might be some of the most well understood limiting beliefs about when we use language of collective that keeps us repeating the same blind spots.", 'start': 5460740, 'end': 5495740, 'sentiment': 'NEUTRAL', 'confidence': 0.767669141292572, 'speaker': 'I'}, {'text': 'And how might we think differently about collective so that we escape those predispositions, if you will?', 'start': 5497520, 'end': 5505310, 'sentiment': 'NEUTRAL', 'confidence': 0.8446542620658875, 'speaker': 'I'}, {'text': 'Makes sense.', 'start': 5505760, 'end': 5506770, 'sentiment': 'NEUTRAL', 'confidence': 0.534262478351593, 'speaker': 'I'}, {'text': "They'll do what I can do in.", 'start': 5509700, 'end': 5511824, 'sentiment': 'NEUTRAL', 'confidence': 0.7884845733642578, 'speaker': 'C'}, {'text': "The solo lecture, and I'll look forward.", 'start': 5511862, 'end': 5515392, 'sentiment': 'POSITIVE', 'confidence': 0.9015175104141235, 'speaker': 'I'}, {'text': 'To the conversation where we can unpack.', 'start': 5515526, 'end': 5517884, 'sentiment': 'NEUTRAL', 'confidence': 0.8773220777511597, 'speaker': 'C'}, {'text': 'It.', 'start': 5517932, 'end': 5518530, 'sentiment': 'NEUTRAL', 'confidence': 0.5428685545921326, 'speaker': 'D'}, {'text': 'Exciting.', 'start': 5520260, 'end': 5520812, 'sentiment': 'POSITIVE', 'confidence': 0.9694170355796814, 'speaker': 'I'}, {'text': 'Thank you for doing it.', 'start': 5520876, 'end': 5521664, 'sentiment': 'POSITIVE', 'confidence': 0.9701927900314331, 'speaker': 'I'}, {'text': "I'm looking forward to it.", 'start': 5521702, 'end': 5523376, 'sentiment': 'POSITIVE', 'confidence': 0.9753931164741516, 'speaker': 'I'}, {'text': "Yeah, it's awesome.", 'start': 5523478, 'end': 5524336, 'sentiment': 'POSITIVE', 'confidence': 0.9711287021636963, 'speaker': 'C'}, {'text': 'Nathan or David, you want to add anything?', 'start': 5524438, 'end': 5526690, 'sentiment': 'NEUTRAL', 'confidence': 0.932039201259613, 'speaker': 'C'}, {'text': 'All right, then.', 'start': 5532170, 'end': 5533414, 'sentiment': 'NEUTRAL', 'confidence': 0.5821025967597961, 'speaker': 'C'}, {'text': 'Thank you all.', 'start': 5533452, 'end': 5534150, 'sentiment': 'POSITIVE', 'confidence': 0.9195932745933533, 'speaker': 'C'}, {'text': 'Hope everyone is enjoying the course so far.', 'start': 5534220, 'end': 5536902, 'sentiment': 'POSITIVE', 'confidence': 0.9752427339553833, 'speaker': 'C'}, {'text': 'Thanks, Avel, again for coordinating it.', 'start': 5536956, 'end': 5539414, 'sentiment': 'POSITIVE', 'confidence': 0.9368686079978943, 'speaker': 'C'}, {'text': 'And to Ben for this great section.', 'start': 5539452, 'end': 5542482, 'sentiment': 'POSITIVE', 'confidence': 0.9591468572616577, 'speaker': 'C'}, {'text': 'Now you can put on your student hat again.', 'start': 5542626, 'end': 5545320, 'sentiment': 'NEUTRAL', 'confidence': 0.6470521688461304, 'speaker': 'C'}, {'text': 'And to you for organizing.', 'start': 5546010, 'end': 5547750, 'sentiment': 'NEUTRAL', 'confidence': 0.5114417672157288, 'speaker': 'H'}, {'text': 'Thank you.', 'start': 5548650, 'end': 5549318, 'sentiment': 'POSITIVE', 'confidence': 0.8529649972915649, 'speaker': 'C'}, {'text': 'See you all next time.', 'start': 5549404, 'end': 5550214, 'sentiment': 'NEUTRAL', 'confidence': 0.5591034889221191, 'speaker': 'C'}, {'text': 'Thanks.', 'start': 5550252, 'end': 5550840, 'sentiment': 'POSITIVE', 'confidence': 0.6283750534057617, 'speaker': 'E'}, {'text': 'Bye.', 'start': 5551610, 'end': 5552210, 'sentiment': 'NEUTRAL', 'confidence': 0.5137446522712708, 'speaker': 'B'}, {'text': 'Thank you.', 'start': 5552290, 'end': 5553080, 'sentiment': 'POSITIVE', 'confidence': 0.8529649972915649, 'speaker': 'I'}, {'text': 'Thanks, everyone.', 'start': 5554010, 'end': 5554660, 'sentiment': 'POSITIVE', 'confidence': 0.8315965533256531, 'speaker': 'D'}], 'entity_detection': True, 'entities': [{'entity_type': 'date', 'text': 'July 25, 2023', 'start': 5998, 'end': 7896}, {'entity_type': 'person_name', 'text': 'Ben White', 'start': 23742, 'end': 24424}, {'entity_type': 'person_name', 'text': 'Ben', 'start': 35926, 'end': 36364}, {'entity_type': 'person_name', 'text': 'Darius', 'start': 72214, 'end': 73050}, {'entity_type': 'occupation', 'text': "Master's student", 'start': 74352, 'end': 75002}, {'entity_type': 'organization', 'text': 'UCL', 'start': 75984, 'end': 76810}, {'entity_type': 'occupation', 'text': 'social distributed cognition', 'start': 78352, 'end': 80006}, {'entity_type': 'organization', 'text': 'social cognition lab', 'start': 80784, 'end': 82138}, {'entity_type': 'person_name', 'text': 'Mark', 'start': 105208, 'end': 105394}, {'entity_type': 'occupation', 'text': 'researchers', 'start': 105848, 'end': 106334}, {'entity_type': 'occupation', 'text': 'philosophical', 'start': 110668, 'end': 111378}, {'entity_type': 'person_name', 'text': 'Francisco Balsan', 'start': 127938, 'end': 129022}, {'entity_type': 'occupation', 'text': 'PhD student', 'start': 129488, 'end': 130202}, {'entity_type': 'location', '