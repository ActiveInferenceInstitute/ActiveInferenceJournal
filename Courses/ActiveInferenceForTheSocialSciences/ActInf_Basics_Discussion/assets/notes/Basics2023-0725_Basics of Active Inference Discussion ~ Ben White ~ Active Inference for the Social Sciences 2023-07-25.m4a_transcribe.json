.', 'start': 180672, 'end': 181260, 'confidence': 0.99984, 'speaker': 'A'}]}, {'text': 'Thank you very much.', 'start': 183630, 'end': 185020, 'confidence': 0.99988, 'words': [{'text': 'Thank', 'start': 183630, 'end': 183994, 'confidence': 0.99988, 'speaker': 'A'}, {'text': 'you', 'start': 184032, 'end': 184186, 'confidence': 0.99975, 'speaker': 'A'}, {'text': 'very', 'start': 184208, 'end': 184394, 'confidence': 0.99987, 'speaker': 'A'}, {'text': 'much.', 'start': 184432, 'end': 185020, 'confidence': 0.99949, 'speaker': 'A'}]}, {'text': 'Would anybody else like to introduce themselves before we start?', 'start': 188760, 'end': 191990, 'confidence': 0.99491, 'words': [{'text': 'Would', 'start': 188760, 'end': 189220, 'confidence': 0.99491, 'speaker': 'A'}, {'text': 'anybody', 'start': 189290, 'end': 189572, 'confidence': 0.99989, 'speaker': 'A'}, {'text': 'else', 'start': 189626, 'end': 189892, 'confidence': 0.99986, 'speaker': 'A'}, {'text': 'like', 'start': 189946, 'end': 190116, 'confidence': 0.99996, 'speaker': 'A'}, {'text': 'to', 'start': 190138, 'end': 190276, 'confidence': 1.0, 'speaker': 'A'}, {'text': 'introduce', 'start': 190298, 'end': 190576, 'confidence': 0.98104, 'speaker': 'A'}, {'text': 'themselves', 'start': 190608, 'end': 190900, 'confidence': 0.99996, 'speaker': 'A'}, {'text': 'before', 'start': 190970, 'end': 191156, 'confidence': 0.99957, 'speaker': 'A'}, {'text': 'we', 'start': 191178, 'end': 191364, 'confidence': 0.99935, 'speaker': 'A'}, {'text': 'start?', 'start': 191402, 'end': 191990, 'confidence': 0.52876, 'speaker': 'A'}]}, {'text': "So you go first. Okay. Hi, I'm Regina Sagin. You can call me Gina. I'm from Guatemala.", 'start': 194840, 'end': 202340, 'confidence': 0.48648, 'words': [{'text': 'So', 'start': 194840, 'end': 195252, 'confidence': 0.48648, 'speaker': 'A'}, {'text': 'you', 'start': 195306, 'end': 195476, 'confidence': 0.98443, 'speaker': 'A'}, {'text': 'go', 'start': 195498, 'end': 195684, 'confidence': 0.98, 'speaker': 'A'