', 'start': 1274856, 'end': 1275406, 'confidence': 0.99994, 'speaker': 'F'}]}, {'text': "Why would you like to be in a place where you want to predict but you cannot, and you still want to participate in this activity? So for me, magic shows, it's kind of breaking a little.", 'start': 1275438, 'end': 1287320, 'confidence': 0.99999, 'words': [{'text': 'Why', 'start': 1275438, 'end': 1275586, 'confidence': 0.99999, 'speaker': 'F'}, {'text': 'would', 'start': 1275608, 'end': 1275746, 'confidence': 0.99124, 'speaker': 'F'}, {'text': 'you', 'start': 1275768, 'end': 1275906, 'confidence': 0.99996, 'speaker': 'F'}, {'text': 'like', 'start': 1275928, 'end': 1276066, 'confidence': 0.99878, 'speaker': 'F'}, {'text': 'to', 'start': 1276088, 'end': 1276226, 'confidence': 1.0, 'speaker': 'F'}, {'text': 'be', 'start': 1276248, 'end': 1276338, 'confidence': 0.99999, 'speaker': 'F'}, {'text': 'in', 'start': 1276344, 'end': 1276466, 'confidence': 0.83299, 'speaker': 'F'}, {'text': 'a', 'start': 1276488, 'end': 1276626, 'confidence': 1.0, 'speaker': 'F'}, {'text': 'place', 'start': 1276648, 'end': 1276882, 'confidence': 0.99999, 'speaker': 'F'}, {'text': 'where', 'start': 1276936, 'end': 1277586, 'confidence': 1.0, 'speaker': 'F'}, {'text': 'you', 'start': 1277768, 'end': 1278114, 'confidence': 0.56041, 'speaker': 'F'}, {'text': 'want', 'start': 1278152, 'end': 1278306, 'confidence': 0.99997, 'speaker': 'F'}, {'text': 'to', 'start': 1278328, 'end': 1278466, 'confidence': 1.0, 'speaker': 'F'}, {'text': 'predict', 'start': 1278488, 'end': 1278990, 'confidence': 0.7934, 'speaker': 'F'}, {'text': 'but', 'start': 1279070, 'end': 1279314, 'confidence': 0.83908, 'speaker': 'F'}, {'text': 'you', 'start': 1279352, 'end': 1279506, 'confidence': 0.99996, 'speaker': 'F'}, {'text': 'cannot,', 'start': 1279528, 'end': 1279950, 'confidence': 0.98616, 'speaker': 'F'}, {'text': 'and', 'start': 1280030, 'end': 1280226, 'confidence': 1.0, 'speaker': 'F'}, {'text': 'you', 'start': 1280248, 'end': 128048