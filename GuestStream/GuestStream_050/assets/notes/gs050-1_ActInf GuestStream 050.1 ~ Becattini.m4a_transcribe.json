stemDisorders'}, {'relevance': 0.011016308329999447, 'label': 'FineArt>DigitalArts'}, {'relevance': 0.009407424367964268, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}, {'relevance': 0.004552397411316633, 'label': 'Style&Fashion>BodyArt'}, {'relevance': 0.0041587986052036285, 'label': 'MedicalHealth>MedicalTests'}], 'timestamp': {'start': 5148414, 'end': 5190440}, 'sentences_idx_start': 574, 'sentences_idx_end': 579}, {'text': 'Any of you are welcome back and really appreciate that you all came out. Thank you. Daniel, thank you. See you soon.', 'labels': [{'relevance': 0.22415302693843842, 'label': 'EventsAndAttractions>Concerts&MusicEvents'}, {'relevance': 0.053117915987968445, 'label': 'EventsAndAttractions>FanConventions'}, {'relevance': 0.018601782619953156, 'label': 'EventsAndAttractions>BusinessExpos&Conferences'}, {'relevance': 0.0054629831574857235, 'label': 'EventsAndAttractions>TheaterVenuesAndEvents'}, {'relevance': 0.004382341168820858, 'label': 'PopCulture>CelebrityDeaths'}, {'relevance': 0.003630466526374221, 'label': 'Hobbies&Interests>ContentProduction>FreelanceWriting'}, {'relevance': 0.002353111980482936, 'label': 'Technology&Computing>Computing>ComputerSoftwareAndApplications>WebConferencing'}, {'relevance': 0.0021987997461110353, 'label': 'EventsAndAttractions>PersonalCelebrations&LifeEvents>Prom'}, {'relevance': 0.0016317632980644703, 'label': 'PopCulture>CelebrityStyle'}, {'relevance': 0.0016260335687547922, 'label': 'BooksAndLiterature>Biographies'}], 'timestamp': {'start': 5190590, 'end': 5198870}, 'sentences_idx_start': 580, 'sentences_idx_end': 583}], 'summary': {'Religion&Spirituality>Spirituality': 1.0, 'Religion&Spirituality>Buddhism': 0.48692798614501953, 'Style&Fashion>BodyArt': 0.4141843616962433, 'Hobbies&Interests>ParanormalPhenomena': 0.21323664486408234, 'Religion&Spirituality': 0.17745165526866913, 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth': 0.13782261312007904, 'Technology&Computing>ArtificialIntelligence': 0.13351701200008392, 'MedicalHealth>DiseasesAndConditions>BrainAndNervousSystemDisorders': 0.12512919306755066, 'MedicalHealth>DiseasesAndConditions>SleepDisorders': 0.10629807412624359, 'HealthyLiving>Wellness>AlternativeMedicine': 0.089695505797863, 'MedicalHealth>DiseasesAndConditions>MentalHealth': 0.07290707528591156, 'Technology&Computing>VirtualReality': 0.0675220936536789, 'HealthyLiving>Wellness>PhysicalTherapy': 0.05334477499127388, 'Science': 0.046930257230997086, 'Style&Fashion>Beauty': 0.0424065962433815, 'Religion&Spirituality>Agnosticism': 0.040806837379932404, 'Hobbies&Interests>ContentProduction>FreelanceWriting': 0.04030558094382286, 'FamilyAndRelationships>Bereavement': 0.038711704313755035, 'Science>BiologicalSciences': 0.038524676114320755, 'BooksAndLiterature>Biographies': 0.03563870117068291}}, 'language_detection': False, 'custom_spelling': [{'from': ['fep'], 'to': 'FEP'}, {'from': ['hamiltonian'], 'to': 'Hamiltonian'}, {'from': ['jensen'], 'to': 'Jensen'}, {'from': ['bayesianism'], 'to': 'Bayesianism'}, {'from': ['ness'], 'to': 'NESS'}, {'from': ['occam'], 'to': 'Occam'}, {'from': ['parkinson'], 'to': 'Parkinson'}, {'from': ['peb'], 'to': 'PEB'}, {'from': ['pomdp'], 'to': 'POMDP'}, {'from': ['parkinsonism'], 'to': 'Parkinsonism'}, {'from': ['parkinsonian'], 'to': 'Parkinsonian'}, {'from': ['yaakup', 'jakup'], 'to': 'Jakub'}, {'from': ['yvonne', 'ivan'], 'to': 'Ivan'}, {'from': ['rohan', 'rohan', 'roland'], 'to': 'Rohan'}, {'from': ['ali'], 'to': 'Ali'}, {'from': ['mahault', 'malva', 'mal', 'mao'], 'to': 'Mahault'}, {'from': ['abarasan', 'hasan'], 'to': 'Albarracin'}, {'from': ['saffron'], 'to': 'Safron'}, {'from': ['parr'], 'to': 'Parr'}, {'from': ['beren'], 'to': 'Beren'}, {'from': ['millidge'], 'to': 'Millidge'}, {'from': ['anil'], 'to': 'Anil'}, {'from': ['pease', 'peas'], 'to': 'Pease'}, {'from': ['seth'], 'to': 'Seth'}, {'from': ['verbelen'], 'to': 'Verbelen'}, {'from': ['actinf'], 'to': 'ActInf'}, {'from': ['bayesian'], 'to': 'Bayesian'}, {'from': ['jakub', 'yakub', 'yacub'], 'to': 'Jakub'}, {'from': ['daniel'], 'to': 'Daniel'}, {'from': ['karl', 'carl'], 'to': 'Karl'}, {'from': ['fristen', 'friston'], 'to': 'Friston'}, {'from': ['markov'], 'to': 'Markov'}, {'from': ['ness'], 'to': 'NESS'}, {'from': ['youtube'], 'to': 'YouTube'}, {'from': ['gueststream'], 'to': 'GuestStream'}, {'from': ['livestream'], 'to': 'Livestream'}, {'from': ['mathstream'], 'to': 'MathStream'}, {'from': ['modelstream'], 'to': 'ModelStream'}, {'from': ['orgstream'], 'to': 'OrgStream'}, {'from': ['bleu'], 'to': 'Bleu'}, {'from': ['actinflab', 'activeflab'], 'to': 'ActInfLab'}, {'from': ['google'], 'to': 'Google'}, {'from': ['aristotelian'], 'to': 'Aristotelian'}, {'from': ["i'm"], 'to': "I'm"}, {'from': ["i'll"], 'to': "I'll"}, {'from': ["i've"], 'to': "I've"}, {'from': ['lagrange'], 'to': 'Lagrange'}, {'from': ['lagrangian'], 'to': 'Lagrangian'}], 'throttled': None, 'auto_chapters': True, 'summarization': False, 'summary_type': None, 'summary_model': None, 'custom_topics': False, 'topics': [], 'speech_threshold': None, 'disfluencies': False, 'sentiment_analysis': True, 'chapters': [{'summary': ' guest stream number 15.1 with Valeria Beckhatini and Anna C unica. Presentation on selfless minds, unlimited bodies, homeostatic, bodily self regulation and meditative experiences. There will be a presentation followed by a discussion.', 'gist': 'Selfless Minds', 'headline': 'Presentation by Valeria Beckhatini and Anna C unica', 'start': 4680, 'end': 43208}, {'summary': 'Presenting pathavara wider project. This is a paper about what happened in selfless state from a Homo Sapie bodily self regulation perspective. What exactly is lost when experienced meditators report losing their self and the body?', 'gist': 'What exactly is lost in meditation?', 'headline': 'This is a paper about what happened in selfless state from a bodily self regulation perspective', 'start': 43294, 'end': 152250}, {'summary': 'The concept of the self is so complex and so wide that has been debated since the beginning of philosophy. More recently in cognitive science, we are appealing to a more common definition of sense of self that is defined as a multidimensional construct. This will allow us to draw our conclusions and present ongoing related projects.', 'gist': 'What is the Self in Human Experience?', 'headline': 'The concept of the self has been debated since the beginning of philosophy', 'start': 152940, 'end': 360380}, {'summary': "In deep meditative states there is alterations in the sense of self. It's up to debate which dimension are affected by that. Western philosophy may have problems about the Eastern philosophy. Other problems are cross cultural problems on top of that.", 'gist': 'The sense of self in philosophy', 'headline': 'So many definitions and characterization of the sense of self have come up', 'start': 363280, 'end': 824290}, {'summary': 'We propose a shift in focus in the bodily experience, examining this deep mercy state. In the tradition, our body has a unique status. Our sense of body boundaries is flexible and dynamic. This experience is dependent on how you actually perceive your boundary with you.', 'gist': 'The shift in the focus of meditation', 'headline': 'We propose a shift in focus in the bodily experience to examine meditation', 'start': 825940, 'end': 1094120}, {'summary': 'Predictive processing acting framework considers brains as predictive machine. System can also active sample the world active modify the prediction error or the world in order to fit the prediction errors to the world. This comes into play how attention is analyzed or examined under this framework.', 'gist': 'Predictive Processing', 'headline': 'So here it comes predictive processing acting framework because we want to breach subjective experience', 'start': 1096380, 'end': 1493320}, {'summary': 'The first way is homeostasis which is the maintenance of required optimal state by survival and reproduction of self organizing biological systems. In this we bring into play other two important concepts in active inference which is way to self regulate that underlie all embassy experience.', 'gist': 'Quantum experience and active inference', 'headline': 'Homeostasis is maintenance of required optimal state by survival and reproduction', 'start': 1494780, 'end': 1598200}, {'summary': 'Our proximal sense are central for our minimal sense of self. Different kinds of touch can convey different experience of the sense ofSelf. Medication helps to successfully regulate the body especially in comparison to stress.', 'gist': 'The phenomenology of touch and self-awareness', 'headline': 'Central attenuation plays a role in building multisensory bodily self representations', 'start': 1598940, 'end': 2140820}, {'summary': 'All medicine practices across the tradition require systematic and carefully fully crafted body preparation to enter this deep method selfless state. Our claim is that a transfer essential self and body may underline the phenomenology of losing oneself. We propose a shift in focus on homostatic body self regulation in examining deep meditative states.', 'gist': 'Attenuating the Self and Limiting the Body', 'headline': 'All medicine practices across the tradition require systematic body preparation to enter selfless state', 'start': 2144700, 'end': 2330480}, {'summary': 'We are in the realm of active inference model in meditation research. We will also build our model on self modeling based on the previous literature. Potential benefit may be for cases of people or individual that suffer from disrupted body awareness or disrupted self awareness.', 'gist': 'Projects 6, Active Inference in Meditation', 'headline': 'We are in the realm of active inference model in meditation research', 'start': 2331720, 'end': 2490660}, {'summary': 'Depersonalization is the disruption of both body and self awareness. People with high traits of depression correlate with dimension of the time perspective so they are more future oriented or more negative oriented. Potential title is emotional Body Maps of Thought Detachment, Interpersonalization and Meditation.', 'gist': 'How does depression affect body and mind?', 'headline': 'Depersonalization is disruption of both body and self awareness', 'start': 2491000, 'end': 2866910}, {'summary': 'Danielle: We are doing a project on depersonalization and meditation. Would be nice to get all the traditions of the meditative experiences and how they relate to the body. We also plan to organize something around alteration of self consciousness across various conditions next year.', 'gist': 'Discussion of depersonalization and meditation', 'headline': 'Daniel: We are doing a project on depersonalization and meditation', 'start': 2867680, 'end': 3194770}, {'summary': "Is it possible to reach deep matter states also not sitting in a still position? Can it happen when you don't have prediction of movement? You want to reach through yoga just like the opposite of automatic.", 'gist': 'How to reach deep states while doing yoga', 'headline': 'Anna: I have three questions about meditation and yoga. I think the first one is curious', 'start': 3195540, 'end': 3613944}, {'summary': "Simon suggested to see what type of meditation maybe changed the sense of the self. Does the self is attenuated or not or increasing and kind of goes back to just Simon. Varia it was very interesting and I'm really looking forward to look at the results.", 'gist': 'How meditation affects the sense of self', 'headline': 'Simon suggested to look at how meditation changes sense of self', 'start': 3614142, 'end': 3742610}, {'summary': 'There is evidence that in expert meditators tension starts decreasing. But there is also because you allocate less and less attention. Different type of meditation may develop different type of attention. Not yet, but in the pipeline.', 'gist': 'Is meditation more stressful for meditators?', 'headline': 'There is evidence that in expert meditators tension starts decreasing', 'start': 3745300, 'end': 3959688}, {'summary': "What we really want with Valeria is to push against this idea that you can have selfless experiences. What allows the mind to disappear is the fact that the impure body is kind of like put in a stable condition in such a way that basically you can afford to leave it in the background. Without that in place you can't really afford to go through this selfless experience.", 'gist': 'Self-Love and the Body', 'headline': 'Valeria and other collaborators push against idea that you can have selfless experiences', 'start': 3959774, 'end': 4207380}, {'summary': 'Do you think the attenuation of Somatosensory prediction error concerns more intermediate levels in a way increase meta awareness rather than sheer sensory attention?', 'gist': 'Somatosensory Transparency in Meditation', 'headline': 'Daniel: Do you think Somatosensory prediction error concerns more intermediate levels', 'start': 4207450, 'end': 4822470}, {'summary': 'Anna: The way those deep meditative states are reported sometimes and the way people with depersonalization disorder report their experience is very similar. Next steps would be to create or develop computational model around this.', 'gist': 'Depersonalization disorders and the self', 'headline': "Anna: I'm really interested in how the self is affected by interactions", 'start': 4826220, 'end': 5044280}, {'summary': "There is a lot of potential that can be discovered on this. The body boundaries dissolution is just one part of the phenomenology but it's not the only thing that happens during meditation. Love the idea of the two way street with different bodily and cognitive practices and collaboration and conversation.", 'gist': 'The body in meditation', 'headline': 'Daniel: There is a lot of potential to study bodily reactions to meditation', 'start': 5045740, 'end': 5198870}], 'sentiment_analysis_results': [{'text': 'You.', 'start': 4680, 'end': 5230, 'sentiment': 'NEUTRAL', 'confidence': 0.546256959438324, 'speaker': 'A'}, {'text': 'Hello and welcome.', 'start': 7280, 'end': 8620, 'sentiment': 'POSITIVE', 'confidence': 0.872096598148346, 'speaker': 'B'}, {'text': "It's July 27, 2023, and we're here in Acton, guest stream, number 15.1 with Valeria Beckhatini and Anna C unica.", 'start': 8770, 'end': 19224, 'sentiment': 'NEUTRAL', 'confidence': 0.8781948685646057, 'speaker': 'B'}, {'text': 'This is going to be a very interesting and cool presentation and discussion on selfless minds, unlimited bodies, homeostatic, bodily self regulation and meditative experiences.', 'start': 19352, 'end': 32080, 'sentiment': 'POSITIVE', 'confidence': 0.9741084575653076, 'speaker': 'B'}, {'text': 'There will be a presentation followed by a discussion.', 'start': 32240, 'end': 35584, 'sentiment': 'NEUTRAL', 'confidence': 0.9043112993240356, 'speaker': 'B'}, {'text': 'So thank you both for joining and to you Valeria, for the presentation.', 'start': 35632, 'end': 40420, 'sentiment': 'POSITIVE', 'confidence': 0.9712465405464172, 'speaker': 'B'}, {'text': 'Thank you Diana, very much.', 'start': 41740, 'end': 43208, 'sentiment': 'POSITIVE', 'confidence': 0.959549605846405, 'speaker': 'A'}, {'text': "I'm very happy to be here with Anna.", 'start': 43294, 'end': 45924, 'sentiment': 'POSITIVE', 'confidence': 0.9904927611351013, 'speaker': 'A'}, {'text': 'Presenting pathavara wider project.', 'start': 45972, 'end': 52090, 'sentiment': 'NEUTRAL', 'confidence': 0.8239815831184387, 'speaker': 'A'}, {'text': 'This is a paper about what happened in selfless state from a Homo Sapie bodily self regulation perspective.', 'start': 52540, 'end': 60840, 'sentiment': 'NEUTRAL', 'confidence': 0.9130670428276062, 'speaker': 'A'}, {'text': "So it's as I said, it's part of a wider project that consists in both theoretical and experimental components.", 'start': 61180, 'end': 71040, 'sentiment': 'NEUTRAL', 'confidence': 0.765795886516571, 'speaker': 'A'}, {'text': "Today we're going to look at meditation.", 'start': 74260, 'end': 79600, 'sentiment': 'NEUTRAL', 'confidence': 0.7985150814056396, 'speaker': 'A'}, {'text': 'So for people that are not really familiar with that, meditation is a practice that engaged attention to self regulate physiological and cognitive activity.', 'start': 80440, 'end': 89620, 'sentiment': 'NEUTRAL', 'confidence': 0.8037474751472473, 'speaker': 'A'}, {'text': "What we're interested here is that people that meditate with a certain experience, so for example, meditating in the past two years with regularly, like some hours per week, they consistently report losing one sense of the self or having selfless experiences.", 'start': 90280, 'end': 112140, 'sentiment': 'NEUTRAL', 'confidence': 0.6689760684967041, 'speaker': 'A'}, {'text': 'But not only that, they also report to have bodily alterations.', 'start': 112720, 'end': 118480, 'sentiment': 'NEUTRAL', 'confidence': 0.576311469078064, 'speaker': 'A'}, {'text': 'So alterations in the procession of the body.', 'start': 119220, 'end': 121744, 'sentiment': 'NEUTRAL', 'confidence': 0.8223006725311279, 'speaker': 'A'}, {'text': 'That has been called expansion, oceanic boundlessness, dissolution of body boundaries.', 'start': 121782, 'end': 127372, 'sentiment': 'NEUTRAL', 'confidence': 0.8667558431625366, 'speaker': 'A'}, {'text': 'And since you are particularly interested in this kind of phenomenal experience, we have proposed to frame them unlimited body, just for clarity.', 'start': 127516, 'end': 137696, 'sentiment': 'POSITIVE', 'confidence': 0.7484390139579773, 'speaker': 'A'}, {'text': 'So our question here is what exactly?', 'start': 137888, 'end': 140308, 'sentiment': 'NEUTRAL', 'confidence': 0.8224040865898132, 'speaker': 'A'}, {'text': 'And the question that will follow the whole presentation in the background is what exactly is lost when experienced meditators report losing their self and the body?', 'start': 140394, 'end': 152250, 'sentiment': 'NEGATIVE', 'confidence': 0.6045376658439636, 'speaker': 'A'}, {'text': "So let's first look very briefly at what the self is, or the sense of self is.", 'start': 152940, 'end': 160476, 'sentiment': 'NEUTRAL', 'confidence': 0.8887023329734802, 'speaker': 'A'}, {'text': 'So this concept is so complex and so wide that has been debated since the beginning of philosophy.', 'start': 160658, 'end': 168800, 'sentiment': 'NEUTRAL', 'confidence': 0.7584633231163025, 'speaker': 'A'}, {'text': "And of course, it might be so intuitive that it's also very hard to define.", 'start': 169780, 'end': 175260, 'sentiment': 'NEUTRAL', 'confidence': 0.5792765617370605, 'speaker': 'A'}, {'text': 'But one very old and used definition is the unitary or unique individual eye.', 'start': 175420, 'end': 183760, 'sentiment': 'NEUTRAL', 'confidence': 0.6437389850616455, 'speaker': 'A'}, {'text': 'The first person perspective, that Latin was called the subjectin.', 'start': 183840, 'end': 188656, 'sentiment': 'NEUTRAL', 'confidence': 0.8880360722541809, 'speaker': 'A'}, {'text': "So something that lay under all our stream of experience, thoughts and whatever else happens to us, that's the subject.", 'start': 188688, 'end': 199320, 'sentiment': 'NEUTRAL', 'confidence': 0.8811202049255371, 'speaker': 'A'}, {'text': 'However, more recently in cognitive science, we are appealing to a more common definition of sense of self, a bit more exhaustive, that is defined as a multidimensional construct.', 'start': 200300, 'end': 211992, 'sentiment': 'NEUTRAL', 'confidence': 0.7468881607055664, 'speaker': 'A'}, {'text': "And here we will come back on this concept later and we'll unpack it a bit more.", 'start': 212056, 'end': 219890, 'sentiment': 'NEUTRAL', 'confidence': 0.8403727412223816, 'speaker': 'A'}, {'text': 'So the aim of this presentation will be to first of all, lay down the fact that in self experiences, the biological organism, so to speak, the human body remains successfully repregulated.', 'start': 221300, 'end': 237296, 'sentiment': 'NEUTRAL', 'confidence': 0.6141445636749268, 'speaker': 'A'}, {'text': 'And this might be very intuitive but it needs us then to see that during selfless experiences what we propose is that they may be tacitly accompanied or implicitly underlined by enhanced connectedness with this successful self regulation that we propose to link it with a perceptually attenuated body or what has been already called transparent body.', 'start': 237488, 'end': 266190, 'sentiment': 'NEUTRAL', 'confidence': 0.7286006808280945, 'speaker': 'A'}, {'text': "And this allows us to propose but it's of course on a working process and we are very open to feedback at any stage of this presentation that the term selfless states may be misleading because what is lost is an ordinary way to mentally model the self relation to the body and the world.", 'start': 268500, 'end': 291430, 'sentiment': 'NEUTRAL', 'confidence': 0.7011174559593201, 'speaker': 'A'}, {'text': 'So our roadmap is composed as follows first I will passing through debates and definitions of losing oneself and body.', 'start': 292860, 'end': 305660, 'sentiment': 'NEUTRAL', 'confidence': 0.8554747104644775, 'speaker': 'A'}, {'text': 'So that means I will go through alterations in these three dimension during massive state and then I will introduce Keen concept of predictive process in the active infrastructure framework that are useful in our explanation.', 'start': 305730, 'end': 326720, 'sentiment': 'NEUTRAL', 'confidence': 0.662661612033844, 'speaker': 'A'}, {'text': 'So that then I can unpack the role of the biological self organization and homostatic self regulation in constituting our sense of self.', 'start': 328100, 'end': 340710, 'sentiment': 'NEUTRAL', 'confidence': 0.9017993807792664, 'speaker': 'A'}, {'text': 'And then pass to our more claim that the processes like somatosensory, attenuation and transparent self modeling are a key mechanism underlying the phenomenology of deep mathematical states.', 'start': 341640, 'end': 354148, 'sentiment': 'NEUTRAL', 'confidence': 0.8068233728408813, 'speaker': 'A'}, {'text': 'And this then will allow us to draw our conclusions and present ongoing related projects.', 'start': 354334, 'end': 360380, 'sentiment': 'NEUTRAL', 'confidence': 0.8055670857429504, 'speaker': 'A'}, {'text': "So let's come back to the sense of self.", 'start': 363280, 'end': 366430, 'sentiment': 'NEUTRAL', 'confidence': 0.7566671967506409, 'speaker': 'A'}, {'text': "So when one has to investigate the sense of self, of course, as I said it's so wide concept that so many definitions and characterization of the sense of self has come up in philosophy and cognitive science.", 'start': 367140, 'end': 387456, 'sentiment': 'NEUTRAL', 'confidence': 0.7897965908050537, 'speaker': 'A'}, {'text': 'So we have terms like minimal self experience, selfhood sense of ownership and all of this.', 'start': 387488, 'end': 395128, 'sentiment': 'NEUTRAL', 'confidence': 0.8563965559005737, 'speaker': 'A'}, {'text': 'And for other part I think we have just to stick to a common definition that comes for example from a similar paper from Gallagher 2000 that defines as a multidimensional construct composed by minimal or embodied components and narrative or reflective components.', 'start': 395294, 'end': 417000, 'sentiment': 'NEUTRAL', 'confidence': 0.8790788054466248, 'speaker': 'A'}, {'text': 'So to unpack a little bit these two concepts the minimal or embodied experience of the sense of self is the basic implicit functioning of the body of the ongoing moment.', 'start': 417080, 'end': 430420, 'sentiment': 'NEUTRAL', 'confidence': 0.8848831057548523, 'speaker': 'A'}, {'text': 'So the stream of experience that happens to me right now can be defined as my minimal sense of self.', 'start': 430490, 'end': 437812, 'sentiment': 'NEUTRAL', 'confidence': 0.8801390528678894, 'speaker': 'A'}, {'text': "So I don't really need to have an explicit knowledge about myself to have this kind of dimension.", 'start': 437866, 'end': 446760, 'sentiment': 'NEUTRAL', 'confidence': 0.7667282223701477, 'speaker': 'A'}, {'text': 'And these can be further unpacked through the concept of prereflective self consciousness that comes from a phenomenological tradition.', 'start': 447740, 'end': 457272, 'sentiment': 'NEUTRAL', 'confidence': 0.8965545296669006, 'speaker': 'A'}, {'text': 'Tracing back from peak argue that parts of our self conscious does not need any reflection to happen there or explicit thought.', 'start': 457416, 'end': 473472, 'sentiment': 'NEUTRAL', 'confidence': 0.7199855446815491, 'speaker': 'A'}, {'text': 'It happens in a way tambourian is consistently before reflection.', 'start': 473606, 'end': 481440, 'sentiment': 'NEUTRAL', 'confidence': 0.8864556550979614, 'speaker': 'A'}, {'text': 'And then on top of this we build our narrative or our reflections about ourself.', 'start': 481600, 'end': 487168, 'sentiment': 'NEUTRAL', 'confidence': 0.7772465944290161, 'speaker': 'A'}, {'text': 'And this is more linked to self identification processes or self monitoring, self recognition and introspection.', 'start': 487264, 'end': 495844, 'sentiment': 'NEUTRAL', 'confidence': 0.8822695016860962, 'speaker': 'A'}, {'text': "Introspection, it's the ability of introspection.", 'start': 495892, 'end': 502436, 'sentiment': 'NEUTRAL', 'confidence': 0.7777062654495239, 'speaker': 'A'}, {'text': 'So perceive yourself or reflect about yourself in an explicit way.', 'start': 502468, 'end': 507870, 'sentiment': 'NEUTRAL', 'confidence': 0.8837200403213501, 'speaker': 'A'}, {'text': 'So you do need to have that biography or an explicit memory about yourself in order to tackle this aspect of the sense of self.', 'start': 508240, 'end': 516430, 'sentiment': 'NEUTRAL', 'confidence': 0.887564480304718, 'speaker': 'A'}, {'text': "So in deep meditative states there is alterations in the sense of self and it's up to debate which dimension are affected by that.", 'start': 517780, 'end': 530592, 'sentiment': 'NEUTRAL', 'confidence': 0.8620779514312744, 'speaker': 'A'}, {'text': "And it's far from clear what actually happens to this kind of dimension and more and many more other dimensional sense of self.", 'start': 530726, 'end': 541830, 'sentiment': 'NEGATIVE', 'confidence': 0.5311597585678101, 'speaker': 'A'}, {'text': 'And we are here to unpack a little bit this.', 'start': 542380, 'end': 546490, 'sentiment': 'NEUTRAL', 'confidence': 0.8407971262931824, 'speaker': 'A'}, {'text': 'We proposed these quotations from Fashion 2008 where it suggested that enduring deep massive states one experiences oneself as these very moments of consciousness.', 'start': 546860, 'end': 560632, 'sentiment': 'NEUTRAL', 'confidence': 0.8442214131355286, 'speaker': 'A'}, {'text': 'This is quotation that may reveal some position about the debate what happens to the sense of self.', 'start': 560776, 'end': 569904, 'sentiment': 'NEUTRAL', 'confidence': 0.9009164571762085, 'speaker': 'A'}, {'text': "So in this case it's argued that meditation reveal a very moment of consciousness.", 'start': 570022, 'end': 576556, 'sentiment': 'NEUTRAL', 'confidence': 0.8314701318740845, 'speaker': 'A'}, {'text': 'So there is something that is true consciousness or something that is the real consciousness.', 'start': 576588, 'end': 585152, 'sentiment': 'NEUTRAL', 'confidence': 0.87953120470047, 'speaker': 'A'}, {'text': 'And this actually has broke through the concept of pure consciousness.', 'start': 585296, 'end': 589632, 'sentiment': 'NEGATIVE', 'confidence': 0.7282271981239319, 'speaker': 'A'}, {'text': "So something that stayed there and it's purified by everything, by also the body.", 'start': 589776, 'end': 599576, 'sentiment': 'NEUTRAL', 'confidence': 0.8077431321144104, 'speaker': 'A'}, {'text': 'And there is so many definition of this pure consciousness.', 'start': 599678, 'end': 603364, 'sentiment': 'NEUTRAL', 'confidence': 0.8019068241119385, 'speaker': 'A'}, {'text': "We brought some example like ownerless consciousness, the consciousness that doesn't have an owner, that doesn't have a self.", 'start': 603412, 'end': 610990, 'sentiment': 'NEUTRAL', 'confidence': 0.6014698147773743, 'speaker': 'A'}, {'text': "So it doesn't have a proper sense of self that walked or that owns this consciousness.", 'start': 611360, 'end': 617760, 'sentiment': 'NEGATIVE', 'confidence': 0.6001682281494141, 'speaker': 'A'}, {'text': 'Mastinger has worked on the minimal phenomenal experience defining aspecial a temporal dimensional consciousness.', 'start': 618420, 'end': 626560, 'sentiment': 'NEUTRAL', 'confidence': 0.8063405156135559, 'speaker': 'A'}, {'text': "And this is very supportive because it's consistent with the Buddhist philosophical stance of no self.", 'start': 627060, 'end': 634080, 'sentiment': 'POSITIVE', 'confidence': 0.9187466502189636, 'speaker': 'A'}, {'text': 'So for most tradition of Buddhism, there is no self.', 'start': 634150, 'end': 640340, 'sentiment': 'NEUTRAL', 'confidence': 0.8398311138153076, 'speaker': 'A'}, {'text': "The self, it's an illusion.", 'start': 640410, 'end': 642640, 'sentiment': 'NEUTRAL', 'confidence': 0.5985299944877625, 'speaker': 'A'}, {'text': 'And it comes to our psychology when we enter in contact with the world and with the sensations of the world and certain patterns of behavior that elicit the sense that we have a self.', 'start': 642720, 'end': 654890, 'sentiment': 'NEUTRAL', 'confidence': 0.8708445429801941, 'speaker': 'A'}, {'text': 'So, as I said, meditation allows us to access this pure consciousness for supporters of this thesis and rebuilds one choose an essential nature of subjective and we bring this into debate.', 'start': 656080, 'end': 671440, 'sentiment': 'NEUTRAL', 'confidence': 0.6158703565597534, 'speaker': 'A'}, {'text': 'There are also people that argue against this and it has been called by Matthew in their special issues, the Ubitiquity thesis.', 'start': 673460, 'end': 685436, 'sentiment': 'NEUTRAL', 'confidence': 0.6443294882774353, 'speaker': 'A'}, {'text': 'So the UBIT thesis claim that essential self is ubiquitous to all states of consciousness and sometimes it appeals to the immunity to error through misidentification argument of self ascription reports, which is simpler than this long name.', 'start': 685628, 'end': 703610, 'sentiment': 'NEUTRAL', 'confidence': 0.7231537699699402, 'speaker': 'A'}, {'text': "And it's basically the fact that I can say that I had a wonderful experience and this wonderful experience may be true or false on this weekend.", 'start': 704400, 'end': 720812, 'sentiment': 'POSITIVE', 'confidence': 0.9471847414970398, 'speaker': 'A'}, {'text': "I can do mistakes, I can make mistakes, but I cannot not say that I didn't have these wonderful experiences because the moment in which I report I have a perspective on this.", 'start': 720956, 'end': 735892, 'sentiment': 'NEUTRAL', 'confidence': 0.47259336709976196, 'speaker': 'A'}, {'text': "So I cannot really be mistaking on the fact that I'm reporting this.", 'start': 735946, 'end': 739300, 'sentiment': 'NEUTRAL', 'confidence': 0.6873981952667236, 'speaker': 'A'}, {'text': "Maybe I was dreaming, maybe it wasn't a wonderful experience, but it's me that I'm reporting.", 'start': 739370, 'end': 744576, 'sentiment': 'NEUTRAL', 'confidence': 0.49571171402931213, 'speaker': 'A'}, {'text': "So the moment I'm reporting this, it means that I have to be there.", 'start': 744608, 'end': 748470, 'sentiment': 'NEUTRAL', 'confidence': 0.6787335872650146, 'speaker': 'A'}, {'text': 'And this applies also to when I ascribe myself selfless state, I had a selfless state.', 'start': 748920, 'end': 758700, 'sentiment': 'NEUTRAL', 'confidence': 0.8085998892784119, 'speaker': 'A'}, {'text': 'This is very controversial.', 'start': 758850, 'end': 760700, 'sentiment': 'NEGATIVE', 'confidence': 0.5829615592956543, 'speaker': 'A'}, {'text': 'Other problems on top of that are cross cultural problems also addressed in the literature.', 'start': 761680, 'end': 766728, 'sentiment': 'NEGATIVE', 'confidence': 0.7264262437820435, 'speaker': 'A'}, {'text': 'So this experience selfless states may be influenced by certain vows or certain beliefs that meditator endorse, especially during especially expert meditators.', 'start': 766904, 'end': 782180, 'sentiment': 'NEUTRAL', 'confidence': 0.8435436487197876, 'speaker': 'A'}, {'text': 'And the other thing is these all cross cultural analysis and debate about the self may be also partially due to a verbal misunderstanding.', 'start': 782520, 'end': 799060, 'sentiment': 'NEUTRAL', 'confidence': 0.61605304479599, 'speaker': 'A'}, {'text': 'So that the western philosophy may have problems about the self that actually the Eastern probably philosophy is not really addressing.', 'start': 799140, 'end': 806968, 'sentiment': 'NEGATIVE', 'confidence': 0.5899699926376343, 'speaker': 'A'}, {'text': 'So there might be some incommensurability of problems there.', 'start': 807064, 'end': 811548, 'sentiment': 'NEUTRAL', 'confidence': 0.6776115894317627, 'speaker': 'A'}, {'text': "But as also we said in the paper, it's not that we want to address the Buddhist philosophical problems, rather we want to bring insight from these to our problems.", 'start': 811714, 'end': 824290, 'sentiment': 'NEUTRAL', 'confidence': 0.807881772518158, 'speaker': 'A'}, {'text': 'So, given this debate, we want to propose a shift in the focus.', 'start': 825940, 'end': 831536, 'sentiment': 'NEUTRAL', 'confidence': 0.8587613701820374, 'speaker': 'A'}, {'text': "So we don't want to start by looking at consciousness and trying to solve things about the self, but we want to start by focusing on the body.", 'start': 831638, 'end': 839700, 'sentiment': 'NEUTRAL', 'confidence': 0.6702304482460022, 'speaker': 'A'}, {'text': 'So we proposed a shift in focus in the bodily experience, examining this deep mercy state.', 'start': 839850, 'end': 846630, 'sentiment': 'NEUTRAL', 'confidence': 0.8505532741546631, 'speaker': 'A'}, {'text': "So let's start by the subjective experience of the body or the study of the subjective experience of the body, which is phenomenology.", 'start': 848940, 'end': 858060, 'sentiment': 'NEUTRAL', 'confidence': 0.8637896180152893, 'speaker': 'A'}, {'text': 'In the tradition, our body has a unique status.', 'start': 858480, 'end': 861980, 'sentiment': 'NEUTRAL', 'confidence': 0.8351266384124756, 'speaker': 'A'}, {'text': 'So the anatomical structure of the body has been called by USA Kobe.', 'start': 862560, 'end': 868568, 'sentiment': 'NEUTRAL', 'confidence': 0.8475017547607422, 'speaker': 'A'}, {'text': 'So the living body, the body that I can observe and others can be observed.', 'start': 868664, 'end': 873276, 'sentiment': 'NEUTRAL', 'confidence': 0.691987156867981, 'speaker': 'A'}, {'text': "So it's the object among the other object, they would say.", 'start': 873308, 'end': 877168, 'sentiment': 'NEUTRAL', 'confidence': 0.8148578405380249, 'speaker': 'A'}, {'text': "But it's not only that because it's an object that I can live from inside.", 'start': 877334, 'end': 882628, 'sentiment': 'NEUTRAL', 'confidence': 0.5156576037406921, 'speaker': 'A'}, {'text': 'So it has been called the light, the lived body or the body as I leave it from inside, as I said.', 'start': 882794, 'end': 888950, 'sentiment': 'NEUTRAL', 'confidence': 0.8847672939300537, 'speaker': 'A'}, {'text': 'So what happens to these kind of dimension?', 'start': 890440, 'end': 893972, 'sentiment': 'NEUTRAL', 'confidence': 0.621192216873169, 'speaker': 'A'}, {'text': 'Again, we can unpack this and see how the meditative states affect them.', 'start': 894036, 'end': 899544, 'sentiment': 'NEUTRAL', 'confidence': 0.8972695469856262, 'speaker': 'A'}, {'text': 'So from the point of view of the life believed body, we already know, and I will unpack a little bit more.', 'start': 899742, 'end': 908876, 'sentiment': 'NEUTRAL', 'confidence': 0.8407151103019714, 'speaker': 'A'}, {'text': 'So we have already said that we have called unlinuated body experiences the reports that spoke about this fading of the body boundaries.', 'start': 908978, 'end': 921260, 'sentiment': 'NEUTRAL', 'confidence': 0.8456845283508301, 'speaker': 'A'}, {'text': "So the body boundary has been defined as a cognitive emotional perception of one's body surface.", 'start': 921420, 'end': 928156, 'sentiment': 'NEUTRAL', 'confidence': 0.8797711133956909, 'speaker': 'A'}, {'text': "That's just a definition.", 'start': 928268, 'end': 929836, 'sentiment': 'NEUTRAL', 'confidence': 0.6904804706573486, 'speaker': 'A'}, {'text': 'We can also debate about this.', 'start': 930028, 'end': 932704, 'sentiment': 'NEUTRAL', 'confidence': 0.8467051982879639, 'speaker': 'A'}, {'text': "But what it's important about for us that our sense of body boundaries is flexible and dynamic.", 'start': 932822, 'end': 939072, 'sentiment': 'NEUTRAL', 'confidence': 0.7109889984130859, 'speaker': 'A'}, {'text': "It's not fixed because we are in the realm of the body as felt from inside.", 'start': 939136, 'end': 944410, 'sentiment': 'NEUTRAL', 'confidence': 0.645940363407135, 'speaker': 'A'}, {'text': 'There is an interesting study that exemplified this concept in relation to meditation by Jumpren in 2016, though it has worked late further on on this as well.', 'start': 945820, 'end': 959228, 'sentiment': 'POSITIVE', 'confidence': 0.8988007307052612, 'speaker': 'A'}, {'text': 'But I find it interesting to look at this image because this is part of a self report measurement that they used on a sample of people that had been trained in meditation, in particular with body scanning.', 'start': 959394, 'end': 974796, 'sentiment': 'POSITIVE', 'confidence': 0.7988940477371216, 'speaker': 'A'}, {'text': 'So that people had to systematically scan sensation running the body.', 'start': 974908, 'end': 981010, 'sentiment': 'NEUTRAL', 'confidence': 0.6629118323326111, 'speaker': 'A'}, {'text': 'And the result is that in less than four months of practice, so not actually not the expert, they really started to report an increased tendency to go towards the almost imperceptible perception of the body.', 'start': 981540, 'end': 1001528, 'sentiment': 'NEUTRAL', 'confidence': 0.6136724352836609, 'speaker': 'A'}, {'text': 'So they conclude that meditation can be actually studied in this sense where it affects our sense of body boundaries.', 'start': 1001694, 'end': 1011960, 'sentiment': 'NEUTRAL', 'confidence': 0.8422032594680786, 'speaker': 'A'}, {'text': 'And they saw significant results also in relation to increased mood, happiness and decreased anxiety and rumination.', 'start': 1012040, 'end': 1025916, 'sentiment': 'POSITIVE', 'confidence': 0.8915296196937561, 'speaker': 'A'}, {'text': 'But this is just another story that will come back later.', 'start': 1025948, 'end': 1030070, 'sentiment': 'NEUTRAL', 'confidence': 0.6616644263267517, 'speaker': 'A'}, {'text': "So I find interesting also this quotation by Fink here in this paper it's talking about why ego dissolution may be better understood as ego expansion.", 'start': 1031320, 'end': 1042740, 'sentiment': 'POSITIVE', 'confidence': 0.8264653086662292, 'speaker': 'A'}, {'text': 'And then ego dissolution comes in a later interpretation.', 'start': 1044920, 'end': 1050200, 'sentiment': 'NEUTRAL', 'confidence': 0.6370914578437805, 'speaker': 'A'}, {'text': 'And so I will read it.', 'start': 1051980, 'end': 1053496, 'sentiment': 'NEUTRAL', 'confidence': 0.6332367658615112, 'speaker': 'A'}, {'text': "It's not the feeling of self that dissolves, but the boundary between a feeling of self and the feeling of anything else in consciousness.", 'start': 1053598, 'end': 1062300, 'sentiment': 'NEUTRAL', 'confidence': 0.7181183695793152, 'speaker': 'A'}, {'text': "So here again Pink is talking about consciousness but from our perspective this quotation is pretty informing because it goes in our direction as well because he says it's not that you're losing really yourself.", 'start': 1062720, 'end': 1079010, 'sentiment': 'POSITIVE', 'confidence': 0.7064943909645081, 'speaker': 'A'}, {'text': "This experience is dependent on how you actually perceive your boundary with you and what you don't consider you.", 'start': 1079720, 'end': 1088724, 'sentiment': 'NEUTRAL', 'confidence': 0.7726724147796631, 'speaker': 'A'}, {'text': 'So self fading of the self other distinction ability.', 'start': 1088762, 'end': 1094120, 'sentiment': 'NEUTRAL', 'confidence': 0.7496324181556702, 'speaker': 'A'}, {'text': 'So here it comes predictive processing acting framework because we want to basically breach this phenomenal subjective experience to cognitive phenomena and underlying mechanistic explanation.', 'start': 1096380, 'end': 1116780, 'sentiment': 'NEUTRAL', 'confidence': 0.5684527158737183, 'speaker': 'A'}, {'text': 'Indeed, predictive processing activities have recently used for this purpose.', 'start': 1118260, 'end': 1122892, 'sentiment': 'NEUTRAL', 'confidence': 0.8968393206596375, 'speaker': 'A'}, {'text': 'Also meditation research and psychopathology research and so on.', 'start': 1122956, 'end': 1129148, 'sentiment': 'NEUTRAL', 'confidence': 0.8574843406677246, 'speaker': 'A'}, {'text': 'So in this presentation I will use them in an interchangeable way but following certain trends.', 'start': 1129334, 'end': 1137552, 'sentiment': 'NEUTRAL', 'confidence': 0.8089592456817627, 'speaker': 'A'}, {'text': "But it doesn't have to be, it's also under debate and I will also give API purely I don't know how to say theoretical perspective on that I will not go too much technical.", 'start': 1137616, 'end': 1153080, 'sentiment': 'NEUTRAL', 'confidence': 0.7270492911338806, 'speaker': 'A'}, {'text': "So briefly, this framework considers brains as predictive machine or as Friesen likes to say, consider brain as a fantastic organ which is because it's not only able to do amazing things, but also because it really generates fantasies about the world.", 'start': 1154620, 'end': 1179164, 'sentiment': 'POSITIVE', 'confidence': 0.8771001100540161, 'speaker': 'A'}, {'text': 'And this is because in order to act, interact with itself and the world around, the brain constantly anticipate the current state of affairs in order to make sense of the sensorium or the stream of experiences that happens.', 'start': 1179302, 'end': 1202490, 'sentiment': 'NEUTRAL', 'confidence': 0.8302243947982788, 'speaker': 'A'}, {'text': 'So it possess or embody or utilizes, it depends on the commitment a generative model which is a model that keep tracks of regularity of the world and forms predictions out of it in a hierarchical way.', 'start': 1204480, 'end': 1221952, 'sentiment': 'NEUTRAL', 'confidence': 0.8861688375473022, 'speaker': 'A'}, {'text': 'So highly rated prediction goes down to match sensory data and sensory data goes up to map to affect the predictions, to update the model.', 'start': 1222086, 'end': 1239670, 'sentiment': 'NEUTRAL', 'confidence': 0.787213921546936, 'speaker': 'A'}, {'text': 'However, every prediction comes with a degree of error which sometimes is called prediction errors.', 'start': 1240600, 'end': 1249124, 'sentiment': 'NEGATIVE', 'confidence': 0.5145548582077026, 'speaker': 'A'}, {'text': 'So the prediction error is a discrepancy between prediction and sensory input so that a new model is generated and they say the first imperative or the only imperative of the system is actually minimizing the prediction errors so that the model can most efficiently cope and interact and act in the world.', 'start': 1249252, 'end': 1275970, 'sentiment': 'NEUTRAL', 'confidence': 0.7002280950546265, 'speaker': 'A'}, {'text': "However, it's not the only imperative because as I will introduce in this slide, the system has also to estimate the confidence or likelihood or precision of prediction in order to evaluate the prediction errors that are coming from the discrepancy.", 'start': 1276580, 'end': 1302200, 'sentiment': 'NEUTRAL', 'confidence': 0.796087920665741, 'speaker': 'A'}, {'text': 'So that the generative model has to compute in a fine way how much precision to assign to the prediction or prediction errors and I choose this image because it renders well how the distribution are set depending on the precision citation.', 'start': 1302860, 'end': 1329512, 'sentiment': 'NEUTRAL', 'confidence': 0.542058527469635, 'speaker': 'A'}, {'text': 'So if you have a precise prediction error then the posterior distribution will be closer to the prediction error.', 'start': 1329596, 'end': 1337872, 'sentiment': 'NEUTRAL', 'confidence': 0.7467325329780579, 'speaker': 'A'}, {'text': 'Well, the imprecise prediction error have little effect on the prior, so does the posture distribution will be closer to the prior and this is very important because if the precision estimator are not weighted correctly then the system generates false inference that will not able to the system to interact efficiently and update the model efficiently.', 'start': 1337936, 'end': 1365180, 'sentiment': 'NEGATIVE', 'confidence': 0.5180140137672424, 'speaker': 'A'}, {'text': 'So, so far we have mostly talked about prediction error minimization by updating the model.', 'start': 1366400, 'end': 1375680, 'sentiment': 'NEUTRAL', 'confidence': 0.7908388376235962, 'speaker': 'A'}, {'text': 'However, the system can also active sample the world active modify the prediction error or the world in order to fit the prediction errors to the world.', 'start': 1375830, 'end': 1391396, 'sentiment': 'NEUTRAL', 'confidence': 0.7879059910774231, 'speaker': 'A'}, {'text': "And this comes into play active inference that builds upon the free energy principle where it's based on the idea that living organisms maintain themselves with an optimal set of states that comes from the second low thermodynamics of schrodinger.", 'start': 1391578, 'end': 1412300, 'sentiment': 'NEUTRAL', 'confidence': 0.7827375531196594, 'speaker': 'A'}, {'text': 'So given that it comes into play how attention is analyzed or examined under this framework.', 'start': 1414800, 'end': 1427820, 'sentiment': 'NEUTRAL', 'confidence': 0.8861578702926636, 'speaker': 'A'}, {'text': 'So given that that the organism has to maintain within these optimal assessor states by maintaining an optimal balance between computation and precision optimization so wasting between prediction and prediction errors, attention comes into place as a modulation of this precision of sensory data working as a search light.', 'start': 1428320, 'end': 1455308, 'sentiment': 'NEUTRAL', 'confidence': 0.8291419148445129, 'speaker': 'A'}, {'text': 'So in other words, it optimizes signal to noise ratio.', 'start': 1455474, 'end': 1460376, 'sentiment': 'NEUTRAL', 'confidence': 0.49636709690093994, 'speaker': 'A'}, {'text': "It's one of the way that we have to put in place this local optimization of precision estimates and this is very important why we bring into attention because meditation has a systematic and use of attention resources and we will come back into that a bit further on in this presentation.", 'start': 1460408, 'end': 1493320, 'sentiment': 'POSITIVE', 'confidence': 0.5504562258720398, 'speaker': 'A'}, {'text': "And given that we are interested in okay, we have seen the lived body, what happens to the phenomenal experience now we're interested in what happens to the corporate, what happens to believing body that can be observed by the organism during medicine states.", 'start': 1494780, 'end': 1515390, 'sentiment': 'NEUTRAL', 'confidence': 0.7846992015838623, 'speaker': 'A'}, {'text': 'In this we bring into play other two important concepts in active inference which is way to self regulate that underlie all embassy experience, so all subjective experience, so two ways or one way that then is also active.', 'start': 1516480, 'end': 1539456, 'sentiment': 'NEUTRAL', 'confidence': 0.7460561990737915, 'speaker': 'A'}, {'text': 'So the first way is homeostasis which is the maintenance of required optimal state by survival and reproduction of self organizing biological systems.', 'start': 1539568, 'end': 1550628, 'sentiment': 'NEUTRAL', 'confidence': 0.850257396697998, 'speaker': 'A'}, {'text': 'So for example, I cold and I use my internal resources to keep my states into optimal state so I start shivering.', 'start': 1550644, 'end': 1564456, 'sentiment': 'NEGATIVE', 'confidence': 0.48303306102752686, 'speaker': 'A'}, {'text': "However, I can also put in place active modification in the world so that I'm not cold anymore.", 'start': 1564568, 'end': 1573196, 'sentiment': 'NEUTRAL', 'confidence': 0.6757622361183167, 'speaker': 'A'}, {'text': 'So for example, I take a blank, this is called allostasis.', 'start': 1573388, 'end': 1576556, 'sentiment': 'NEUTRAL', 'confidence': 0.7959035038948059, 'speaker': 'A'}, {'text': "So it's active engagements and modification about the environment in order to maintain myself in optimal state for survival.", 'start': 1576588, 'end': 1584500, 'sentiment': 'NEUTRAL', 'confidence': 0.7116428017616272, 'speaker': 'A'}, {'text': 'So we can say of course, human bodies are self organizing biological system aiming at keeping these internal states within a certain viable range for survival.', 'start': 1585560, 'end': 1598200, 'sentiment': 'NEUTRAL', 'confidence': 0.8819915056228638, 'speaker': 'A'}, {'text': 'Now, given that we will come back again to the phenomenology of touch.', 'start': 1598940, 'end': 1604170, 'sentiment': 'NEUTRAL', 'confidence': 0.8092166185379028, 'speaker': 'A'}, {'text': "I'm going to do this for the second time to then wrap up everything again.", 'start': 1605360, 'end': 1612750, 'sentiment': 'NEUTRAL', 'confidence': 0.7646272778511047, 'speaker': 'A'}, {'text': 'So, we have talked about fermology of the body.', 'start': 1615200, 'end': 1618850, 'sentiment': 'NEUTRAL', 'confidence': 0.8842344284057617, 'speaker': 'A'}, {'text': "However, we haven't underlined the importance that the touch and proximal sound has for our lip.", 'start': 1619300, 'end': 1629280, 'sentiment': 'NEUTRAL', 'confidence': 0.763158917427063, 'speaker': 'A'}, {'text': 'Our as Nikka and colleagues has already proposed, our proximal sense are central for our minimal sense of self.', 'start': 1631140, 'end': 1642650, 'sentiment': 'NEUTRAL', 'confidence': 0.842645525932312, 'speaker': 'A'}, {'text': 'And on top of that, we bring into play the fact that different kinds of touch can convey different experience of the sense of self or sense of boundaries.', 'start': 1643500, 'end': 1655336, 'sentiment': 'NEUTRAL', 'confidence': 0.8689063787460327, 'speaker': 'A'}, {'text': 'So for example, imagine yourself that you are in a city of Portugal or California, you touching the whole environment with your body.', 'start': 1655448, 'end': 1667810, 'sentiment': 'NEUTRAL', 'confidence': 0.8222672939300537, 'speaker': 'A'}, {'text': 'You may feel that you have a sense of immersiveness or that your body boundaries are slowly a bit becoming less clear.', 'start': 1668340, 'end': 1676848, 'sentiment': 'NEUTRAL', 'confidence': 0.5222228169441223, 'speaker': 'A'}, {'text': "And this experience, it's actually a bit similar to the experiences of sensory deprivation states where people are put in a salty water and they let them flow for some moments.", 'start': 1677014, 'end': 1690656, 'sentiment': 'NEUTRAL', 'confidence': 0.7596189975738525, 'speaker': 'A'}, {'text': 'Sensory deprivation states are not really all deprived because you have other activities in the body and movements that produce signals that you are actually aware of.', 'start': 1690848, 'end': 1702650, 'sentiment': 'NEUTRAL', 'confidence': 0.7406807541847229, 'speaker': 'A'}, {'text': 'However, in both these experiences, the body boundary seems to fade a little bit.', 'start': 1703020, 'end': 1708876, 'sentiment': 'NEUTRAL', 'confidence': 0.6519625782966614, 'speaker': 'A'}, {'text': "However, if you're in the sea and you're swimming and then you touch the rock with your hand, you clearly will feel yourself as separated as something different from what you're actually touching, right?", 'start': 1709058, 'end': 1721376, 'sentiment': 'NEUTRAL', 'confidence': 0.7470687627792358, 'speaker': 'A'}, {'text': 'Sense of separation.', 'start': 1721478, 'end': 1722720, 'sentiment': 'NEUTRAL', 'confidence': 0.6950520873069763, 'speaker': 'A'}, {'text': 'This phenomenology can be brought into active inference through the mechanism of some of the sensory attenuation which comes from the sensory tinuation.', 'start': 1724580, 'end': 1735680, 'sentiment': 'NEUTRAL', 'confidence': 0.8925809860229492, 'speaker': 'A'}, {'text': 'So this process happens when the systemicates its own action.', 'start': 1736120, 'end': 1743160, 'sentiment': 'NEUTRAL', 'confidence': 0.5654797554016113, 'speaker': 'A'}, {'text': 'So for example, I take a glass and in this moment my rena has already created afferent copies of this action and the sensory consequences of this.', 'start': 1743980, 'end': 1756556, 'sentiment': 'NEUTRAL', 'confidence': 0.8773865699768066, 'speaker': 'A'}, {'text': 'So whenever I grab this glass, the sensory constant that happens to my body are slightly attenuated.', 'start': 1756658, 'end': 1768880, 'sentiment': 'NEUTRAL', 'confidence': 0.7275703549385071, 'speaker': 'A'}, {'text': 'And this is why we cannot tickle ourselves because the prediction errors comes at.', 'start': 1769220, 'end': 1775344, 'sentiment': 'NEGATIVE', 'confidence': 0.8305435180664062, 'speaker': 'A'}, {'text': 'Not surprising this has implication for our embodied experience in the world.', 'start': 1775382, 'end': 1783972, 'sentiment': 'NEUTRAL', 'confidence': 0.6641072034835815, 'speaker': 'A'}, {'text': 'Because we feel that we are in immediate contact with ourselves in the world.', 'start': 1784026, 'end': 1788564, 'sentiment': 'NEUTRAL', 'confidence': 0.7857150435447693, 'speaker': 'A'}, {'text': 'And this is because our conscious experience are mediated by transparent or non perceived cognitive processes.', 'start': 1788602, 'end': 1796404, 'sentiment': 'NEUTRAL', 'confidence': 0.795710027217865, 'speaker': 'A'}, {'text': 'So that the system can leave behind or disatten self related sensory processing.', 'start': 1796532, 'end': 1802920, 'sentiment': 'NEUTRAL', 'confidence': 0.6837741732597351, 'speaker': 'A'}, {'text': 'And these allow to allocate resources to perception and action involved in the processing of the object of interest.', 'start': 1803500, 'end': 1810990, 'sentiment': 'NEUTRAL', 'confidence': 0.8550922274589539, 'speaker': 'A'}, {'text': "So for example, when LeMans confiscated this example of the cherry, when I have to take object salient for me, I'll be much more interested in picking the object and I will not really focus on my arm moving in picking that.", 'start': 1811440, 'end': 1830850, 'sentiment': 'NEUTRAL', 'confidence': 0.5762956738471985, 'speaker': 'A'}, {'text': 'So that the system needs to compute and maintain a fine balance between external and internal components of somatosensory attenuation.', 'start': 1831240, 'end': 1839060, 'sentiment': 'NEUTRAL', 'confidence': 0.8534123301506042, 'speaker': 'A'}, {'text': 'And this is very important for a sense of self as well.', 'start': 1839400, 'end': 1842630, 'sentiment': 'POSITIVE', 'confidence': 0.5406874418258667, 'speaker': 'A'}, {'text': "So we need to understand and it's not that we need, but in order for us to have a sense of self.", 'start': 1843020, 'end': 1851448, 'sentiment': 'NEUTRAL', 'confidence': 0.8216431736946106, 'speaker': 'A'}, {'text': 'We normally have a sense of what we are and what we are not.', 'start': 1851534, 'end': 1856284, 'sentiment': 'NEUTRAL', 'confidence': 0.8259967565536499, 'speaker': 'A'}, {'text': 'But for the brain as agents end up with the brain, we compute this distinction.', 'start': 1856402, 'end': 1866040, 'sentiment': 'NEUTRAL', 'confidence': 0.8653077483177185, 'speaker': 'A'}, {'text': 'So where the self ends and where do work begins or do I move my arm or my arm is moved by something or someone?', 'start': 1866120, 'end': 1873730, 'sentiment': 'NEUTRAL', 'confidence': 0.8306721448898315, 'speaker': 'A'}, {'text': 'So central attenuation plays a role in these distinctions in building multisensory bodily self representations.', 'start': 1874980, 'end': 1884100, 'sentiment': 'NEUTRAL', 'confidence': 0.8745961785316467, 'speaker': 'A'}, {'text': 'So that the sense of the self embody is subject to the and phenomenally transferred.', 'start': 1884680, 'end': 1890976, 'sentiment': 'NEUTRAL', 'confidence': 0.853300154209137, 'speaker': 'A'}, {'text': 'That means that when we act in the world and we interact, we normally disattend the way we are in the world.', 'start': 1891168, 'end': 1901192, 'sentiment': 'NEUTRAL', 'confidence': 0.5108606815338135, 'speaker': 'A'}, {'text': 'Because we need to be in contact, in direct contact with the world.', 'start': 1901326, 'end': 1904792, 'sentiment': 'NEUTRAL', 'confidence': 0.7235977649688721, 'speaker': 'A'}, {'text': 'If we always attend it to our body and ourself in the sense that we will be hyper reflexive then we will be actually will be impaired in what we normally do.', 'start': 1904846, 'end': 1919152, 'sentiment': 'NEUTRAL', 'confidence': 0.6411047577857971, 'speaker': 'A'}, {'text': 'And this is actually a condition that we will talk about later.', 'start': 1919206, 'end': 1922530, 'sentiment': 'NEUTRAL', 'confidence': 0.8671953678131104, 'speaker': 'A'}, {'text': 'So that in active images the sense of self is an ongoing inferential process centering the body.', 'start': 1924020, 'end': 1930052, 'sentiment': 'NEUTRAL', 'confidence': 0.8899309039115906, 'speaker': 'A'}, {'text': 'So what we propose is what is lost during selfless experience is an ordinary way to mentally model self in relation to the body and the world.', 'start': 1930106, 'end': 1942948, 'sentiment': 'NEUTRAL', 'confidence': 0.8289012312889099, 'speaker': 'A'}, {'text': "So that if we think about the self as I propose here the iceberg where the narrative self is what we see but the renewal self is what we actually are composed of and it's actually larger but we are not aware of.", 'start': 1943114, 'end': 1956940, 'sentiment': 'NEUTRAL', 'confidence': 0.7823860049247742, 'speaker': 'A'}, {'text': 'Similarly, when we have self experience we may have also this inferential process where we think we have lost ourselves.', 'start': 1957090, 'end': 1966620, 'sentiment': 'NEUTRAL', 'confidence': 0.5955342650413513, 'speaker': 'A'}, {'text': 'However, we have gathered some evidence in the fact that meditation facilitate autonomic regulation involved in homostatic processes.', 'start': 1969220, 'end': 1982580, 'sentiment': 'NEUTRAL', 'confidence': 0.5570846199989319, 'speaker': 'A'}, {'text': 'That means for example that meditation increase the synchronization of cardiac and respiratory system.', 'start': 1983080, 'end': 1989590, 'sentiment': 'NEUTRAL', 'confidence': 0.5565984845161438, 'speaker': 'A'}, {'text': 'This is connected with reduced levels of blood glucose or blood pressure and heart rate variability.', 'start': 1991320, 'end': 1999140, 'sentiment': 'NEUTRAL', 'confidence': 0.7243435978889465, 'speaker': 'A'}, {'text': 'So there is a success.', 'start': 1999220, 'end': 2003770, 'sentiment': 'POSITIVE', 'confidence': 0.762438178062439, 'speaker': 'A'}, {'text': 'Medication helps to successfully self regulate the body especially in comparison to stress that actually does the opposite.', 'start': 2004140, 'end': 2014220, 'sentiment': 'NEUTRAL', 'confidence': 0.5039876103401184, 'speaker': 'A'}, {'text': 'And on top of that, meditation help us to attune us to our physiological interceptive awareness.', 'start': 2016560, 'end': 2024320, 'sentiment': 'NEUTRAL', 'confidence': 0.6213014125823975, 'speaker': 'A'}, {'text': "And it does it so they say, by enhancing the processing of extraceptive interceptive stimuli which doesn't have to be understanded as a maladaptive increased body awareness, but rather an adaptive body awareness which is a distinction that we can come back later if people are interested or they ask about.", 'start': 2024900, 'end': 2050970, 'sentiment': 'NEUTRAL', 'confidence': 0.6300807595252991, 'speaker': 'A'}, {'text': 'These evidence are also in line with evidence of meditation that promotes self regulation of pain and pain and pleasantness.', 'start': 2054480, 'end': 2061032, 'sentiment': 'POSITIVE', 'confidence': 0.6915440559387207, 'speaker': 'A'}, {'text': "So three day attentional training, the meditation allow you're actually able to self regulate the pain and not really like the sensation of the pain because actually it gets very fewer but the automatic behavioral patterns that comes in association with the pain.", 'start': 2061096, 'end': 2086950, 'sentiment': 'NEUTRAL', 'confidence': 0.6476710438728333, 'speaker': 'A'}, {'text': 'So there is a lot of also self regulation on emotions and so on.', 'start': 2087480, 'end': 2094170, 'sentiment': 'NEUTRAL', 'confidence': 0.8515828251838684, 'speaker': 'A'}, {'text': 'So the body does not literally disappear actually it stays at the very center as I propose here at the center as we propose it in the paper and I propose it through this image at the center of a cycling.', 'start': 2095420, 'end': 2110460, 'sentiment': 'NEUTRAL', 'confidence': 0.8147057294845581, 'speaker': 'A'}, {'text': 'So self regulatory processes allow the subjective experience to lose oneself so that the sense of the body remains present in the background.', 'start': 2111520, 'end': 2124780, 'sentiment': 'NEUTRAL', 'confidence': 0.7691674828529358, 'speaker': 'A'}, {'text': "And this for example, it's very clear from this report from a person undergoing this kind of experience that they say that there remains a sense that there is a body without any experience of a sense of boundary.", 'start': 2124940, 'end': 2140820, 'sentiment': 'NEUTRAL', 'confidence': 0.6377612948417664, 'speaker': 'A'}, {'text': 'So this is not very last slide but we come to our wrap up of our claim attenuating the self and limiting the body which is also the title of our paper.', 'start': 2144700, 'end': 2160860, 'sentiment': 'NEUTRAL', 'confidence': 0.8961565494537354, 'speaker': 'A'}, {'text': 'So, starting from the fact that all medicine practices across the tradition require systematic and carefully fully crafted body preparation to enter this deep method selfless state.', 'start': 2160930, 'end': 2176960, 'sentiment': 'NEUTRAL', 'confidence': 0.8426826000213623, 'speaker': 'A'}, {'text': "So it doesn't happen that all of a sudden you just have a selfless state which actually may happen more similarly with psychedelic.", 'start': 2177110, 'end': 2188880, 'sentiment': 'NEUTRAL', 'confidence': 0.6832010746002197, 'speaker': 'A'}, {'text': 'But with meditation you need to pass through gradually a many different state or many different level of concentration.', 'start': 2188960, 'end': 2201960, 'sentiment': 'NEUTRAL', 'confidence': 0.8565942049026489, 'speaker': 'A'}, {'text': 'That happens when you have around a predictable environment and you do so by building prior expectation.', 'start': 2203820, 'end': 2216088, 'sentiment': 'NEUTRAL', 'confidence': 0.7910379767417908, 'speaker': 'A'}, {'text': 'So you have to keep your body in a certain position of posture.', 'start': 2216264, 'end': 2219980, 'sentiment': 'NEUTRAL', 'confidence': 0.8601940274238586, 'speaker': 'A'}, {'text': 'As you say in this image, the person is seated with a very straight, not very, but a straight back relaxed.', 'start': 2220060, 'end': 2229904, 'sentiment': 'NEUTRAL', 'confidence': 0.8014756441116333, 'speaker': 'A'}, {'text': 'This is very important meditation, banded legs and so on.', 'start': 2229952, 'end': 2233670, 'sentiment': 'POSITIVE', 'confidence': 0.6963526606559753, 'speaker': 'A'}, {'text': 'And then you need at least in the most part of your practice, you need safe predictable environments with temperature that enables you to maintain your homostatic processes.', 'start': 2234360, 'end': 2249400, 'sentiment': 'NEUTRAL', 'confidence': 0.6814624667167664, 'speaker': 'A'}, {'text': 'So all these conditions are necessary for your successful homostatic self regulation.', 'start': 2250860, 'end': 2256120, 'sentiment': 'NEUTRAL', 'confidence': 0.8105589747428894, 'speaker': 'A'}, {'text': 'In this sense when parts of preparation to enter then after the state of confrontation, the meditator can let go and leave behind self related processes and process the body transported or it can attenuate them attenuate the body can be attenuated.', 'start': 2257180, 'end': 2280240, 'sentiment': 'NEUTRAL', 'confidence': 0.8175309300422668, 'speaker': 'A'}, {'text': 'So our claim is that a transfer essential self and body may underline the phenomenology of losing oneself and blurring body boundaries as reported during meditative states.', 'start': 2281620, 'end': 2294790, 'sentiment': 'NEUTRAL', 'confidence': 0.8388816714286804, 'speaker': 'A'}, {'text': 'So our conclusion is that we have proposed a shift in focus on homostatic body self regulation in examining deep meditative states.', 'start': 2297820, 'end': 2306970, 'sentiment': 'NEUTRAL', 'confidence': 0.8311262726783752, 'speaker': 'A'}, {'text': 'The experience of having a body living self organism biological system is never lost in this process.', 'start': 2308140, 'end': 2314750, 'sentiment': 'NEUTRAL', 'confidence': 0.5672141909599304, 'speaker': 'A'}, {'text': 'Rather it stay transferred at its very center, self attenuated yet very much present and hands alive.', 'start': 2315280, 'end': 2323200, 'sentiment': 'NEUTRAL', 'confidence': 0.7470241189002991, 'speaker': 'A'}, {'text': 'So that the self model is attenuated to become transparent and hands processed in the background.', 'start': 2323780, 'end': 2330480, 'sentiment': 'NEUTRAL', 'confidence': 0.8048401474952698, 'speaker': 'A'}, {'text': "Now giving this conclusion now I'm going to present related project.", 'start': 2331720, 'end': 2335860, 'sentiment': 'NEUTRAL', 'confidence': 0.8557021021842957, 'speaker': 'A'}, {'text': 'The first one is still on the theoretical side.', 'start': 2336010, 'end': 2342068, 'sentiment': 'NEUTRAL', 'confidence': 0.8411710858345032, 'speaker': 'A'}, {'text': 'So we are in the realm of active inference model in meditation research.', 'start': 2342234, 'end': 2346616, 'sentiment': 'NEUTRAL', 'confidence': 0.7023276090621948, 'speaker': 'A'}, {'text': 'There is a radio literature about that that have studied different kinds of meditation techniques like focused attention, open monitoring, nondual awareness and they all study from Laconin in 2023 or Laconin and Lactar in 2021.', 'start': 2346798, 'end': 2375330, 'sentiment': 'NEUTRAL', 'confidence': 0.8861462473869324, 'speaker': 'A'}, {'text': 'They have for example showed that these attention techniques profoundly alter typical mental experiences and for example focus meditation is meditation that engage attention on one specific object experience.', 'start': 2376900, 'end': 2399512, 'sentiment': 'NEUTRAL', 'confidence': 0.7114449739456177, 'speaker': 'A'}, {'text': "For example the breath and in active inference term it means that precision is estimated one sensory input which means that it reduce the impact of the other thoughts and parallel processes that are going on or often open monitoring meditation is the engaging of attention to one's experience as a whole.", 'start': 2399646, 'end': 2425792, 'sentiment': 'NEUTRAL', 'confidence': 0.7682491540908813, 'speaker': 'A'}, {'text': 'So the whole stream of experience without selecting anything in particular.', 'start': 2425846, 'end': 2431090, 'sentiment': 'NEUTRAL', 'confidence': 0.8640206456184387, 'speaker': 'A'}, {'text': 'So that in an activatory terms it has been described as assigning equal precision to all these experiencing promoting non reactive sensing.', 'start': 2431540, 'end': 2443936, 'sentiment': 'NEUTRAL', 'confidence': 0.8551585674285889, 'speaker': 'A'}, {'text': 'And this is connected also why medicine are good in self regulated regulate pain.', 'start': 2443968, 'end': 2451290, 'sentiment': 'POSITIVE', 'confidence': 0.5976241230964661, 'speaker': 'A'}, {'text': 'So we will also build our model on self modeling based on the previous literature which is integration.', 'start': 2453100, 'end': 2465500, 'sentiment': 'NEUTRAL', 'confidence': 0.6471849083900452, 'speaker': 'A'}, {'text': "And then going experimental we want to bring into the table application of what we're researching and potential benefit may be for cases of people or individual that suffer from disrupted body awareness or disrupted self awareness.", 'start': 2467600, 'end': 2490660, 'sentiment': 'NEUTRAL', 'confidence': 0.7430045008659363, 'speaker': 'A'}, {'text': 'And there is a relatively recent condition that has been studied that is depersonalization.', 'start': 2491000, 'end': 2501880, 'sentiment': 'NEUTRAL', 'confidence': 0.8669998645782471, 'speaker': 'A'}, {'text': "So depersonization is the disruption of both body and self awareness and it's a very heterogeneous condition, there is a lot of different dimensions that occurs but generally it's connected with feelings of heaviness disconnection feeling the body as an object, rather they're a transfer and medium of experience which simply is called disembodiment.", 'start': 2502780, 'end': 2533140, 'sentiment': 'NEUTRAL', 'confidence': 0.5282025933265686, 'speaker': 'A'}, {'text': 'It is linked with difficulties in concentration and attention, often comorbid with depression, rumination and anxiety.', 'start': 2533960, 'end': 2542580, 'sentiment': 'NEGATIVE', 'confidence': 0.8435885906219482, 'speaker': 'A'}, {'text': 'And recently Chow Nuka and colleagues has also proposed AIDS characterized by failures in attenuating somatosentry signals.', 'start': 2543000, 'end': 2552760, 'sentiment': 'NEUTRAL', 'confidence': 0.6216839551925659, 'speaker': 'A'}, {'text': 'So based on what we have previously said and based on how this condition affects large number of population, we want to test certain hypotheses.', 'start': 2553980, 'end': 2571680, 'sentiment': 'NEUTRAL', 'confidence': 0.9126663208007812, 'speaker': 'A'}, {'text': 'So the first one would be that higher somasocentric attenuation Correlate with more feeling of aliveness and wide openness in experienced meditators and rather lowest somascentric attenuation Correlate with feelings of unrealness thatness in people experience deeper solidation.', 'start': 2572580, 'end': 2591860, 'sentiment': 'NEUTRAL', 'confidence': 0.7770637273788452, 'speaker': 'A'}, {'text': 'And on the other hand, severe homostatic dysregulation of bodily states during deep meditative states may lead to negative emotional outcomes and Abernant self experience.', 'start': 2593420, 'end': 2604424, 'sentiment': 'NEGATIVE', 'confidence': 0.8948320746421814, 'speaker': 'A'}, {'text': "This comes from to the fact that depression and meditation can both create stressing negative outcomes and it's interesting to see how this happened and what are the commonalities and differences in that.", 'start': 2604622, 'end': 2626050, 'sentiment': 'NEUTRAL', 'confidence': 0.6868047714233398, 'speaker': 'A'}, {'text': 'And also we have dealt in the realm of spatial temporal perception which is connected also with mood disorders or like depression and anxiety and also with depersonalization.', 'start': 2626980, 'end': 2641460, 'sentiment': 'NEUTRAL', 'confidence': 0.6032341718673706, 'speaker': 'A'}, {'text': 'However, in depersonalization there is no specific items in the questionnaire that is usually used for measuring which is the Cambridge Depressionization scale.', 'start': 2642520, 'end': 2655792, 'sentiment': 'NEUTRAL', 'confidence': 0.6903941631317139, 'speaker': 'A'}, {'text': 'So we want to test this as well and we want to test it in people reporting selfless and disembodied experience so both pathological and non pathological conditions.', 'start': 2655876, 'end': 2668780, 'sentiment': 'NEUTRAL', 'confidence': 0.8391556739807129, 'speaker': 'A'}, {'text': 'So part of this hypothesis we are really going through this is our team coming from Humboldt University where I come from as well Simon Wendelman, but also University College London with Ines and Joseph first study is as I said about.', 'start': 2670180, 'end': 2690564, 'sentiment': 'NEUTRAL', 'confidence': 0.9043063521385193, 'speaker': 'A'}, {'text': 'Time perspective.', 'start': 2690602, 'end': 2691600, 'sentiment': 'NEUTRAL', 'confidence': 0.8148172497749329, 'speaker': 'A'}, {'text': 'So we want to analyze how people with high traits of depression correlate with dimension of the time perspective so they are more future oriented or more negative oriented.', 'start': 2691680, 'end': 2707880, 'sentiment': 'NEGATIVE', 'confidence': 0.5746159553527832, 'speaker': 'A'}, {'text': "Our hypothesis that they're more negative past oriented so they're stuck in a very long present moment, but also they're the tendency of ruminating.", 'start': 2707960, 'end': 2727420, 'sentiment': 'NEUTRAL', 'confidence': 0.5612678527832031, 'speaker': 'A'}, {'text': 'So always going to past negative memories.', 'start': 2727500, 'end': 2730560, 'sentiment': 'NEGATIVE', 'confidence': 0.7603371739387512, 'speaker': 'A'}, {'text': "Since this is titled Last in Dark Times the Effect of the Personalization Experience in on Time Perspective And these we are already in the analysis of the data but it's an ongoing steel study.", 'start': 2732920, 'end': 2750424, 'sentiment': 'NEUTRAL', 'confidence': 0.9026183485984802, 'speaker': 'A'}, {'text': 'So we have preliminary data on this.', 'start': 2750622, 'end': 2753930, 'sentiment': 'NEUTRAL', 'confidence': 0.908764123916626, 'speaker': 'A'}, {'text': 'While studies too we are in the recruitment phases but we are almost there and encompass the high traits of people individual into high traits of depression and meditators.', 'start': 2755340, 'end': 2769308, 'sentiment': 'NEUTRAL', 'confidence': 0.7323302626609802, 'speaker': 'A'}, {'text': 'I want to see through a set of questionnaires and a behavioral task how they may differ in the sense of self, body and motion.', 'start': 2769484, 'end': 2780444, 'sentiment': 'NEUTRAL', 'confidence': 0.8958925008773804, 'speaker': 'A'}, {'text': 'Of course, they are very wide and concepts so there is always room for feedback and replications and so on.', 'start': 2780492, 'end': 2791430, 'sentiment': 'NEUTRAL', 'confidence': 0.6300193667411804, 'speaker': 'A'}, {'text': 'We have selected these tasks, the embody tasks adopted from new menma where individual participants has to color parts of the body in relation to activation that they feel by reading certain emotional story.', 'start': 2795240, 'end': 2815390, 'sentiment': 'NEUTRAL', 'confidence': 0.913615882396698, 'speaker': 'A'}, {'text': 'So these stories are supposed to validate it to elicit certain emotions in the body and then people colors parts of the body.', 'start': 2816000, 'end': 2825820, 'sentiment': 'NEUTRAL', 'confidence': 0.7271321415901184, 'speaker': 'A'}, {'text': 'And then we will see how people with hydrates and the visualization may say will differ in this.', 'start': 2825890, 'end': 2832820, 'sentiment': 'NEUTRAL', 'confidence': 0.8804616332054138, 'speaker': 'A'}, {'text': 'And we will also compare with other questionnaires that we have put this and potential title is emotional Body Maps of Thought Detachment, Interpersonalization and Meditation.', 'start': 2832890, 'end': 2845400, 'sentiment': 'NEUTRAL', 'confidence': 0.9057651162147522, 'speaker': 'A'}, {'text': "And with this I thank you all and that's it.", 'start': 2845820, 'end': 2850344, 'sentiment': 'POSITIVE', 'confidence': 0.9569972157478333, 'speaker': 'A'}, {'text': 'We are open for discussion.', 'start': 2850462, 'end': 2852708, 'sentiment': 'NEUTRAL', 'confidence': 0.6092597246170044, 'speaker': 'A'}, {'text': 'Thank you.', 'start': 2852804, 'end': 2853690, 'sentiment': 'POSITIVE', 'confidence': 0.8529649376869202, 'speaker': 'A'}, {'text': 'Awesome.', 'start': 2858480, 'end': 2859324, 'sentiment': 'POSITIVE', 'confidence': 0.9184247851371765, 'speaker': 'B'}, {'text': 'Thank you very much.', 'start': 2859522, 'end': 2860444, 'sentiment': 'POSITIVE', 'confidence': 0.9599630236625671, 'speaker': 'B'}, {'text': 'Valeria, you are muted.', 'start': 2860482, 'end': 2862904, 'sentiment': 'NEGATIVE', 'confidence': 0.6823930144309998, 'speaker': 'A'}, {'text': 'Donna.', 'start': 2862952, 'end': 2863740, 'sentiment': 'NEUTRAL', 'confidence': 0.667864203453064, 'speaker': 'C'}, {'text': 'Thank you.', 'start': 2864400, 'end': 2864876, 'sentiment': 'POSITIVE', 'confidence': 0.8529649376869202, 'speaker': 'D'}, {'text': 'Valeria.', 'start': 2864898, 'end': 2865740, 'sentiment': 'NEUTRAL', 'confidence': 0.6035107970237732, 'speaker': 'B'}, {'text': 'Great.', 'start': 2866160, 'end': 2866910, 'sentiment': 'POSITIVE', 'confidence': 0.7671424746513367, 'speaker': 'B'}, {'text': 'Well, very fascinating presentation.', 'start': 2867680, 'end': 2872720, 'sentiment': 'POSITIVE', 'confidence': 0.9534658789634705, 'speaker': 'B'}, {'text': 'Perhaps Anna first and then our other colleagues who have joined.', 'start': 2873140, 'end': 2877212, 'sentiment': 'NEUTRAL', 'confidence': 0.8862791061401367, 'speaker': 'B'}, {'text': 'Would be awesome to hear your path to be here on this work and any reflection or questions you have on it.', 'start': 2877276, 'end': 2885990, 'sentiment': 'POSITIVE', 'confidence': 0.9497033357620239, 'speaker': 'B'}, {'text': 'Is it my turn?', 'start': 2890020, 'end': 2891360, 'sentiment': 'NEUTRAL', 'confidence': 0.8790724873542786, 'speaker': 'C'}, {'text': 'Sure.', 'start': 2891510, 'end': 2891872, 'sentiment': 'NEUTRAL', 'confidence': 0.4753468334674835, 'speaker': 'B'}, {'text': 'Did I miss?', 'start': 2891926, 'end': 2892720, 'sentiment': 'NEUTRAL', 'confidence': 0.5952695608139038, 'speaker': 'C'}, {'text': 'Yeah.', 'start': 2892870, 'end': 2893570, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'C'}, {'text': "So obviously I don't have many questions because it's like we wrote this together.", 'start': 2895380, 'end': 2900790, 'sentiment': 'NEUTRAL', 'confidence': 0.5610132813453674, 'speaker': 'C'}, {'text': 'But I think what I would like just to add not really a question is I really like to see so for instance like in ideal world would be nice to get all the traditions of the meditative experiences and how they relate to the body and make a very precise prediction on what exactly they will kind of predict in terms of certain sensory experiences and how this can be interpreted through different theoretical lenses.', 'start': 2902680, 'end': 2948604, 'sentiment': 'POSITIVE', 'confidence': 0.5058069825172424, 'speaker': 'C'}, {'text': 'I think that could be really interesting because I think one of the problems, the challenges that we have right now is that we have so many concepts, so many approaches and kind of, like, scattered all over the map, and I think would be really nice to narrow down, because, as you said, Daniel so everybody knows what meditation is.', 'start': 2948652, 'end': 2972812, 'sentiment': 'POSITIVE', 'confidence': 0.6331658363342285, 'speaker': 'C'}, {'text': "Everybody knows at least one person that meditates in life and everything, but it's really unclear what exactly we are after and why.", 'start': 2972946, 'end': 2983724, 'sentiment': 'NEUTRAL', 'confidence': 0.7313623428344727, 'speaker': 'C'}, {'text': 'In certain cases, this is kind of like beneficial, and in other cases, basically it has negative consequences.', 'start': 2983762, 'end': 2992172, 'sentiment': 'NEGATIVE', 'confidence': 0.487712025642395, 'speaker': 'C'}, {'text': 'And this is why precisely we are doing this project on depersonalization and meditation.', 'start': 2992236, 'end': 2998960, 'sentiment': 'NEUTRAL', 'confidence': 0.7891658544540405, 'speaker': 'C'}, {'text': 'And I can share with you informally, Scoop, but data is here, so we kind of like can share with.', 'start': 2999120, 'end': 3007190, 'sentiment': 'NEUTRAL', 'confidence': 0.5225207805633545, 'speaker': 'C'}, {'text': "So what we did in this project, basically we took people with typical controls that don't have depersonalization and never meditated.", 'start': 3007560, 'end': 3015092, 'sentiment': 'NEUTRAL', 'confidence': 0.6178070306777954, 'speaker': 'C'}, {'text': 'Right?', 'start': 3015156, 'end': 3015384, 'sentiment': 'NEUTRAL', 'confidence': 0.7360090017318726, 'speaker': 'A'}, {'text': "So it's kind of like, yeah, never did that.", 'start': 3015422, 'end': 3018216, 'sentiment': 'NEUTRAL', 'confidence': 0.6423407793045044, 'speaker': 'C'}, {'text': 'And then we took people that meditated, and then we looked at whether they have kind of like high or low traits of depersonization.', 'start': 3018318, 'end': 3027160, 'sentiment': 'NEUTRAL', 'confidence': 0.8660998344421387, 'speaker': 'C'}, {'text': 'And then we took people with depersonization that never meditate.', 'start': 3027240, 'end': 3031240, 'sentiment': 'NEGATIVE', 'confidence': 0.6499007940292358, 'speaker': 'C'}, {'text': 'Right.', 'start': 3031320, 'end': 3031950, 'sentiment': 'NEUTRAL', 'confidence': 0.5664745569229126, 'speaker': 'C'}, {'text': "So we have this inclusion and exclusion criteria and yeah, it's really interesting to find what our findings is.", 'start': 3034240, 'end': 3042640, 'sentiment': 'POSITIVE', 'confidence': 0.8316320776939392, 'speaker': 'C'}, {'text': "It's really difficult to find people that have experience and low depersonalization skills, low depersonization traits.", 'start': 3042710, 'end': 3053104, 'sentiment': 'NEGATIVE', 'confidence': 0.73451828956604, 'speaker': 'C'}, {'text': 'Right.', 'start': 3053152, 'end': 3053652, 'sentiment': 'NEUTRAL', 'confidence': 0.5664745569229126, 'speaker': 'A'}, {'text': 'So most of them, they actually have high depersonalization.', 'start': 3053786, 'end': 3057760, 'sentiment': 'NEUTRAL', 'confidence': 0.6274110078811646, 'speaker': 'C'}, {'text': "But then it's interesting to see how that contrasts with the people that have depersonalization and no vegetation experience.", 'start': 3057840, 'end': 3064264, 'sentiment': 'NEUTRAL', 'confidence': 0.7151615023612976, 'speaker': 'C'}, {'text': 'Right.', 'start': 3064382, 'end': 3065050, 'sentiment': 'NEUTRAL', 'confidence': 0.5664745569229126, 'speaker': 'C'}, {'text': "So that's something I would like to carry on to reach the community.", 'start': 3065900, 'end': 3073850, 'sentiment': 'POSITIVE', 'confidence': 0.7858002781867981, 'speaker': 'C'}, {'text': "That's something we'll definitely carry on with.", 'start': 3076700, 'end': 3079016, 'sentiment': 'POSITIVE', 'confidence': 0.7779548168182373, 'speaker': 'C'}, {'text': 'Valerian the next steps and also with some people that I have here in the chat, julia and Simone.', 'start': 3079118, 'end': 3086640, 'sentiment': 'NEUTRAL', 'confidence': 0.8882309794425964, 'speaker': 'C'}, {'text': 'So Simone will going to work with us on also.', 'start': 3087220, 'end': 3090080, 'sentiment': 'NEUTRAL', 'confidence': 0.7880812287330627, 'speaker': 'C'}, {'text': 'Somatosensory attenuation through different have some without scooping.', 'start': 3090150, 'end': 3097504, 'sentiment': 'NEUTRAL', 'confidence': 0.8419656157493591, 'speaker': 'C'}, {'text': 'We have also some very interesting results coming up.', 'start': 3097552, 'end': 3101190, 'sentiment': 'POSITIVE', 'confidence': 0.9724631309509277, 'speaker': 'C'}, {'text': 'We just finished data collection on intentional binding and depersonization.', 'start': 3101720, 'end': 3105408, 'sentiment': 'NEUTRAL', 'confidence': 0.8808779716491699, 'speaker': 'C'}, {'text': 'So related to the sense of agency.', 'start': 3105504, 'end': 3108420, 'sentiment': 'NEUTRAL', 'confidence': 0.8130902051925659, 'speaker': 'C'}, {'text': "That's all for me for now.", 'start': 3110120, 'end': 3114104, 'sentiment': 'NEUTRAL', 'confidence': 0.653163492679596, 'speaker': 'C'}, {'text': "We're kind of like in between because Valerie represented very well, like the theory part and the studies are literally just getting hot from the oven now.", 'start': 3114142, 'end': 3124780, 'sentiment': 'POSITIVE', 'confidence': 0.5251573324203491, 'speaker': 'C'}, {'text': "And we hope that in September it's like we're going to get them out.", 'start': 3124850, 'end': 3130284, 'sentiment': 'NEUTRAL', 'confidence': 0.5437908172607422, 'speaker': 'C'}, {'text': "Yeah, but the data is in the box, so that's very exciting and yeah, we have the results.", 'start': 3130402, 'end': 3135920, 'sentiment': 'POSITIVE', 'confidence': 0.9768661856651306, 'speaker': 'C'}, {'text': 'Thank you, Danielle, again for this platform.', 'start': 3137860, 'end': 3140368, 'sentiment': 'POSITIVE', 'confidence': 0.9849737882614136, 'speaker': 'C'}, {'text': "It's really nice.", 'start': 3140454, 'end': 3141104, 'sentiment': 'POSITIVE', 'confidence': 0.9820848107337952, 'speaker': 'C'}, {'text': "And as I said, I really hope that after this discussion, we'll have more opportunities to change, exchange and discuss.", 'start': 3141142, 'end': 3152228, 'sentiment': 'POSITIVE', 'confidence': 0.8846744894981384, 'speaker': 'C'}, {'text': 'We also plan to organize something around alteration of self consciousness across various conditions and also decarbonization in Lisbon next year.', 'start': 3152314, 'end': 3162504, 'sentiment': 'NEUTRAL', 'confidence': 0.8348001837730408, 'speaker': 'C'}, {'text': 'So maybe you can cross the pond and check for yourself that we have a nice airport in Lisbon.', 'start': 3162542, 'end': 3168948, 'sentiment': 'POSITIVE', 'confidence': 0.8191070556640625, 'speaker': 'C'}, {'text': 'Yeah.', 'start': 3169044, 'end': 3169690, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'C'}, {'text': 'Cool.', 'start': 3171600, 'end': 3171964, 'sentiment': 'POSITIVE', 'confidence': 0.84200119972229, 'speaker': 'A'}, {'text': 'Well, good to get the appetizer before the entree.', 'start': 3172002, 'end': 3175608, 'sentiment': 'POSITIVE', 'confidence': 0.918231725692749, 'speaker': 'B'}, {'text': "So that's very awesome about just how much theory and even unconventional scientific theory, like world knowledge traditions come into play and then what it looks like to take that experimental step to make it scientific is definitely what I saw in the talk.", 'start': 3175704, 'end': 3194770, 'sentiment': 'POSITIVE', 'confidence': 0.96059650182724, 'speaker': 'B'}, {'text': 'Julia or Simone, do you want to give any reflection or any thoughts or questions?', 'start': 3195540, 'end': 3200630, 'sentiment': 'NEUTRAL', 'confidence': 0.9106430411338806, 'speaker': 'B'}, {'text': 'Yes.', 'start': 3201240, 'end': 3201990, 'sentiment': 'POSITIVE', 'confidence': 0.46103888750076294, 'speaker': 'D'}, {'text': 'Can you hear me?', 'start': 3202520, 'end': 3203476, 'sentiment': 'NEUTRAL', 'confidence': 0.8097810745239258, 'speaker': 'D'}, {'text': 'Yes.', 'start': 3203578, 'end': 3204230, 'sentiment': 'POSITIVE', 'confidence': 0.46103888750076294, 'speaker': 'B'}, {'text': 'I actually have three questions I noted down.', 'start': 3205000, 'end': 3207990, 'sentiment': 'NEUTRAL', 'confidence': 0.7735361456871033, 'speaker': 'D'}, {'text': "I think the first one because it's just for me personally, I'm curious about that is that those deep meditative selfless states I think that can also be reached while doing yoga, right?", 'start': 3209080, 'end': 3220650, 'sentiment': 'NEUTRAL', 'confidence': 0.7104967832565308, 'speaker': 'D'}, {'text': 'Basically the opposite of sitting still.', 'start': 3221260, 'end': 3223784, 'sentiment': 'NEGATIVE', 'confidence': 0.6449523568153381, 'speaker': 'D'}, {'text': "It's like a sort of repetitive movement actually.", 'start': 3223822, 'end': 3226520, 'sentiment': 'NEUTRAL', 'confidence': 0.6996194124221802, 'speaker': 'D'}, {'text': "So I'm wondering do those movements have to be perfectly predictable in order to be attenuated and then reaching the same state?", 'start': 3226670, 'end': 3233192, 'sentiment': 'NEUTRAL', 'confidence': 0.763849139213562, 'speaker': 'D'}, {'text': 'Or is that like a different different concept or how do you put that in your framework?', 'start': 3233246, 'end': 3240160, 'sentiment': 'NEUTRAL', 'confidence': 0.8331205248832703, 'speaker': 'D'}, {'text': 'I think here you brought mainly two topics.', 'start': 3244500, 'end': 3251296, 'sentiment': 'NEUTRAL', 'confidence': 0.8531484007835388, 'speaker': 'A'}, {'text': 'One is, is it possible to reach deep matter states also not sitting in a still position?', 'start': 3251408, 'end': 3258980, 'sentiment': 'NEUTRAL', 'confidence': 0.8774272203445435, 'speaker': 'A'}, {'text': 'And the answer is yes.', 'start': 3259050, 'end': 3260490, 'sentiment': 'POSITIVE', 'confidence': 0.6056202054023743, 'speaker': 'A'}, {'text': 'However, there is not so much research on that.', 'start': 3263820, 'end': 3266216, 'sentiment': 'NEUTRAL', 'confidence': 0.6213877201080322, 'speaker': 'A'}, {'text': 'So I can talk about anecdotal knowledge, but I did not read so much about walking meditation effect, usually walking meditation or of course you talk about yoga.', 'start': 3266318, 'end': 3282120, 'sentiment': 'NEUTRAL', 'confidence': 0.6822840571403503, 'speaker': 'A'}, {'text': "I know, but that's what I would say, that walking meditation is used as a complementary practice through the sitting.", 'start': 3282200, 'end': 3291520, 'sentiment': 'NEUTRAL', 'confidence': 0.8838437795639038, 'speaker': 'A'}, {'text': "So I would say it's hard to reach deep meditative states only by walking meditation.", 'start': 3292260, 'end': 3299140, 'sentiment': 'NEUTRAL', 'confidence': 0.5602223873138428, 'speaker': 'A'}, {'text': 'In regarding to yoga, also yoga means unity.', 'start': 3302200, 'end': 3306176, 'sentiment': 'NEUTRAL', 'confidence': 0.5497074127197266, 'speaker': 'A'}, {'text': "So what we think about yoga now, we think about movement, but it's always accompanied by reaching state of concentration through meditation.", 'start': 3306368, 'end': 3319480, 'sentiment': 'NEUTRAL', 'confidence': 0.8982753157615662, 'speaker': 'A'}, {'text': "So you cannot have yoga without meditation, otherwise you'll be stretching or pilates.", 'start': 3320540, 'end': 3325980, 'sentiment': 'NEUTRAL', 'confidence': 0.7174904346466064, 'speaker': 'A'}, {'text': "But second topic is that can it happen when you don't have prediction of movement?", 'start': 3326720, 'end': 3336560, 'sentiment': 'NEUTRAL', 'confidence': 0.7300437092781067, 'speaker': 'A'}, {'text': 'Right?', 'start': 3337300, 'end': 3338096, 'sentiment': 'NEUTRAL', 'confidence': 0.7360090017318726, 'speaker': 'A'}, {'text': "No, I meant like because in yoga at least I don't really do yoga, right?", 'start': 3338278, 'end': 3342096, 'sentiment': 'NEUTRAL', 'confidence': 0.6784412860870361, 'speaker': 'D'}, {'text': 'But I can imagine that when people reach those states doing yoga, then they kind of do it almost like in a trance type of way.', 'start': 3342118, 'end': 3350096, 'sentiment': 'NEUTRAL', 'confidence': 0.8990586996078491, 'speaker': 'D'}, {'text': "They're always doing the same movement over and over and over again so that they don't have to attend to those movements.", 'start': 3350118, 'end': 3354704, 'sentiment': 'NEUTRAL', 'confidence': 0.5143271684646606, 'speaker': 'D'}, {'text': "But it's just like an automatic process.", 'start': 3354752, 'end': 3356532, 'sentiment': 'NEUTRAL', 'confidence': 0.5459858775138855, 'speaker': 'D'}, {'text': 'I was wondering if that also can I jump in?', 'start': 3356586, 'end': 3360950, 'sentiment': 'NEUTRAL', 'confidence': 0.8735935688018799, 'speaker': 'D'}, {'text': 'Actually, this is precisely the opposite.', 'start': 3361880, 'end': 3364200, 'sentiment': 'NEGATIVE', 'confidence': 0.6383523344993591, 'speaker': 'C'}, {'text': 'What Valerie was saying is so Valerie was saying this is precisely the opposite.', 'start': 3364620, 'end': 3369156, 'sentiment': 'NEUTRAL', 'confidence': 0.5975699424743652, 'speaker': 'C'}, {'text': 'You want to reach through yoga just like the opposite of automatic.', 'start': 3369188, 'end': 3372360, 'sentiment': 'NEUTRAL', 'confidence': 0.8164022564888, 'speaker': 'C'}, {'text': 'So basically when you do this movements, you need to be united with yourself doing it.', 'start': 3372800, 'end': 3379292, 'sentiment': 'NEUTRAL', 'confidence': 0.7750889658927917, 'speaker': 'C'}, {'text': "So you really need to I'm doing yoga so the past ten years and precisely this is like they're trying to tell us don't do it on automatic.", 'start': 3379346, 'end': 3394492, 'sentiment': 'NEUTRAL', 'confidence': 0.6388594508171082, 'speaker': 'C'}, {'text': "Because it's like when you have your thinking happening there and your body is doing some stuff there, right.", 'start': 3394556, 'end': 3399652, 'sentiment': 'NEUTRAL', 'confidence': 0.849440336227417, 'speaker': 'C'}, {'text': 'You need to basically be presence in every single type of moon.', 'start': 3399786, 'end': 3403808, 'sentiment': 'NEUTRAL', 'confidence': 0.8646024465560913, 'speaker': 'C'}, {'text': "So you have like fully, fully presence if you do it automatically, that's more like gymnastic or something.", 'start': 3403824, 'end': 3410470, 'sentiment': 'NEUTRAL', 'confidence': 0.7743488550186157, 'speaker': 'C'}, {'text': "But it's interesting.", 'start': 3411720, 'end': 3413152, 'sentiment': 'POSITIVE', 'confidence': 0.6864383816719055, 'speaker': 'C'}, {'text': 'So your point is really interesting because then would be really nice to have a control condition where we have people doing like movement, meditation and yoga and then contrast with the phenomena of some other sense retenuation and whether they have what type of embodiment and disembodiment and gentivity experiences they have.', 'start': 3413306, 'end': 3433950, 'sentiment': 'POSITIVE', 'confidence': 0.657956063747406, 'speaker': 'C'}, {'text': "Okay, I don't know exactly what I was trying to get it.", 'start': 3436960, 'end': 3440384, 'sentiment': 'NEUTRAL', 'confidence': 0.5652814507484436, 'speaker': 'D'}, {'text': 'But I think it was also more related to because you said that when meditating you have to sort of let yourself letting go.', 'start': 3440502, 'end': 3447888, 'sentiment': 'NEUTRAL', 'confidence': 0.8381851315498352, 'speaker': 'D'}, {'text': 'Letting go, exactly.', 'start': 3448054, 'end': 3448864, 'sentiment': 'NEUTRAL', 'confidence': 0.778684139251709, 'speaker': 'D'}, {'text': 'And the idea is that everything has to be perfectly sort of predictable, right?', 'start': 3448902, 'end': 3452660, 'sentiment': 'NEUTRAL', 'confidence': 0.550024151802063, 'speaker': 'D'}, {'text': "That's the idea behind it.", 'start': 3452730, 'end': 3454148, 'sentiment': 'NEUTRAL', 'confidence': 0.8018485903739929, 'speaker': 'D'}, {'text': "So then I'm thinking so within yoga, don't you have to do the exact same movements in order for it to be predictable, in order for you to let go and not overatten to the environment?", 'start': 3454234, 'end': 3466356, 'sentiment': 'NEUTRAL', 'confidence': 0.8597722053527832, 'speaker': 'D'}, {'text': 'Does that make sense?', 'start': 3466468, 'end': 3467690, 'sentiment': 'NEUTRAL', 'confidence': 0.7228710055351257, 'speaker': 'D'}, {'text': "I thought when we both and Simon were speaking I think on one side you, Simon, maybe you're referring to the implicit procedural knowledge that you can acquire through yoga and you, Ana, are talking about doing things without being aware, which is also automatic and left.", 'start': 3470460, 'end': 3495984, 'sentiment': 'NEUTRAL', 'confidence': 0.794474184513092, 'speaker': 'A'}, {'text': 'And you both are right, I think in this because on one Anna, you would say like if you do yoga, you learn how to do yoga, right?', 'start': 3496102, 'end': 3506004, 'sentiment': 'NEUTRAL', 'confidence': 0.7558904886245728, 'speaker': 'A'}, {'text': 'So you learn how to move yourself in this way so that when you do a certain position that you have to arrange your body and for arrange your dirty, you always have to keep monitoring yourself.', 'start': 3506122, 'end': 3521256, 'sentiment': 'NEUTRAL', 'confidence': 0.8288353681564331, 'speaker': 'A'}, {'text': 'So there is a continuous going back to your body, keeping track of your body and continue to monitor yourself.', 'start': 3521358, 'end': 3529996, 'sentiment': 'NEUTRAL', 'confidence': 0.9040124416351318, 'speaker': 'A'}, {'text': 'But in this way because you have learned to do this going back and being aware on yourself.', 'start': 3530178, 'end': 3538736, 'sentiment': 'NEUTRAL', 'confidence': 0.7410842180252075, 'speaker': 'A'}, {'text': "And this comes also when you do your movement, you have learned that certain posture are made in a certain way so that it becomes more or less predictable actually what you're going to do.", 'start': 3538838, 'end': 3551364, 'sentiment': 'NEUTRAL', 'confidence': 0.8135794401168823, 'speaker': 'A'}, {'text': 'Right.', 'start': 3551482, 'end': 3551812, 'sentiment': 'NEUTRAL', 'confidence': 0.5664745569229126, 'speaker': 'A'}, {'text': "But it doesn't mean that you don't have to be awareness and actually there is a trick ribbon here because you're very attentive with what's going on but at the same time the more you're attentive, the more somatosensory attenuation may happen.", 'start': 3551866, 'end': 3567384, 'sentiment': 'NEUTRAL', 'confidence': 0.6854462027549744, 'speaker': 'A'}, {'text': "And actually it's what we are trying to argue in our active inference model.", 'start': 3567502, 'end': 3572510, 'sentiment': 'NEUTRAL', 'confidence': 0.8715866208076477, 'speaker': 'A'}, {'text': "The more predictable it gets, the more it gets attenuated, but doesn't mean that you're not aware.", 'start': 3573600, 'end': 3579660, 'sentiment': 'NEGATIVE', 'confidence': 0.664010226726532, 'speaker': 'A'}, {'text': 'Thank you for this input because it helps us elaborate this.', 'start': 3582640, 'end': 3586828, 'sentiment': 'POSITIVE', 'confidence': 0.9490835666656494, 'speaker': 'A'}, {'text': "I think it's super interesting because it's like when you look at people that climb or surf or whatever, any type of sports, right?", 'start': 3586914, 'end': 3594240, 'sentiment': 'POSITIVE', 'confidence': 0.9512084126472473, 'speaker': 'D'}, {'text': 'In the beginning, in order to learn the skill, you have to put a lot of attention to the individual movements but then later on, in order to actually be good at it, you have to take the attention away.', 'start': 3594310, 'end': 3602004, 'sentiment': 'NEUTRAL', 'confidence': 0.6552039980888367, 'speaker': 'D'}, {'text': "And then in those moments is when the people report that they're actually feeling sort of selfless states and these flow is when the movements are internalized, so to speak.", 'start': 3602122, 'end': 3612024, 'sentiment': 'NEUTRAL', 'confidence': 0.8756025433540344, 'speaker': 'D'}, {'text': "I think that's super interesting.", 'start': 3612142, 'end': 3613944, 'sentiment': 'POSITIVE', 'confidence': 0.9814318418502808, 'speaker': 'D'}, {'text': 'Can I just shoot the other two questions I had?', 'start': 3614142, 'end': 3616024, 'sentiment': 'NEUTRAL', 'confidence': 0.8001949191093445, 'speaker': 'D'}, {'text': "They're sort of different or should we go to Julia first?", 'start': 3616062, 'end': 3619544, 'sentiment': 'NEUTRAL', 'confidence': 0.8690217733383179, 'speaker': 'D'}, {'text': "Maybe it's Julia.", 'start': 3619742, 'end': 3621160, 'sentiment': 'NEUTRAL', 'confidence': 0.7917411923408508, 'speaker': 'A'}, {'text': 'Hi, sorry.', 'start': 3624460, 'end': 3625384, 'sentiment': 'NEGATIVE', 'confidence': 0.6114868521690369, 'speaker': 'E'}, {'text': "Yeah, sorry for the lighting and sorry because I'm in the lab, so it's probably not the best position.", 'start': 3625502, 'end': 3630190, 'sentiment': 'NEGATIVE', 'confidence': 0.9069141745567322, 'speaker': 'E'}, {'text': 'Thank you.', 'start': 3630640, 'end': 3631116, 'sentiment': 'POSITIVE', 'confidence': 0.8529649376869202, 'speaker': 'C'}, {'text': "Varia it was very interesting and I'm really looking forward to look at the results you have in your study.", 'start': 3631138, 'end': 3639584, 'sentiment': 'POSITIVE', 'confidence': 0.9881227612495422, 'speaker': 'E'}, {'text': 'Especially since as Anna mentioned, we had something interesting with the international binding and depersonalization and yeah, kind of happy about that.', 'start': 3639782, 'end': 3650130, 'sentiment': 'POSITIVE', 'confidence': 0.9745791554450989, 'speaker': 'E'}, {'text': "I'm really sorry because I listened kind of doing something else.", 'start': 3651080, 'end': 3655044, 'sentiment': 'NEGATIVE', 'confidence': 0.7056540846824646, 'speaker': 'E'}, {'text': 'Unfortunately in the lab I was busy while you were talking.', 'start': 3655082, 'end': 3658420, 'sentiment': 'NEGATIVE', 'confidence': 0.6925555467605591, 'speaker': 'E'}, {'text': 'But I kind of like this idea.', 'start': 3658570, 'end': 3660310, 'sentiment': 'POSITIVE', 'confidence': 0.9003554582595825, 'speaker': 'E'}, {'text': 'Yeah.', 'start': 3661240, 'end': 3661700, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'A'}, {'text': 'Does the self is attenuated or not or increasing and kind of goes back to just Simon.', 'start': 3661770, 'end': 3667892, 'sentiment': 'NEUTRAL', 'confidence': 0.7467837929725647, 'speaker': 'E'}, {'text': 'The last comment from Simon about expertise.', 'start': 3667956, 'end': 3670920, 'sentiment': 'NEUTRAL', 'confidence': 0.8922411799430847, 'speaker': 'E'}, {'text': 'I think in term of motor interaction there is some literal jobability expert.', 'start': 3672460, 'end': 3678936, 'sentiment': 'NEUTRAL', 'confidence': 0.8361780047416687, 'speaker': 'E'}, {'text': "I was trying to Google that, but I attended a workshop last year, and I think it was about once you're an expert.", 'start': 3678968, 'end': 3687440, 'sentiment': 'NEUTRAL', 'confidence': 0.7510651350021362, 'speaker': 'E'}, {'text': 'At the beginning, you have this kind of flexible you have a better understanding consciousness, and then at the end, you kind of learn to let it go, to ride the flow of the motion, kind of.', 'start': 3688900, 'end': 3700790, 'sentiment': 'NEUTRAL', 'confidence': 0.5962963700294495, 'speaker': 'E'}, {'text': "And I think it's probably the same.", 'start': 3701880, 'end': 3703572, 'sentiment': 'NEUTRAL', 'confidence': 0.6463459730148315, 'speaker': 'E'}, {'text': "I don't know about attention in meditation is that you have to maybe more like not focus attentional state but more like open.", 'start': 3703626, 'end': 3714890, 'sentiment': 'NEUTRAL', 'confidence': 0.7028964757919312, 'speaker': 'E'}, {'text': 'Sorry, I forgot the name of the meditation type of meditation.', 'start': 3716220, 'end': 3719252, 'sentiment': 'NEGATIVE', 'confidence': 0.5473423600196838, 'speaker': 'E'}, {'text': 'But open meditation, open monitoring.', 'start': 3719316, 'end': 3721668, 'sentiment': 'NEUTRAL', 'confidence': 0.7775278687477112, 'speaker': 'A'}, {'text': 'Yeah, exactly.', 'start': 3721844, 'end': 3722810, 'sentiment': 'NEUTRAL', 'confidence': 0.5121256113052368, 'speaker': 'A'}, {'text': "I don't know.", 'start': 3723340, 'end': 3724328, 'sentiment': 'NEUTRAL', 'confidence': 0.5666733384132385, 'speaker': 'E'}, {'text': 'So it would be interesting and I suggested to see what type of meditation maybe changed the sense of the self.', 'start': 3724494, 'end': 3733212, 'sentiment': 'POSITIVE', 'confidence': 0.5154381394386292, 'speaker': 'E'}, {'text': "Maybe at the beginning it's more acute because you really scrutinize your sensation.", 'start': 3733266, 'end': 3738080, 'sentiment': 'NEUTRAL', 'confidence': 0.8134147524833679, 'speaker': 'E'}, {'text': "I don't know.", 'start': 3739380, 'end': 3740320, 'sentiment': 'NEUTRAL', 'confidence': 0.5666733384132385, 'speaker': 'E'}, {'text': 'This is something that you plan to do, right?', 'start': 3740470, 'end': 3742610, 'sentiment': 'NEUTRAL', 'confidence': 0.8881992101669312, 'speaker': 'E'}, {'text': 'Should I go or do you want to go on the the first question was there is a body of evidence that actually say that in expert meditators tension start decreasing.', 'start': 3745300, 'end': 3763560, 'sentiment': 'NEUTRAL', 'confidence': 0.8503000736236572, 'speaker': 'A'}, {'text': 'But there is also because you allocate less and less attention.', 'start': 3764620, 'end': 3769700, 'sentiment': 'NEGATIVE', 'confidence': 0.6665362119674683, 'speaker': 'A'}, {'text': 'But I would be careful with that with this because they say there is decreased activity in anterior singleet cortex.', 'start': 3769860, 'end': 3781260, 'sentiment': 'NEGATIVE', 'confidence': 0.5365938544273376, 'speaker': 'A'}, {'text': 'So they make inference about it as meditators as well.', 'start': 3782560, 'end': 3789890, 'sentiment': 'NEUTRAL', 'confidence': 0.7509726285934448, 'speaker': 'A'}, {'text': 'And having to know other people that are more experienced than me, they would never say we lose our attention to that because our experience is so rich of sensory signals and related thought process that you cannot afford to not be attentive.', 'start': 3790500, 'end': 3807920, 'sentiment': 'NEUTRAL', 'confidence': 0.473016619682312, 'speaker': 'A'}, {'text': 'However, we can bring into the plate different kinds of attention.', 'start': 3808080, 'end': 3811956, 'sentiment': 'NEUTRAL', 'confidence': 0.7513713836669922, 'speaker': 'A'}, {'text': "As you said, there is focused attention or there's an attention that requires more explicit thought about it.", 'start': 3812068, 'end': 3821048, 'sentiment': 'NEUTRAL', 'confidence': 0.862593948841095, 'speaker': 'A'}, {'text': 'So more explicit kind of way to focus on things and there is more like a bare attention.', 'start': 3821134, 'end': 3828616, 'sentiment': 'NEUTRAL', 'confidence': 0.7229759693145752, 'speaker': 'A'}, {'text': "So when you focus on the whole experience and you let it go with a non judgmental attitude and more open attitude and it's actually these attitudes, they're very stressed in meditation techniques, that's why they're a bit underlooked.", 'start': 3828728, 'end': 3844284, 'sentiment': 'NEUTRAL', 'confidence': 0.6029861569404602, 'speaker': 'A'}, {'text': "And in research I feel because it's a lot about how we use attention but not the attention but not how we use intention.", 'start': 3844332, 'end': 3853552, 'sentiment': 'NEUTRAL', 'confidence': 0.6641687750816345, 'speaker': 'A'}, {'text': 'So the attitude of the meditator has to be very open and very non judgmental and these reduce the nonreactive senses for example and reduce the ability to self regulate your experience.', 'start': 3853696, 'end': 3870650, 'sentiment': 'NEUTRAL', 'confidence': 0.6463654637336731, 'speaker': 'A'}, {'text': 'Partially answered.', 'start': 3873280, 'end': 3874860, 'sentiment': 'NEUTRAL', 'confidence': 0.8114227056503296, 'speaker': 'A'}, {'text': "Yeah, I kind of like the idea that you link that with attention and just I think maybe it would be interesting to look at different type of attention because maybe there is a difference between I don't know, different type of meditation may develop different type of maybe the open meditation is more prone.", 'start': 3876160, 'end': 3900876, 'sentiment': 'NEUTRAL', 'confidence': 0.5541592836380005, 'speaker': 'E'}, {'text': "I don't know because you mentioned the insula cortex and to me it's more associated with certain type of attention.", 'start': 3900908, 'end': 3907152, 'sentiment': 'NEUTRAL', 'confidence': 0.6588647961616516, 'speaker': 'E'}, {'text': 'Like more like maybe more prone for feedback or negativity or these kind of error monitoring process.', 'start': 3907216, 'end': 3916616, 'sentiment': 'NEGATIVE', 'confidence': 0.6940237879753113, 'speaker': 'E'}, {'text': "So it's not like your attention, you lose your attention.", 'start': 3916798, 'end': 3919092, 'sentiment': 'NEUTRAL', 'confidence': 0.5033220648765564, 'speaker': 'E'}, {'text': "It's just it's more like in the background and then when there is a mistake or something it kind of pops up more quickly.", 'start': 3919156, 'end': 3926044, 'sentiment': 'NEUTRAL', 'confidence': 0.5653873682022095, 'speaker': 'E'}, {'text': "I don't know.", 'start': 3926162, 'end': 3926876, 'sentiment': 'NEUTRAL', 'confidence': 0.5666733384132385, 'speaker': 'E'}, {'text': 'And you may have more frontal or sustain attention.', 'start': 3926978, 'end': 3932312, 'sentiment': 'NEUTRAL', 'confidence': 0.6601564288139343, 'speaker': 'E'}, {'text': "I don't know.", 'start': 3932376, 'end': 3932716, 'sentiment': 'NEUTRAL', 'confidence': 0.5666733384132385, 'speaker': 'E'}, {'text': "I mean I'm not a specialist of attention at all.", 'start': 3932738, 'end': 3934824, 'sentiment': 'NEUTRAL', 'confidence': 0.6473154425621033, 'speaker': 'E'}, {'text': 'So please take that with a grain of salt.', 'start': 3934882, 'end': 3937440, 'sentiment': 'NEUTRAL', 'confidence': 0.7799709439277649, 'speaker': 'E'}, {'text': 'Yeah.', 'start': 3937940, 'end': 3938304, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'A'}, {'text': "I was wondering if this is something, I don't know obviously because you're not planning to do any EEG or neurophysiological measurement.", 'start': 3938342, 'end': 3948924, 'sentiment': 'NEUTRAL', 'confidence': 0.5092353820800781, 'speaker': 'E'}, {'text': 'Right.', 'start': 3948972, 'end': 3949570, 'sentiment': 'NEUTRAL', 'confidence': 0.5664745569229126, 'speaker': 'A'}, {'text': 'So this is maybe like a follow up study that would be interesting.', 'start': 3950340, 'end': 3954148, 'sentiment': 'POSITIVE', 'confidence': 0.8868839740753174, 'speaker': 'E'}, {'text': 'Not yet, but in the pipeline.', 'start': 3954314, 'end': 3959180, 'sentiment': 'NEUTRAL', 'confidence': 0.8102390766143799, 'speaker': 'C'}, {'text': 'Yeah.', 'start': 3959280, 'end': 3959688, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'C'}, {'text': 'Okay.', 'start': 3959774, 'end': 3960264, 'sentiment': 'NEUTRAL', 'confidence': 0.584351658821106, 'speaker': 'C'}, {'text': 'What we really want with Valeria is and other collaborators is to basically push against this idea that you can have selfless experiences.', 'start': 3960382, 'end': 3975176, 'sentiment': 'NEUTRAL', 'confidence': 0.7430963516235352, 'speaker': 'C'}, {'text': "I know it's controversial and many people talk about oh, selfless experience blah.", 'start': 3975288, 'end': 3980220, 'sentiment': 'NEGATIVE', 'confidence': 0.5157430171966553, 'speaker': 'C'}, {'text': "So basically we want to say radically speaking okay, so that works if you bite the bullet and you're mind body dualist and somehow consider that actually the body kind of like disappears in the process.", 'start': 3981760, 'end': 3991808, 'sentiment': 'NEUTRAL', 'confidence': 0.7110015749931335, 'speaker': 'C'}, {'text': "But if you're not mind body dualist then you need to basically put the body into equation and realize that actually what allows the mind to disappear is the fact into the pureness of the experience is the fact that the impure body is kind of like put in a stable condition in such a way that basically you can afford to leave it in the background and to have this type of experience arising.", 'start': 3991894, 'end': 4019956, 'sentiment': 'NEUTRAL', 'confidence': 0.7578727006912231, 'speaker': 'C'}, {'text': "But without that in place you can't really afford to go through this selfless experiences.", 'start': 4020068, 'end': 4027848, 'sentiment': 'NEGATIVE', 'confidence': 0.6505993008613586, 'speaker': 'C'}, {'text': 'And this is why we want to be provocative in the titles that well actually maybe the experience of selfless experiences actually comes necessarily as two sign of the same coin of this experience of having an unlimited body that actually expands through the world.', 'start': 4027944, 'end': 4049940, 'sentiment': 'NEUTRAL', 'confidence': 0.5121104717254639, 'speaker': 'C'}, {'text': 'But the body is there.', 'start': 4050010, 'end': 4051044, 'sentiment': 'NEUTRAL', 'confidence': 0.7333941459655762, 'speaker': 'C'}, {'text': 'I mean the thing, the entity that has the experience of no experience is that a body that kind of is self regulated in a certain way like the homeostasis is put at like a set point.', 'start': 4051082, 'end': 4068504, 'sentiment': 'NEUTRAL', 'confidence': 0.744083821773529, 'speaker': 'C'}, {'text': "And when you're using this metaphor of think of a cyclone, right, moving cyclone so you have the steel eye of the cyclone in the middle doesn't mean that actually it's not there.", 'start': 4068622, 'end': 4081356, 'sentiment': 'NEUTRAL', 'confidence': 0.7232564687728882, 'speaker': 'C'}, {'text': "It's just like it's around everything.", 'start': 4081458, 'end': 4084440, 'sentiment': 'NEUTRAL', 'confidence': 0.5597781538963318, 'speaker': 'C'}, {'text': 'And because we are self organizing biological systems.', 'start': 4084610, 'end': 4088320, 'sentiment': 'NEUTRAL', 'confidence': 0.8363134860992432, 'speaker': 'C'}, {'text': 'This animal, this thing needs to keep track of this internal bodily states.', 'start': 4091220, 'end': 4095280, 'sentiment': 'NEUTRAL', 'confidence': 0.7603991031646729, 'speaker': 'C'}, {'text': 'And a successful system does this all the time.', 'start': 4095350, 'end': 4100390, 'sentiment': 'NEUTRAL', 'confidence': 0.5625700354576111, 'speaker': 'C'}, {'text': 'All the time, literally from second one, when we basically get from one cell to the self.', 'start': 4100920, 'end': 4107364, 'sentiment': 'NEUTRAL', 'confidence': 0.8356425762176514, 'speaker': 'C'}, {'text': 'So this is some sort of fascinating self organization that is happening on the cellular level already and it needs to be.', 'start': 4107402, 'end': 4115424, 'sentiment': 'POSITIVE', 'confidence': 0.9527168273925781, 'speaker': 'C'}, {'text': 'And death is basically this is what is happening.', 'start': 4115562, 'end': 4117752, 'sentiment': 'NEGATIVE', 'confidence': 0.6570407152175903, 'speaker': 'C'}, {'text': "It's like disintegration of this self organization.", 'start': 4117806, 'end': 4122600, 'sentiment': 'NEGATIVE', 'confidence': 0.7737224698066711, 'speaker': 'C'}, {'text': "But clearly that's not what is happening on meditation, right?", 'start': 4123200, 'end': 4127132, 'sentiment': 'NEGATIVE', 'confidence': 0.5113438963890076, 'speaker': 'C'}, {'text': "Because hopefully you don't die when you meditate.", 'start': 4127186, 'end': 4130104, 'sentiment': 'POSITIVE', 'confidence': 0.5510367751121521, 'speaker': 'C'}, {'text': 'In that sense.', 'start': 4130232, 'end': 4131324, 'sentiment': 'NEUTRAL', 'confidence': 0.7184202075004578, 'speaker': 'C'}, {'text': "There is disintegration of a certain way to experience yourself in relation to the body in the world, but clearly there's something that stays there and needs to stay there for you to have those experiences.", 'start': 4131442, 'end': 4142060, 'sentiment': 'NEUTRAL', 'confidence': 0.7379791736602783, 'speaker': 'C'}, {'text': "So that's a bit of controversial, radical claim that we like to defend.", 'start': 4142140, 'end': 4146012, 'sentiment': 'NEUTRAL', 'confidence': 0.6469250917434692, 'speaker': 'C'}, {'text': 'And yeah, we already had this discussion with several people.', 'start': 4146076, 'end': 4150390, 'sentiment': 'NEUTRAL', 'confidence': 0.831825852394104, 'speaker': 'C'}, {'text': 'For instance, like Valerie and I, we went to Enlightenment, this workshop on phrenology neurocompetition.', 'start': 4150760, 'end': 4158704, 'sentiment': 'NEUTRAL', 'confidence': 0.7924236059188843, 'speaker': 'C'}, {'text': 'We met there with people like Thomas Betziger and everything and obviously they have a different opinion.', 'start': 4158752, 'end': 4163472, 'sentiment': 'NEUTRAL', 'confidence': 0.7257686257362366, 'speaker': 'C'}, {'text': "So we kind of, like, have a lively discussion about why we think it's like, what does it mean to actually lose yourself and what is the self and what is a pure experience and why we basically need whether we're like it or not, the connection with the impure body to make sure that you can have, at a certain point, a pure experience.", 'start': 4163536, 'end': 4182750, 'sentiment': 'NEUTRAL', 'confidence': 0.818751871585846, 'speaker': 'C'}, {'text': 'But then again, this is something that just speculation at the theory level.', 'start': 4183600, 'end': 4187024, 'sentiment': 'NEUTRAL', 'confidence': 0.6595110297203064, 'speaker': 'C'}, {'text': 'And this is why I have this brilliant team here that we can do some studies and actually measure stuff, put the finger on it, put the number and see what we get.', 'start': 4187062, 'end': 4200790, 'sentiment': 'POSITIVE', 'confidence': 0.8490991592407227, 'speaker': 'C'}, {'text': "These are awesome points and there's so many ways it could go.", 'start': 4203160, 'end': 4207380, 'sentiment': 'POSITIVE', 'confidence': 0.9753446578979492, 'speaker': 'B'}, {'text': "I'll read a question from the live chat.", 'start': 4207450, 'end': 4210740, 'sentiment': 'NEUTRAL', 'confidence': 0.8972585797309875, 'speaker': 'B'}, {'text': 'So G Pagnani wrote, the notion of increased Somatosensory transparency in experienced meditators associated with increased liveliness of the experience is intriguing.', 'start': 4210900, 'end': 4223688, 'sentiment': 'POSITIVE', 'confidence': 0.8758928775787354, 'speaker': 'B'}, {'text': 'Can you say something about which levels in the hierarchical structure of the internal model are more likely to be affected by the meditative attentional task in terms of precision deployment?', 'start': 4223864, 'end': 4236892, 'sentiment': 'NEUTRAL', 'confidence': 0.8604717254638672, 'speaker': 'B'}, {'text': 'Do you think the attenuation of Somatosensory prediction error concerns more intermediate levels in a way increase meta awareness rather than sheer sensory attention?', 'start': 4237036, 'end': 4248260, 'sentiment': 'NEUTRAL', 'confidence': 0.7543470859527588, 'speaker': 'B'}, {'text': 'I can take this one.', 'start': 4250520, 'end': 4251924, 'sentiment': 'POSITIVE', 'confidence': 0.6627545952796936, 'speaker': 'C'}, {'text': 'So I can give a fuzz go and then you can go.', 'start': 4252042, 'end': 4257796, 'sentiment': 'NEUTRAL', 'confidence': 0.7364968657493591, 'speaker': 'C'}, {'text': 'No, I just wanted to ask rather than ensuring.', 'start': 4257978, 'end': 4260680, 'sentiment': 'NEUTRAL', 'confidence': 0.7128303647041321, 'speaker': 'A'}, {'text': 'Rather than sheer sensory attention.', 'start': 4263100, 'end': 4266040, 'sentiment': 'NEUTRAL', 'confidence': 0.6049532890319824, 'speaker': 'B'}, {'text': 'Yeah, you can go on now, please.', 'start': 4267580, 'end': 4269290, 'sentiment': 'NEUTRAL', 'confidence': 0.6792023181915283, 'speaker': 'A'}, {'text': "Yeah, so this is something I'm trying to develop this idea right now with a PhD student of mine, Libetise, basically.", 'start': 4272320, 'end': 4287344, 'sentiment': 'NEUTRAL', 'confidence': 0.6845535635948181, 'speaker': 'C'}, {'text': "And this is why it's connected with the question that you ask, you'll see, is that your platform is active inference, right?", 'start': 4287542, 'end': 4297936, 'sentiment': 'NEUTRAL', 'confidence': 0.8712120652198792, 'speaker': 'C'}, {'text': 'And so people kind of know lately kind of realize, wait a minute, actually we are active and we need to explain action in the world and everything kind of like comes late, right?', 'start': 4297958, 'end': 4309444, 'sentiment': 'NEUTRAL', 'confidence': 0.7332688570022583, 'speaker': 'C'}, {'text': 'But if you look going back to the animal, basically the action and the movement is there from the very beginning.', 'start': 4309482, 'end': 4317252, 'sentiment': 'NEUTRAL', 'confidence': 0.8892387747764587, 'speaker': 'C'}, {'text': "So this means that this is why it's so important to basically relate the self organization, self awareness, self perception necessarily related with movement.", 'start': 4317316, 'end': 4328940, 'sentiment': 'NEUTRAL', 'confidence': 0.65217125415802, 'speaker': 'C'}, {'text': 'So movement an action is not something that you add on the top of this, right?', 'start': 4329680, 'end': 4334732, 'sentiment': 'NEUTRAL', 'confidence': 0.611224353313446, 'speaker': 'C'}, {'text': 'Like some of intention.', 'start': 4334786, 'end': 4337064, 'sentiment': 'NEUTRAL', 'confidence': 0.74971604347229, 'speaker': 'C'}, {'text': 'So you can have an intention, but basically the first movements are kind of like automatic and need to be there, right?', 'start': 4337192, 'end': 4342352, 'sentiment': 'NEUTRAL', 'confidence': 0.8400660157203674, 'speaker': 'C'}, {'text': 'And basically our body moves all the time because we breathe all the time and our heart beats all the time.', 'start': 4342406, 'end': 4348564, 'sentiment': 'NEUTRAL', 'confidence': 0.7830723524093628, 'speaker': 'C'}, {'text': "So this means that for me, this type of attenuation is happening at the sensory level because that's the basic one.", 'start': 4348682, 'end': 4356372, 'sentiment': 'NEUTRAL', 'confidence': 0.7143211364746094, 'speaker': 'C'}, {'text': 'So can you have sensory stuff without metacognitive stuff?', 'start': 4356426, 'end': 4359832, 'sentiment': 'NEUTRAL', 'confidence': 0.7583639621734619, 'speaker': 'C'}, {'text': 'Yes.', 'start': 4359886, 'end': 4360344, 'sentiment': 'POSITIVE', 'confidence': 0.46103888750076294, 'speaker': 'C'}, {'text': 'Can you have metacognitive stuff without sensory stuff?', 'start': 4360462, 'end': 4362872, 'sentiment': 'NEUTRAL', 'confidence': 0.7493085265159607, 'speaker': 'C'}, {'text': 'No.', 'start': 4362926, 'end': 4363288, 'sentiment': 'NEUTRAL', 'confidence': 0.4936186671257019, 'speaker': 'E'}, {'text': "So it's like what is basic that's the first things needs to be attenuated and then there has to be a balance between metacognitive and sensory attenuation because this is precisely what I think it is happening in Depersonalization because if you focus too much, right?", 'start': 4363374, 'end': 4383564, 'sentiment': 'NEUTRAL', 'confidence': 0.6115027666091919, 'speaker': 'C'}, {'text': "So you lose the balance between then it's kind of like this type of you cannot afford to self forget yourself.", 'start': 4383602, 'end': 4398770, 'sentiment': 'NEGATIVE', 'confidence': 0.7793281078338623, 'speaker': 'C'}, {'text': "And then it's kind of like the self stands in the way and that gets you even more disconnected, so to speak.", 'start': 4399300, 'end': 4405350, 'sentiment': 'NEGATIVE', 'confidence': 0.777333676815033, 'speaker': 'C'}, {'text': "So this is why I think it's important to contrast different type of meditative experiences and meditative practices to see which one of them actually has more focus on what you do with metacognitive, metawareness awareness of awareness and which one are actually involving more like sensory movement, for instance, let's say.", 'start': 4406520, 'end': 4429676, 'sentiment': 'NEUTRAL', 'confidence': 0.8177152276039124, 'speaker': 'C'}, {'text': "Yeah, so that's something that needs to be empirically tested.", 'start': 4429698, 'end': 4433496, 'sentiment': 'NEUTRAL', 'confidence': 0.8239104747772217, 'speaker': 'C'}, {'text': 'But I would speculate and then obviously we can put it at test, either by doing a simulation or actually collecting data to see how that plays into this distinction.', 'start': 4433528, 'end': 4447120, 'sentiment': 'NEUTRAL', 'confidence': 0.8779147267341614, 'speaker': 'C'}, {'text': "I think Simon wants to say something, but I'm not the moderator.", 'start': 4451840, 'end': 4455324, 'sentiment': 'NEUTRAL', 'confidence': 0.6978086233139038, 'speaker': 'C'}, {'text': 'So Daniel, you decide.', 'start': 4455372, 'end': 4456800, 'sentiment': 'NEUTRAL', 'confidence': 0.7316133379936218, 'speaker': 'C'}, {'text': 'Yeah.', 'start': 4457540, 'end': 4457856, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'D'}, {'text': 'Valeria first.', 'start': 4457878, 'end': 4459090, 'sentiment': 'NEUTRAL', 'confidence': 0.7166335582733154, 'speaker': 'B'}, {'text': 'Thank you, Anna.', 'start': 4463140, 'end': 4464480, 'sentiment': 'POSITIVE', 'confidence': 0.8898884057998657, 'speaker': 'A'}, {'text': "I don't have so much more to say because I agree with her.", 'start': 4466840, 'end': 4470100, 'sentiment': 'NEUTRAL', 'confidence': 0.5021546483039856, 'speaker': 'A'}, {'text': 'But I thought when Daniel you were reading the question for me the answer was more or less clear in the sense that as I say, the Somatosens continuation happens the very low level predictions.', 'start': 4470170, 'end': 4488408, 'sentiment': 'NEUTRAL', 'confidence': 0.6590948700904846, 'speaker': 'A'}, {'text': 'So in a very pre reflective self consciousness, so that the person was asking in the meditation techniques, when you put the attention on, for example, your bodily signals there, you have a top down modulation of this, of precision wasting, but the top down modulation is on low level predictions.', 'start': 4488584, 'end': 4517168, 'sentiment': 'NEUTRAL', 'confidence': 0.83718341588974, 'speaker': 'A'}, {'text': "So you're not putting top down on what you think about your body is you're actually doing the opposite.", 'start': 4517344, 'end': 4523024, 'sentiment': 'NEGATIVE', 'confidence': 0.7429876327514648, 'speaker': 'A'}, {'text': "You're trying to forget about your previous expectations about the body because you're trying to have this non judgmental awareness about what's going on in your experience.", 'start': 4523072, 'end': 4535050, 'sentiment': 'NEUTRAL', 'confidence': 0.706061065196991, 'speaker': 'A'}, {'text': "And then with this, let's say, less biased way to attend your body.", 'start': 4535680, 'end': 4545180, 'sentiment': 'NEUTRAL', 'confidence': 0.7502663731575012, 'speaker': 'A'}, {'text': 'You start piercing and perceiving bodily sensations in your body or other kind of experiences.', 'start': 4545330, 'end': 4556956, 'sentiment': 'NEUTRAL', 'confidence': 0.8040189743041992, 'speaker': 'A'}, {'text': 'So I would say this increasing precision on somatosensory signals happens at the low level of the Yerarchy that then attenuates the sensory consequences of the posterior.', 'start': 4557068, 'end': 4574020, 'sentiment': 'NEUTRAL', 'confidence': 0.5488650798797607, 'speaker': 'A'}, {'text': 'And the meta awareness comes when you learn, I think, when you start having increased body awareness.', 'start': 4575960, 'end': 4587300, 'sentiment': 'NEUTRAL', 'confidence': 0.6029478907585144, 'speaker': 'A'}, {'text': 'So you make more experience.', 'start': 4587460, 'end': 4589356, 'sentiment': 'POSITIVE', 'confidence': 0.5974631905555725, 'speaker': 'A'}, {'text': 'I think then you start developing meta awareness about how your body is actually about higher representation of the body of your body.', 'start': 4589458, 'end': 4602448, 'sentiment': 'NEUTRAL', 'confidence': 0.8254735469818115, 'speaker': 'A'}, {'text': 'But in the moment when this happens, I think it really happens at the low level, subpersonal beliefs.', 'start': 4602534, 'end': 4609308, 'sentiment': 'NEUTRAL', 'confidence': 0.545078456401825, 'speaker': 'A'}, {'text': 'And then later on, on the longer time scales, then it starts becoming more abstract and ingrained at the personal level of your beliefs.', 'start': 4609404, 'end': 4622740, 'sentiment': 'NEUTRAL', 'confidence': 0.8053539395332336, 'speaker': 'A'}, {'text': "That's how I say it.", 'start': 4623480, 'end': 4624768, 'sentiment': 'NEUTRAL', 'confidence': 0.7032950520515442, 'speaker': 'A'}, {'text': "But of course, if Simon has something to do with it, it's really I.", 'start': 4624794, 'end': 4631576, 'sentiment': 'NEUTRAL', 'confidence': 0.7287179827690125, 'speaker': 'A'}, {'text': "Didn'T I didn't want to comment.", 'start': 4631598, 'end': 4632660, 'sentiment': 'NEGATIVE', 'confidence': 0.5407618880271912, 'speaker': 'D'}, {'text': 'I just selfishly raised my hand to.', 'start': 4632740, 'end': 4634408, 'sentiment': 'NEUTRAL', 'confidence': 0.7055279016494751, 'speaker': 'D'}, {'text': "Ask another question or Daniel, I don't know if you have an opinion on that.", 'start': 4634414, 'end': 4639196, 'sentiment': 'NEUTRAL', 'confidence': 0.7099919319152832, 'speaker': 'A'}, {'text': "I'm happy to hear it as well.", 'start': 4639218, 'end': 4640910, 'sentiment': 'POSITIVE', 'confidence': 0.9748679399490356, 'speaker': 'A'}, {'text': 'Well, certainly resonated with this comparative approach to studying the diversity of methods and protocols we already have for mind and body and attention, broadening the scope and just kind of putting darts in the space of what practices do people engage their mind and body in?', 'start': 4642480, 'end': 4666950, 'sentiment': 'POSITIVE', 'confidence': 0.6250080466270447, 'speaker': 'B'}, {'text': 'And then, how can that territory be explored with also a variety of theoretical models?', 'start': 4667320, 'end': 4674608, 'sentiment': 'NEUTRAL', 'confidence': 0.8822854161262512, 'speaker': 'B'}, {'text': 'And how does that relationship connect to the kinds of empirical work that we might do in a brain scanner or with other kinds of measuring?', 'start': 4674784, 'end': 4683400, 'sentiment': 'NEUTRAL', 'confidence': 0.9133022427558899, 'speaker': 'B'}, {'text': "And I think one thing I want to explore more is in a hierarchical nested cognitive model, which we often speak of ourselves and other types of sophisticated entities as where's our awareness?", 'start': 4684300, 'end': 4705356, 'sentiment': 'NEUTRAL', 'confidence': 0.763914167881012, 'speaker': 'B'}, {'text': "Where's awareness in that picture?", 'start': 4705468, 'end': 4708240, 'sentiment': 'NEGATIVE', 'confidence': 0.496658056974411, 'speaker': 'B'}, {'text': "And also to Simone's question about when we're moving, but we're expecting what we're moving, then how does the exteriorceptive flow?", 'start': 4712520, 'end': 4725972, 'sentiment': 'NEUTRAL', 'confidence': 0.8880690336227417, 'speaker': 'B'}, {'text': 'Like the visual field?', 'start': 4726116, 'end': 4727400, 'sentiment': 'NEUTRAL', 'confidence': 0.8077991604804993, 'speaker': 'B'}, {'text': "You might be very familiar with walking, and so you might be able to proprioceptively kind of zero out on your walking, but there's this exteriorceptive flow of novelty in the world.", 'start': 4727470, 'end': 4743084, 'sentiment': 'NEUTRAL', 'confidence': 0.6549941301345825, 'speaker': 'B'}, {'text': 'So I think that how and then connect it back to the comparative and staring at a candle or a blank screen or darkness and all these different methods.', 'start': 4743282, 'end': 4754080, 'sentiment': 'NEUTRAL', 'confidence': 0.8915805816650391, 'speaker': 'B'}, {'text': "There's a lot that these questions bring up.", 'start': 4758500, 'end': 4762676, 'sentiment': 'NEUTRAL', 'confidence': 0.716404139995575, 'speaker': 'B'}, {'text': 'Yeah.', 'start': 4762858, 'end': 4763636, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'A'}, {'text': 'Thank you, Daniel.', 'start': 4763818, 'end': 4764736, 'sentiment': 'POSITIVE', 'confidence': 0.8880262970924377, 'speaker': 'C'}, {'text': "So I have something to add to that because I think it's super know, my background is like, embodied cognition and activists and everything.", 'start': 4764768, 'end': 4775936, 'sentiment': 'NEUTRAL', 'confidence': 0.7826040983200073, 'speaker': 'C'}, {'text': "And for me, it's really not at all surprising the fact that many of these techniques have been developed by people that kind of, like, lived in closed communities.", 'start': 4775978, 'end': 4785204, 'sentiment': 'NEUTRAL', 'confidence': 0.633741021156311, 'speaker': 'C'}, {'text': 'Right.', 'start': 4785332, 'end': 4785768, 'sentiment': 'NEUTRAL', 'confidence': 0.5664745569229126, 'speaker': 'C'}, {'text': "So it's like you have a space where people can meditate walking.", 'start': 4785854, 'end': 4793048, 'sentiment': 'NEUTRAL', 'confidence': 0.8423298597335815, 'speaker': 'C'}, {'text': "I don't know.", 'start': 4793144, 'end': 4793772, 'sentiment': 'NEUTRAL', 'confidence': 0.5666733384132385, 'speaker': 'C'}, {'text': 'And then they have this ritual.', 'start': 4793826, 'end': 4795144, 'sentiment': 'NEUTRAL', 'confidence': 0.6555130481719971, 'speaker': 'C'}, {'text': 'They wake up at this time and they do this thing.', 'start': 4795192, 'end': 4797630, 'sentiment': 'NEUTRAL', 'confidence': 0.8141458034515381, 'speaker': 'C'}, {'text': "So you put yourself in yeah, it's a ritual.", 'start': 4798080, 'end': 4800732, 'sentiment': 'NEUTRAL', 'confidence': 0.7962790131568909, 'speaker': 'C'}, {'text': 'Right.', 'start': 4800796, 'end': 4801024, 'sentiment': 'NEUTRAL', 'confidence': 0.5664745569229126, 'speaker': 'C'}, {'text': 'Like all the rituals.', 'start': 4801062, 'end': 4803212, 'sentiment': 'NEUTRAL', 'confidence': 0.6327117681503296, 'speaker': 'C'}, {'text': "So this means, as I said, it's like high predictability.", 'start': 4803276, 'end': 4806204, 'sentiment': 'NEUTRAL', 'confidence': 0.7175981998443604, 'speaker': 'C'}, {'text': 'Right.', 'start': 4806332, 'end': 4807010, 'sentiment': 'NEUTRAL', 'confidence': 0.5664745569229126, 'speaker': 'C'}, {'text': "And then that's something super important.", 'start': 4808340, 'end': 4811460, 'sentiment': 'POSITIVE', 'confidence': 0.7839458584785461, 'speaker': 'C'}, {'text': 'And even in the Wokie meditation, you need to follow a certain path.', 'start': 4811610, 'end': 4818260, 'sentiment': 'NEUTRAL', 'confidence': 0.9036083221435547, 'speaker': 'C'}, {'text': 'Yes.', 'start': 4819880, 'end': 4820292, 'sentiment': 'POSITIVE', 'confidence': 0.46103888750076294, 'speaker': 'C'}, {'text': "So that's super interesting.", 'start': 4820346, 'end': 4822470, 'sentiment': 'POSITIVE', 'confidence': 0.9786132574081421, 'speaker': 'C'}, {'text': "Well, in the last five or ten minutes, I would love to hear from each of you, like, what are your directions heading forward and what's exciting to you and where would you like to take this?", 'start': 4826220, 'end': 4842190, 'sentiment': 'POSITIVE', 'confidence': 0.9212648868560791, 'speaker': 'B'}, {'text': "Maybe Simone and Julia first, and then we'll kind of make our way back to the.", 'start': 4844240, 'end': 4849470, 'sentiment': 'NEUTRAL', 'confidence': 0.9018733501434326, 'speaker': 'B'}, {'text': 'Not myself, not working on the project.', 'start': 4853700, 'end': 4856128, 'sentiment': 'NEGATIVE', 'confidence': 0.8178564310073853, 'speaker': 'D'}, {'text': 'Right.', 'start': 4856214, 'end': 4856704, 'sentiment': 'NEUTRAL', 'confidence': 0.5664745569229126, 'speaker': 'D'}, {'text': 'But what I was really interested in sort of extending this is trying to understand because the way those deep meditative states are reported sometimes and the way people with depersonalization disorder report their experience is very similar.', 'start': 4856822, 'end': 4878152, 'sentiment': 'NEUTRAL', 'confidence': 0.7749075293540955, 'speaker': 'D'}, {'text': 'They almost use, like, the same words right.', 'start': 4878286, 'end': 4880808, 'sentiment': 'NEUTRAL', 'confidence': 0.7247704267501831, 'speaker': 'D'}, {'text': 'And to describe how they feel.', 'start': 4880974, 'end': 4882760, 'sentiment': 'NEUTRAL', 'confidence': 0.7638567090034485, 'speaker': 'D'}, {'text': "And I wonder why one is experienced positively and one is experienced so negatively, as in it being a disorder and in completely disrupting someone's life.", 'start': 4882830, 'end': 4892140, 'sentiment': 'NEGATIVE', 'confidence': 0.8833780884742737, 'speaker': 'D'}, {'text': "So that was like this comparison I think I'll be very curious about.", 'start': 4892290, 'end': 4897230, 'sentiment': 'NEUTRAL', 'confidence': 0.5081126689910889, 'speaker': 'D'}, {'text': 'Awesome.', 'start': 4901100, 'end': 4901704, 'sentiment': 'POSITIVE', 'confidence': 0.9184247851371765, 'speaker': 'B'}, {'text': 'Julia, if you want to add anything.', 'start': 4901822, 'end': 4904670, 'sentiment': 'NEUTRAL', 'confidence': 0.8590555787086487, 'speaker': 'B'}, {'text': "Well, it's very interesting.", 'start': 4907440, 'end': 4909390, 'sentiment': 'POSITIVE', 'confidence': 0.9570282101631165, 'speaker': 'E'}, {'text': "Again, I'm not so involved in this study, so it's a bit hard, but I'm really interested in all the self is affected by our interaction with the world, external world, and I'm completely already spoiled with the result we have with the international binding.", 'start': 4910960, 'end': 4928224, 'sentiment': 'NEUTRAL', 'confidence': 0.47917696833610535, 'speaker': 'E'}, {'text': "So it's very if the self is attenuated or if it's disappeared, kind of I think that's the key question we want to answer.", 'start': 4928272, 'end': 4940872, 'sentiment': 'NEUTRAL', 'confidence': 0.820785403251648, 'speaker': 'E'}, {'text': "And yeah, I would be very curious to mean what Valeria found in data to see if we can have a common narrative about what's happening.", 'start': 4941006, 'end': 4951784, 'sentiment': 'NEUTRAL', 'confidence': 0.8615904450416565, 'speaker': 'E'}, {'text': 'Also with the personalization.', 'start': 4951982, 'end': 4953720, 'sentiment': 'NEUTRAL', 'confidence': 0.6695014238357544, 'speaker': 'E'}, {'text': 'Yeah.', 'start': 4955120, 'end': 4955532, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'A'}, {'text': "It's very interesting to see how moving of body, attention to the body can really change the self, kind of or the way we process self information.", 'start': 4955586, 'end': 4965570, 'sentiment': 'POSITIVE', 'confidence': 0.824296236038208, 'speaker': 'E'}, {'text': 'Yeah.', 'start': 4966900, 'end': 4967456, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'E'}, {'text': 'So very interesting.', 'start': 4967558, 'end': 4968770, 'sentiment': 'POSITIVE', 'confidence': 0.9672727584838867, 'speaker': 'E'}, {'text': 'Cool.', 'start': 4971140, 'end': 4971696, 'sentiment': 'POSITIVE', 'confidence': 0.84200119972229, 'speaker': 'A'}, {'text': 'Anna.', 'start': 4971798, 'end': 4972640, 'sentiment': 'NEUTRAL', 'confidence': 0.6361703276634216, 'speaker': 'B'}, {'text': 'Yes.', 'start': 4975320, 'end': 4975732, 'sentiment': 'POSITIVE', 'confidence': 0.46103888750076294, 'speaker': 'C'}, {'text': "So it's like lots of work to do ahead, but that's exciting, right?", 'start': 4975786, 'end': 4981590, 'sentiment': 'POSITIVE', 'confidence': 0.9044682383537292, 'speaker': 'C'}, {'text': 'Yeah.', 'start': 4982680, 'end': 4983092, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'C'}, {'text': "So, very short term, it's like we need to write up this result that we just got.", 'start': 4983146, 'end': 4989670, 'sentiment': 'NEUTRAL', 'confidence': 0.5037421584129333, 'speaker': 'C'}, {'text': 'So yeah.', 'start': 4990200, 'end': 4991136, 'sentiment': 'NEUTRAL', 'confidence': 0.5108225345611572, 'speaker': 'C'}, {'text': 'In relation to the body.', 'start': 4991178, 'end': 4992232, 'sentiment': 'NEUTRAL', 'confidence': 0.7672351002693176, 'speaker': 'C'}, {'text': "So basically, we're going to have some numbers to show.", 'start': 4992286, 'end': 4994440, 'sentiment': 'NEUTRAL', 'confidence': 0.8599064946174622, 'speaker': 'C'}, {'text': "So that's super nice.", 'start': 4994510, 'end': 4996090, 'sentiment': 'POSITIVE', 'confidence': 0.9885571002960205, 'speaker': 'C'}, {'text': 'And then the next steps would be to create or develop computational model around this, basically contrast the real world data with, you know, simulation data and then have a multilayered type of approach with different methods, from physiological to behavioral to phenomenological to computational, potentially also neural.', 'start': 4996780, 'end': 5028764, 'sentiment': 'NEUTRAL', 'confidence': 0.8654926419258118, 'speaker': 'C'}, {'text': "So that's something would be nice to do in the next steps.", 'start': 5028812, 'end': 5032660, 'sentiment': 'POSITIVE', 'confidence': 0.9189109206199646, 'speaker': 'C'}, {'text': "And apart from that, I think that's all for now, and I'll leave the floor to Valeria.", 'start': 5035720, 'end': 5044280, 'sentiment': 'NEUTRAL', 'confidence': 0.8660896420478821, 'speaker': 'C'}, {'text': 'Well, again, thank you, Dan and everybody.', 'start': 5045740, 'end': 5050010, 'sentiment': 'POSITIVE', 'confidence': 0.9513877034187317, 'speaker': 'A'}, {'text': 'Yeah.', 'start': 5050640, 'end': 5051436, 'sentiment': 'NEUTRAL', 'confidence': 0.5491447448730469, 'speaker': 'A'}, {'text': 'I also want to thank you a lot for this platform, this invitation.', 'start': 5051618, 'end': 5055144, 'sentiment': 'POSITIVE', 'confidence': 0.9768573045730591, 'speaker': 'A'}, {'text': 'It was really nice.', 'start': 5055192, 'end': 5056940, 'sentiment': 'POSITIVE', 'confidence': 0.9860551953315735, 'speaker': 'A'}, {'text': 'Really nice person and really nice conversation.', 'start': 5057090, 'end': 5060060, 'sentiment': 'POSITIVE', 'confidence': 0.9808312058448792, 'speaker': 'A'}, {'text': "I'm working with Anne Andy's project, so she already said, what's the next direction?", 'start': 5062000, 'end': 5067404, 'sentiment': 'NEUTRAL', 'confidence': 0.688814103603363, 'speaker': 'A'}, {'text': 'What.', 'start': 5067532, 'end': 5067776, 'sentiment': 'NEUTRAL', 'confidence': 0.48124951124191284, 'speaker': 'A'}, {'text': 'I can add in this I think would be on the theoretical side also start engaging with more closely to bodily reactions to meditation because the body boundaries dissolution is just one part of it.', 'start': 5067798, 'end': 5086708, 'sentiment': 'NEUTRAL', 'confidence': 0.760927677154541, 'speaker': 'A'}, {'text': "It's like one part of the phenomenology but it's not the only thing that happens during meditation.", 'start': 5086794, 'end': 5091320, 'sentiment': 'NEUTRAL', 'confidence': 0.8378633856773376, 'speaker': 'A'}, {'text': "There is a lot of potential that can be discovered on this because the body boundary solution again, it's really study a lot, but it's a phenomenon and there is so many other things that happens in our body while we meditate and I speak for first person experience, but in the community it's really like already said, other kinds of also more healing traditions like breath work, for example.", 'start': 5092220, 'end': 5122610, 'sentiment': 'POSITIVE', 'confidence': 0.7193278074264526, 'speaker': 'A'}, {'text': 'There there is a lot of potential where people already work on that.', 'start': 5123460, 'end': 5127380, 'sentiment': 'POSITIVE', 'confidence': 0.7201538681983948, 'speaker': 'A'}, {'text': 'But there is no bridge with the academic communities.', 'start': 5127530, 'end': 5131728, 'sentiment': 'NEGATIVE', 'confidence': 0.4878566265106201, 'speaker': 'A'}, {'text': 'So people work pragmatically with this intuitive knowledge about what happens in the body during these altered states of consciousness but still we need to bridge it with trying to make sense from a phonological and scientific point of view and experimental point of view as well.', 'start': 5131824, 'end': 5148328, 'sentiment': 'NEUTRAL', 'confidence': 0.8294222354888916, 'speaker': 'A'}, {'text': 'So I think I see myself in trying to step in this toward and bring insight from one world to the other and hoping to help myself and the other people around me.', 'start': 5148414, 'end': 5162110, 'sentiment': 'POSITIVE', 'confidence': 0.6185937523841858, 'speaker': 'A'}, {'text': 'Awesome.', 'start': 5164260, 'end': 5165008, 'sentiment': 'POSITIVE', 'confidence': 0.9184247851371765, 'speaker': 'B'}, {'text': 'Well, best of luck with the work.', 'start': 5165174, 'end': 5167984, 'sentiment': 'POSITIVE', 'confidence': 0.9238985180854797, 'speaker': 'B'}, {'text': 'That sounds really exciting.', 'start': 5168022, 'end': 5169356, 'sentiment': 'POSITIVE', 'confidence': 0.983788251876831, 'speaker': 'B'}, {'text': "Love the idea of the two way street with different bodily and cognitive practices and collaboration and conversation that can bring in all these different expertises that maybe don't have an fMRI study already, whatever that's worth.", 'start': 5169468, 'end': 5188250, 'sentiment': 'POSITIVE', 'confidence': 0.8933684229850769, 'speaker': 'B'}, {'text': 'Thank you though, always.', 'start': 5188780, 'end': 5190440, 'sentiment': 'POSITIVE', 'confidence': 0.9023188352584839, 'speaker': 'B'}, {'text': 'Any of you are welcome back and really appreciate that you all came out.', 'start': 5190590, 'end': 5195530, 'sentiment': 'POSITIVE', 'confidence': 0.9871298670768738, 'speaker': 'B'}, {'text': 'Thank you.', 'start': 5196540, 'end': 5197016, 'sentiment': 'POSITIVE', 'confidence': 0.8529649376869202, 'speaker': 'C'}, {'text': 'Daniel, thank you.', 'start': 5197038, 'end': 5198456, 'sentiment': 'POSITIVE', 'confidence': 0.8566426634788513, 'speaker': 'B'}, {'text': 'See you soon.', 'start': 5198478, 'end': 5198870, 'sentiment': 'NEUTRAL', 'confidence': 0.5413564443588257, 'speaker': 'B'}], 'entity_detection': True, 'entities': [{'entity_type': 'date', 'text': 'July 27, 2023', 'start': 9272, 'en