804579675198, 'label': 'Pets>FishAndAquariums'}, {'relevance': 0.002270311815664172, 'label': 'Pets>Birds'}, {'relevance': 0.002139551565051079, 'label': 'Science>Geology'}, {'relevance': 0.0017095445655286312, 'label': 'Science>Chemistry'}, {'relevance': 0.0009660434443503618, 'label': 'Science>Genetics'}, {'relevance': 0.0008894199854694307, 'label': 'Science'}, {'relevance': 0.0003275836643297225, 'label': 'EventsAndAttractions>PersonalCelebrations&LifeEvents>Birth'}, {'relevance': 0.00020025561389047652, 'label': 'Science>Environment'}], 'timestamp': {'start': 5685300, 'end': 5707844}, 'sentences_idx_start': 563, 'sentences_idx_end': 564}, {'text': "I suspect I could be wrong, but that basically it's locally trying to strengthen patterns of policy pursuit to pursue particular goals in a given context. And to come back to what I was mentioning earlier with that work by Robin of like a kind of act of coping.", 'labels': [{'relevance': 0.95476233959198, 'label': 'EventsAndAttractions>PoliticalEvent'}, {'relevance': 0.8442167043685913, 'label': 'NewsAndPolitics>Politics>PoliticalIssues'}, {'relevance': 0.8362492918968201, 'label': 'NewsAndPolitics>Politics'}, {'relevance': 0.012230060994625092, 'label': 'NewsAndPolitics>Politics>WarAndConflicts'}, {'relevance': 0.00223838840611279, 'label': 'BusinessAndFinance>Business>GreenSolutions'}, {'relevance': 0.001963838003575802, 'label': 'BusinessAndFinance>Business>ExecutiveLeadership&Management'}, {'relevance': 0.001696030842140317, 'label': 'MedicalHealth>DiseasesAndConditions>ReproductiveHealth'}, {'relevance': 0.0015618489123880863, 'label': 'PersonalFinance>FinancialAssistance>GovernmentSupportAndWelfare'}, {'relevance': 0.001221598475240171, 'label': 'BusinessAndFinance>Industries>EnvironmentalServicesIndustry'}, {'relevance': 0.0010903514921665192, 'label': 'Science>Environment'}], 'timestamp': {'start': 5707892, 'end': 5724008}, 'sentences_idx_start': 565, 'sentences_idx_end': 566}, {'text': "But it seems with rebus there's almost like not that kind of story, and that it's more you're adjusting to the world and actually, if under a very alter state, you are overtly enacting, that's actually kind of a dangerous thing. I don't know how much to make of this that the five Http receptors are less expressed on, like, motor cortex. I don't think we know enough to make too much of it.", 'labels': [{'relevance': 0.11562246829271317, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.034310340881347656, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.03384910896420479, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.006426939740777016, 'label': 'MedicalHealth>DiseasesAndConditions>MentalHealth'}, {'relevance': 0.006219913251698017, 'label': 'MedicalHealth>DiseasesAndConditions>BrainAndNervousSystemDisorders'}, {'relevance': 0.005566061940044165, 'label': 'Technology&Computing>Computing>Internet>SocialNetworking'}, {'relevance': 0.004580425098538399, 'label': 'Technology&Computing>Computing>Internet>InternetForBeginners'}, {'relevance': 0.004095794167369604, 'label': 'VideoGaming>VideoGameGenres>MMOs'}, {'relevance': 0.003773813834413886, 'label': 'Technology&Computing>VirtualReality'}, {'relevance': 0.0030782613903284073, 'label': 'FamilyAndRelationships>Dating'}], 'timestamp': {'start': 5724184, 'end': 5751940}, 'sentences_idx_start': 567, 'sentences_idx_end': 569}, {'text': "But it's like some dreams you might not want to act out as they're happening, but they still might powerfully impact you. So I'm currently actually wondering whether this other rebus like regime might have been specifically sculpted in the context of bonding and actually opening the self to include others. And that might have been some of the primary selective pressures. I don't know how to think of that in terms of inaction.", 'labels': [{'relevance': 0.03130196034908295, 'label': 'FamilyAndRelationships>Parenting'}, {'relevance': 0.02901913784444332, 'label': 'FamilyAndRelationships>Bereavement'}, {'relevance': 0.028568871319293976, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.027043387293815613, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.02695377916097641, 'label': 'FamilyAndRelationships>Parenting>ParentingChildrenAged4-11'}, {'relevance': 0.019726106896996498, 'label': 'Religion&Spirituality'}, {'relevance': 0.015689946711063385, 'label': 'PopCulture'}, {'relevance': 0.013869151473045349, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.013303805142641068, 'label': 'FamilyAndRelationships'}, {'relevance': 0.008435274474322796, 'label': 'Hobbies&Interests>GamesAndPuzzles>RoleplayingGames'}], 'timestamp': {'start': 5752010, 'end': 5778220}, 'sentences_idx_start': 570, 'sentences_idx_end': 573}, {'text': 'And one more detail that might kind of like not sure what to make of it that kind of goes through both of those excuse the phone would be anthropologically, I believe like psychedelics are oftentimes used in ways that would be both like creating a kind of group solidarity and might be used in the context of pursuing goals together in the world. So for instance, like a hunting party, they might all do psychedelics together or something that looks a lot like breath work before going out, maybe going to war.', 'labels': [{'relevance': 0.10483504086732864, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}, {'relevance': 0.041642069816589355, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.03665205091238022, 'label': 'HealthyLiving>Wellness>AlternativeMedicine'}, {'relevance': 0.03409299999475479, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.008837082423269749, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.007143302354961634, 'label': 'Religion&Spirituality'}, {'relevance': 0.006719166412949562, 'label': 'Religion&Spirituality>Buddhism'}, {'relevance': 0.005710508208721876, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HerbsAndSupplements'}, {'relevance': 0.004812245722860098, 'label': 'FamilyAndRelationships>Dating'}, {'relevance': 0.0035610906779766083, 'label': 'Hobbies&Interests>GamesAndPuzzles>RoleplayingGames'}], 'timestamp': {'start': 5780720, 'end': 5811832}, 'sentences_idx_start': 574, 'sentences_idx_end': 575}, {'text': "So that's a very different type that kind of includes both a relaxation of the normal boundaries of the self and a kind of gearing you up for pursuing goals in the you know, there's got to be another story of like, so Arthur's expertise is machine learning. And so it's like you want these systems to act intelligently and not act in other times. And so basically now we're in the language of policies, and when you deploy them and how and so complicated. Yeah.", 'labels': [{'relevance': 0.9891875386238098, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.030832849442958832, 'label': 'Technology&Computing>Robotics'}, {'relevance': 0.014533959329128265, 'label': 'Technology&Computing>Computing'}, {'relevance': 0.007381356321275234, 'label': 'BusinessAndFinance>Business>BusinessI.T.'}, {'relevance': 0.007357058580964804, 'label': 'Technology&Computing>Computing>Internet>CloudComputing'}, {'relevance': 0.005660963244736195, 'label': 'Technology&Computing>Computing>Internet>InternetOfThings'}, {'relevance': 0.004716088064014912, 'label': 'Technology&Computing'}, {'relevance': 0.003956354223191738, 'label': 'BusinessAndFinance>Business>BusinessOperations'}, {'relevance': 0.0029061792884021997, 'label': 'Technology&Computing>Computing>ProgrammingLanguages'}, {'relevance': 0.002377845346927643, 'label': 'Technology&Computing>Computing>InformationAndNetworkSecurity'}], 'timestamp': {'start': 5811966, 'end': 5843584}, 'sentences_idx_start': 576, 'sentences_idx_end': 579}, {'text': "I would say that action manifests itself at a few different places. It's true, I didn't mention it here. Yeah, I think it's very important, obviously. I think what the kind of most implicit place where it exists right, is that these belief landscapes are being instantiated ultimately for the sake of adaptive behavior. Adaptive behavior, adaptive action right, in some sort of environmental context.", 'labels': [{'relevance': 0.0908089429140091, 'label': 'Science>Environment'}, {'relevance': 0.025263329967856407, 'label': 'BusinessAndFinance>Industries>EnvironmentalServicesIndustry'}, {'relevance': 0.019261641427874565, 'label': 'EventsAndAttractions>PoliticalEvent'}, {'relevance': 0.016152100637555122, 'label': 'NewsAndPolitics>Politics>PoliticalIssues'}, {'relevance': 0.009851986542344093, 'label': 'Religion&Spirituality'}, {'relevance': 0.006597683299332857, 'label': 'NewsAndPolitics>Politics>WarAndConflicts'}, {'relevance': 0.004466763697564602, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.0038427377585321665, 'label': 'Travel>TravelLocations>PolarTravel'}, {'relevance': 0.003202504478394985, 'label': 'NewsAndPolitics>Disasters'}, {'relevance': 0.002318538725376129, 'label': 'EventsAndAttractions>OutdoorActivities'}], 'timestamp': {'start': 5843622, 'end': 5865572}, 'sentences_idx_start': 580, 'sentences_idx_end': 584}, {'text': "And that's the kind of like framework, the deep learning framework that we're using or like the artificial agent framework, right. Is that the assumption is that the system is supporting some sort of agent that's embodied in some sort of environment which is changing over time such that it can either be adaptive or not adaptive.", 'labels': [{'relevance': 0.996991753578186, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.026865074411034584, 'label': 'Technology&Computing>Computing'}, {'relevance': 0.01825527846813202, 'label': 'Technology&Computing>Robotics'}, {'relevance': 0.004911827389150858, 'label': 'Technology&Computing'}, {'relevance': 0.0023761324118822813, 'label': 'Technology&Computing>Computing>ProgrammingLanguages'}, {'relevance': 0.0013856751611456275, 'label': 'Technology&Computing>Computing>Internet>InternetOfThings'}, {'relevance': 0.001311629661358893, 'label': 'VideoGaming>VideoGameGenres>SimulationVideoGames'}, {'relevance': 0.0012058905558660626, 'label': 'Automotive>AutoType>DriverlessCars'}, {'relevance': 0.0007283522863872349, 'label': 'Hobbies&Interests>GamesAndPuzzles'}, {'relevance': 0.0005029581370763481, 'label': 'Technology&Computing>Computing>Internet>CloudComputing'}], 'timestamp': {'start': 5865716, 'end': 5887468}, 'sentences_idx_start': 585, 'sentences_idx_end': 586}, {'text': "I think then the question of how action actually plays into the evolution of these belief landscapes during psychedelics or not acting in the world is a very clear way to modify one's setting, right? So acting is a way of modifying the function that's providing the sensory input into the system which is going to change how the activity patterns are evolving over time, right, which are going to affect the acute quality of the trip, affect how beliefs are either being strengthened or relaxed.", 'labels': [{'relevance': 0.8424807786941528, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.57420414686203, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.27391964197158813, 'label': 'Religion&Spirituality'}, {'relevance': 0.142333984375, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}, {'relevance': 0.040369223803281784, 'label': 'HealthyLiving>Wellness>AlternativeMedicine'}, {'relevance': 0.02216663584113121, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.020078280940651894, 'label': 'Hobbies&Interests>MagicAndIllusion'}, {'relevance': 0.014196529984474182, 'label': 'MedicalHealth>DiseasesAndConditions>MentalHealth'}, {'relevance': 0.007678268011659384, 'label': 'Religion&Spirituality>Buddhism'}, {'relevance': 0.0045150876976549625, 'label': 'MedicalHealth>DiseasesAndConditions>BrainAndNervousSystemDisorders'}], 'timestamp': {'start': 5887644, 'end': 5926380}, 'sentences_idx_start': 587, 'sentences_idx_end': 588}, {'text': "And I think it's already clear that there's a kind of whole set of folk psychology that's been built around what is or isn't a good way to cultivate a helpful setting and that of course all is a function of action in the world. I think then there's also this kind of more subtler form of action which is how one thinks, how one deploys attention essentially during this experience.", 'labels': [{'relevance': 0.3261592984199524, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.22683119773864746, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}, {'relevance': 0.1461419016122818, 'label': 'MedicalHealth>DiseasesAndConditions>MentalHealth'}, {'relevance': 0.1223072037100792, 'label': 'Religion&Spirituality'}, {'relevance': 0.060775965452194214, 'label': 'HealthyLiving>Wellness>AlternativeMedicine'}, {'relevance': 0.045820191502571106, 'label': 'FamilyAndRelationships>Parenting>ParentingChildrenAged4-11'}, {'relevance': 0.04483393207192421, 'label': 'FamilyAndRelationships>Bereavement'}, {'relevance': 0.037859540432691574, 'label': 'FamilyAndRelationships>Parenting'}, {'relevance': 0.01978682354092598, 'label': 'Education>EarlyChildhoodEducation'}, {'relevance': 0.01305870246142149, 'label': 'HealthyLiving'}], 'timestamp': {'start': 5926800, 'end': 5956376}, 'sentences_idx_start': 589, 'sentences_idx_end': 590}, {'text': "And I think this deployment of attention has a huge effect on whether there end up being rebus or CBIS like effects. Right? So whether one allows oneself to go down certain thought rabbit holes, whether one allows oneself to get kind of stuck in certain kinds of thought patterns. I think this form of mental action has a very big downstream effect and I think a lot of I'd love to see much more work on this.", 'labels': [{'relevance': 0.0758611336350441, 'label': 'MedicalHealth>DiseasesAndConditions>MentalHealth'}, {'relevance': 0.07066044956445694, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.015908630564808846, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.012160182930529118, 'label': 'MedicalHealth>DiseasesAndConditions>BrainAndNervousSystemDisorders'}, {'relevance': 0.01108457800000906, 'label': 'Technology&Computing>VirtualReality'}, {'relevance': 0.003329582279548049, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.0030964775942265987, 'label': 'Education>HomeworkAndStudy'}, {'relevance': 0.0023857594933360815, 'label': 'Technology&Computing>Computing>Internet>SocialNetworking'}, {'relevance': 0.0023033658508211374, 'label': 'FamilyAndRelationships>Bereavement'}, {'relevance': 0.0018946400377899408, 'label': 'MedicalHealth>DiseasesAndConditions>EyeAndVisionConditions'}], 'timestamp': {'start': 5956558, 'end': 5991504}, 'sentences_idx_start': 591, 'sentences_idx_end': 594}, {'text': "I think it's very important, I think it's kind of essential and I think this is kind of one of the most interesting things about these psychedelic experiences is that in some sense, like the most extreme rebus model and the most extreme thebis model could be true for two different individuals, right?", 'labels': [{'relevance': 0.2982872724533081, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.2416362166404724, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.03160491958260536, 'label': 'Religion&Spirituality'}, {'relevance': 0.010623367503285408, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.008914505131542683, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}, {'relevance': 0.003745361929759383, 'label': 'MedicalHealth>DiseasesAndConditions>MentalHealth'}, {'relevance': 0.003129415214061737, 'label': 'Religion&Spirituality>Buddhism'}, {'relevance': 0.002868843963369727, 'label': 'HealthyLiving>Wellness>AlternativeMedicine'}, {'relevance': 0.0023857448250055313, 'label': 'MedicalHealth>DiseasesAndConditions>BrainAndNervousSystemDisorders'}, {'relevance': 0.0018134587444365025, 'label': 'Hobbies&Interests>MagicAndIllusion'}], 'timestamp': {'start': 5991542, 'end': 6011672}, 'sentences_idx_start': 595, 'sentences_idx_end': 595}, {'text': "Someone could say I went to hell and I was there for 8 hours straight, or say I had a completely selfless experience, I let go of all beliefs and experienced nothing for 8 hours straight and it was great. Right? And clearly those involve two very different neural regimes and I think the nature of that and obviously, given that they involve the same drug and they involve not such a different setting, it's obvious that they have something very important to do with how attention is deployed during this experience.", 'labels': [{'relevance': 0.63723224401474, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.5919126868247986, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.20706452429294586, 'label': 'Religion&Spirituality'}, {'relevance': 0.04356621205806732, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.02644733153283596, 'label': 'MedicalHealth>DiseasesAndConditions>MentalHealth'}, {'relevance': 0.017699509859085083, 'label': 'MedicalHealth>DiseasesAndConditions>BrainAndNervousSystemDisorders'}, {'relevance': 0.008171956054866314, 'label': 'Technology&Computing>VirtualReality'}, {'relevance': 0.005668488796800375, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}, {'relevance': 0.0024666967801749706, 'label': 'Religion&Spirituality>Agnosticism'}, {'relevance': 0.0021928497590124607, 'label': 'Hobbies&Interests>MagicAndIllusion'}], 'timestamp': {'start': 6011806, 'end': 6047190}, 'sentences_idx_start': 596, 'sentences_idx_end': 598}, {'text': "Yeah, I do think that this frame of attention, I mean, attention is so important for everything. And I do think that there's something interesting kind of digging into the Attention and Albus framework that yeah, I'm really curious to see how that'll develop. I would also say that in terms of active inference and action, there is a cost to holding an intention and then once you discharge your intention, you can release that cost.", 'labels': [{'relevance': 0.010448123328387737, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.004888378549367189, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.00479451660066843, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.004144292790442705, 'label': 'Technology&Computing>Computing>Internet>SocialNetworking'}, {'relevance': 0.002179825911298394, 'label': 'Religion&Spirituality>Astrology'}, {'relevance': 0.0014215850969776511, 'label': 'BusinessAndFinance>Business>ExecutiveLeadership&Management'}, {'relevance': 0.0013323271414265037, 'label': 'Religion&Spirituality'}, {'relevance': 0.0012859582202509046, 'label': 'Style&Fashion>Beauty'}, {'relevance': 0.0011798599734902382, 'label': 'Education>HomeworkAndStudy'}, {'relevance': 0.0010407066438347101, 'label': 'MedicalHealth>DiseasesAndConditions>EyeAndVisionConditions'}], 'timestamp': {'start': 6050360, 'end': 6087730}, 'sentences_idx_start': 599, 'sentences_idx_end': 601}, {'text': "So I guess I would have to think about how to apply that to the Canals framework. Fred Barrett, I don't know if he's published it yet, but this is kind of like a follow up to a Klaus truly central model that Arthur alluded to is emphasizing basically a lack of executive control and placing that as central to the psychedelic spirits.", 'labels': [{'relevance': 0.3004944622516632, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.02458658069372177, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}, {'relevance': 0.019369184970855713, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.011697473004460335, 'label': 'Religion&Spirituality'}, {'relevance': 0.005545313470065594, 'label': 'Hobbies&Interests>MagicAndIllusion'}, {'relevance': 0.004373630043119192, 'label': 'HealthyLiving>Wellness>AlternativeMedicine'}, {'relevance': 0.002740763360634446, 'label': 'MedicalHealth>DiseasesAndConditions>MentalHealth'}, {'relevance': 0.002149697858840227, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.001815577270463109, 'label': 'MusicAndAudio>Jazz'}, {'relevance': 0.0016205048887059093, 'label': 'BusinessAndFinance>Business>ExecutiveLeadership&Management'}], 'timestamp': {'start': 6089540, 'end': 6115876}, 'sentences_idx_start': 602, 'sentences_idx_end': 603}, {'text': 'Like not controlling your mental action in directed ways as much and then trying to counter more of the types of cognition and phenomenology sort of psychedelics based on just releasing of the normal more agentic modes of policy selection around attention as mental action, although not using active inference. Yeah, very interesting.', 'labels': [{'relevance': 0.35530874133110046, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.09356073290109634, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.07184316962957382, 'label': 'MedicalHealth>DiseasesAndConditions>BrainAndNervousSystemDisorders'}, {'relevance': 0.06734266132116318, 'label': 'MedicalHealth>DiseasesAndConditions>MentalHealth'}, {'relevance': 0.04166670888662338, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.03066648729145527, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}, {'relevance': 0.010442173108458519, 'label': 'Technology&Computing>VirtualReality'}, {'relevance': 0.00876959040760994, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.007823332212865353, 'label': 'Religion&Spirituality'}, {'relevance': 0.006991151720285416, 'label': 'HealthyLiving>Wellness>AlternativeMedicine'}], 'timestamp': {'start': 6115908, 'end': 6141696}, 'sentences_idx_start': 604, 'sentences_idx_end': 605}, {'text': "Adam, your introduction there of course, attention as covert action, which was echoed by Arthur and Michael, both of you said it really introduces a case where we can use active inference to find continuity between what's happening inside the agent and outside the agent. Because on one hand we could kind of take a belief oriented frame and we could say, well, what's happening inside the agent are beliefs about things, beliefs about hidden states, beliefs about observations, beliefs about policy.", 'labels': [{'relevance': 0.008433723822236061, 'label': 'NewsAndPolitics>Politics>WarAndConflicts'}, {'relevance': 0.006081994157284498, 'label': 'NewsAndPolitics>Crime'}, {'relevance': 0.005590105429291725, 'label': 'EventsAndAttractions>PoliticalEvent'}, {'relevance': 0.004687832202762365, 'label': 'Technology&Computing>Computing>InformationAndNetworkSecurity'}, {'relevance': 0.002423492493107915, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.0015263269888237119, 'label': 'NewsAndPolitics>Politics>PoliticalIssues'}, {'relevance': 0.0012282489333301783, 'label': 'PersonalFinance>PersonalInvesting'}, {'relevance': 0.0012280979426577687, 'label': 'PopCulture>CelebrityScandal'}, {'relevance': 0.0009676291956566274, 'label': 'Home&Garden>HomeSecurity'}, {'relevance': 0.0008183767786249518, 'label': 'PersonalFinance>PersonalInvesting>HedgeFunds'}], 'timestamp': {'start': 6141798, 'end': 6176524}, 'sentences_idx_start': 606, 'sentences_idx_end': 607}, {'text': "So that's kind of a belief oriented view where everything is framed basically cognitively. Or we could take a very action oriented view and then we could think about the interface in a more inactive way and then also even the realm of where many active entities dare not tread in mental action with attention as covert action. And so then we have, like, a total active account that is mathematically isomorphic with the total belief based account. They're both just maps. They're not the territory.", 'labels': [{'relevance': 0.819657027721405, 'label': 'Religion&Spirituality'}, {'relevance': 0.7378749251365662, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.12260483205318451, 'label': 'Religion&Spirituality>Agnosticism'}, {'relevance': 0.027213310822844505, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.020385049283504486, 'label': 'Religion&Spirituality>Atheism'}, {'relevance': 0.001202110550366342, 'label': 'Religion&Spirituality>Buddhism'}, {'relevance': 0.0011025759158656001, 'label': 'EventsAndAttractions>PoliticalEvent'}, {'relevance': 0.0011004065163433552, 'label': 'Hobbies&Interests>ContentProduction'}, {'relevance': 0.0010734888492152095, 'label': 'Technology&Computing'}, {'relevance': 0.001016713329590857, 'label': 'Science'}], 'timestamp': {'start': 6176722, 'end': 6212708}, 'sentences_idx_start': 608, 'sentences_idx_end': 612}, {'text': "The territory is the person in the room. So all of this is just talking about the formalism and how we choose to interpret the formalism in terms of it being more inferential or it being more active. And so there's a lot of ways to go, I guess, in our closing minutes, I would love to hear what are the next moves or what are some areas that you would hope that people look into?", 'labels': [{'relevance': 0.01180440653115511, 'label': "Style&Fashion>Men'sFashion>Men'sClothing>Men'sFormalWear"}, {'relevance': 0.010647019371390343, 'label': 'Education>LanguageLearning'}, {'relevance': 0.009189394302666187, 'label': 'BusinessAndFinance>Business>ExecutiveLeadership&Management'}, {'relevance': 0.005707471165806055, 'label': 'Hobbies&Interests>ContentProduction>FreelanceWriting'}, {'relevance': 0.005338893737643957, 'label': 'Technology&Computing>Computing>ComputerSoftwareAndApplications>WebConferencing'}, {'relevance': 0.004490705206990242, 'label': 'RealEstate>OfficeProperty'}, {'relevance': 0.0031261825934052467, 'label': 'EventsAndAttractions>TheaterVenuesAndEvents'}, {'relevance': 0.002838216023519635, 'label': 'Home&Garden>InteriorDecorating'}, {'relevance': 0.0024454391095787287, 'label': 'Education>OnlineEducation'}, {'relevance': 0.0021377340890467167, 'label': 'FineArt>ModernArt'}], 'timestamp': {'start': 6212804, 'end': 6244150}, 'sentences_idx_start': 613, 'sentences_idx_end': 615}, {'text': "Michael and then the know is, I think my favorite mental move is to try to drop down on my level of abstraction. Okay, how is this implemented? What's going on here? And then I do think that details of implementation are really generative to look into and, like, the biomarkers and the proxies for figuring out how to parameterize okay, exactly how hot are we talking about with this temperature parameter and so on in different parts of the body.", 'labels': [{'relevance': 0.183702290058136, 'label': 'MedicalHealth>MedicalTests'}, {'relevance': 0.0064681703224778175, 'label': 'Technology&Computing>Computing>Internet>InternetOfThings'}, {'relevance': 0.005587100517004728, 'label': 'Technology&Computing>ConsumerElectronics>WearableTechnology'}, {'relevance': 0.0021525833290070295, 'label': 'Science'}, {'relevance': 0.0018923222087323666, 'label': 'MedicalHealth>DiseasesAndConditions>EndocrineAndMetabolicDiseases>HormonalDisorders'}, {'relevance': 0.0018693096935749054, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.001475289580412209, 'label': 'MedicalHealth>DiseasesAndConditions>EndocrineAndMetabolicDiseases>Menopause'}, {'relevance': 0.0008947294554673135, 'label': 'HealthyLiving>FitnessAndExercise'}, {'relevance': 0.0006036526756361127, 'label': 'Home&Garden>SmartHome'}, {'relevance': 0.0005370347062125802, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}], 'timestamp': {'start': 6246440, 'end': 6286130}, 'sentences_idx_start': 616, 'sentences_idx_end': 619}, {'text': "I have kind of my niche that I'm working on in the Vasomuscular system, which is a rabbit hole. But, yeah, I do think that the deep canals framework specifically and the canalization paradigm in general, it's good enough that we should be able to dig into mechanism. So I'm looking forward to that. Great. Adam or Arthur, you can go first. Doesn't matter. Okay. Yeah, I'll go. Sure. Yeah.", 'labels': [{'relevance': 0.4641624689102173, 'label': 'MedicalHealth>DiseasesAndConditions>EndocrineAndMetabolicDiseases>HormonalDisorders'}, {'relevance': 0.06132524088025093, 'label': 'MedicalHealth>DiseasesAndConditions>EndocrineAndMetabolicDiseases'}, {'relevance': 0.014218823052942753, 'label': 'MedicalHealth>DiseasesAndConditions>BrainAndNervousSystemDisorders'}, {'relevance': 0.0037022102624177933, 'label': 'MedicalHealth>DiseasesAndConditions>EndocrineAndMetabolicDiseases>ThyroidDisorders'}, {'relevance': 0.002688331762328744, 'label': 'MedicalHealth>DiseasesAndConditions>DigestiveDisorders'}, {'relevance': 0.0013891753042116761, 'label': 'EventsAndAttractions>PersonalCelebrations&LifeEvents>Birth'}, {'relevance': 0.0011315698502585292, 'label': 'MedicalHealth>DiseasesAndConditions>Ear,NoseAndThroatConditions'}, {'relevance': 0.0010315453400835395, 'label': 'MedicalHealth>DiseasesAndConditions>Diabetes'}, {'relevance': 0.0007430256227962673, 'label': 'BusinessAndFinance>Industries>TelecommunicationsIndustry'}, {'relevance': 0.0006599155021831393, 'label': 'MedicalHealth>Surgery'}], 'timestamp': {'start': 6287940, 'end': 6338882}, 'sentences_idx_start': 620, 'sentences_idx_end': 629}, {'text': "I mean, first I want to echo this idea. I think Mexicans is very important. This is one of the people we've talked to about talked with about deep canals. This idea of, like, well, this is great. We have these two axes. It'd be wonderful if there were some biological correlates you could look for. I think that's incredibly important. My background is also in machine learning, in deep learning.", 'labels': [{'relevance': 0.22271384298801422, 'label': 'Science>Genetics'}, {'relevance': 0.012107678689062595, 'label': 'Science'}, {'relevance': 0.003877287032082677, 'label': 'MedicalHealth>DiseasesAndConditions>Ear,NoseAndThroatConditions'}, {'relevance': 0.0037762706633657217, 'label': 'Science>BiologicalSciences'}, {'relevance': 0.00322549557313323, 'label': 'Science>Geology'}, {'relevance': 0.0031193839386105537, 'label': 'EventsAndAttractions>PersonalCelebrations&LifeEvents>Birth'}, {'relevance': 0.0020782670471817255, 'label': 'Religion&Spirituality>Astrology'}, {'relevance': 0.0019791044760495424, 'label': 'MedicalHealth>DiseasesAndConditions>EndocrineAndMetabolicDiseases>HormonalDisorders'}, {'relevance': 0.0013130658771842718, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.0011753159342333674, 'label': 'MedicalHealth>DiseasesAndConditions>ReproductiveHealth>Pregnancy'}], 'timestamp': {'start': 6338936, 'end': 6363610}, 'sentences_idx_start': 630, 'sentences_idx_end': 637}, {'text': "So I'm currently doing some work around simulating some of these things. I think especially for these albus dynamics, being able to kind of study under what circumstances you get these different kinds of effects, even in kind of, like, simple Tory models, is kind of important to see how they unfold. And then we brought it up at the end. I think it's really important. It's very interesting to me is the role of the deployment of attention in this.", 'labels': [{'relevance': 0.019708894193172455, 'label': 'Religion&Spirituality>Astrology'}, {'relevance': 0.0038728108629584312, 'label': 'Technology&Computing>VirtualReality'}, {'relevance': 0.0035473527386784554, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.003070009173825383, 'label': 'NewsAndPolitics>Weather'}, {'relevance': 0.0030105081386864185, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.0028816494159400463, 'label': 'Pets>Birds'}, {'relevance': 0.0021932933013886213, 'label': 'MedicalHealth>DiseasesAndConditions>EyeAndVisionConditions'}, {'relevance': 0.002007496077567339, 'label': 'Science>SpaceAndAstronomy'}, {'relevance': 0.0017756627639755607, 'label': 'Hobbies&Interests>Birdwatching'}, {'relevance': 0.0006221522344276309, 'label': 'PersonalFinance>Insurance>TravelInsurance'}], 'timestamp': {'start': 6363680, 'end': 6395330}, 'sentences_idx_start': 638, 'sentences_idx_end': 642}, {'text': "And there's lines of work where people are trying various researchers are trying to connect, for example, meditation to psychedelic research. And kind of certain people are trying to tell unified stories about what's going on in the brain when people meditate, what's going on under psychedelics, some of them using these active inference models. But I think in all of these cases, the deployment of attention and how the deployment of tension changes over time is kind of a key aspect of this.", 'labels': [{'relevance': 0.17741958796977997, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.1660328507423401, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.12715357542037964, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.06324665248394012, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}, {'relevance': 0.042432356625795364, 'label': 'Religion&Spirituality>Buddhism'}, {'relevance': 0.025554925203323364, 'label': 'MedicalHealth>DiseasesAndConditions>MentalHealth'}, {'relevance': 0.025409378111362457, 'label': 'MedicalHealth>DiseasesAndConditions>BrainAndNervousSystemDisorders'}, {'relevance': 0.015125472098588943, 'label': 'Religion&Spirituality'}, {'relevance': 0.013398729264736176, 'label': 'HealthyLiving>Wellness>AlternativeMedicine'}, {'relevance': 0.0033631070982664824, 'label': 'Technology&Computing>VirtualReality'}], 'timestamp': {'start': 6395480, 'end': 6425774}, 'sentences_idx_start': 643, 'sentences_idx_end': 645}, {'text': "And it's not as present in the deep canals model right now. But I think any really robust future kind of like model of these things is going to have to talk about attention quite a bit. Well, I guess next steps would be seeing how the review process goes, but also I guess helping Arthur to establish a field of psychedelic machine learning. Psychedelic inspired machine learning where we try to make systems more flexible and capable, better.", 'labels': [{'relevance': 0.9964807629585266, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.05283714085817337, 'label': 'Technology&Computing>Robotics'}, {'relevance': 0.015458333306014538, 'label': 'Technology&Computing>Computing'}, {'relevance': 0.009732353501021862, 'label': 'Technology&Computing'}, {'relevance': 0.003140742424875498, 'label': 'Automotive>AutoType>DriverlessCars'}, {'relevance': 0.0020643812604248524, 'label': 'Technology&Computing>Computing>Internet>InternetOfThings'}, {'relevance': 0.0011846725828945637, 'label': 'Technology&Computing>Computing>ProgrammingLanguages'}, {'relevance': 0.0005946091841906309, 'label': 'Science'}, {'relevance': 0.0005913681234233081, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.0005225552013143897, 'label': 'Technology&Computing>Computing>Internet>CloudComputing'}], 'timestamp': {'start': 6425972, 'end': 6468226}, 'sentences_idx_start': 646, 'sentences_idx_end': 649}, {'text': "They can handle edge cases better, imagine better in terms of real time policy selection, learn in ways that not too much, not too little, and then maybe so that's useful, potentially earlier. Like you have a driverless vehicle, do I change lanes or don't I? You send it back to the Tesla, dojo what do you want it to learn, what do you not want it to learn?", 'labels': [{'relevance': 0.9985058307647705, 'label': 'Automotive>AutoType>DriverlessCars'}, {'relevance': 0.19592328369617462, 'label': 'Automotive>AutoTechnology'}, {'relevance': 0.16145867109298706, 'label': 'Automotive>AutoTechnology>AutoInfotainmentTechnologies'}, {'relevance': 0.054824694991111755, 'label': 'Automotive>Road-SideAssistance'}, {'relevance': 0.04535409435629845, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.020349418744444847, 'label': 'Automotive>AutoTechnology>AutoNavigationSystems'}, {'relevance': 0.014193986542522907, 'label': 'Automotive>AutoTechnology>AutoSafetyTechnologies'}, {'relevance': 0.010434982366859913, 'label': 'Automotive>AutoSafety'}, {'relevance': 0.004098286386579275, 'label': 'Technology&Computing>Robotics'}, {'relevance': 0.0036959999706596136, 'label': 'Technology&Computing>Computing>Internet>InternetOfThings'}], 'timestamp': {'start': 6468328, 'end': 6489900}, 'sentences_idx_start': 650, 'sentences_idx_end': 652}, {'text': "But then down the line well before we even get there, as you're going into this you could see the capacity for a rich bi directional flow between machine learning and psychedelic inspired machine learning. So it's like you get a bunch of machine learners together and a bunch of people who know a lot about the cognitive science and biology and maybe phenomenology of psychedelics. And in addition to designing better machine learning systems, they could probably tell you more about how psychedelics act.", 'labels': [{'relevance': 0.9911507368087769, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.01522467564791441, 'label': 'Technology&Computing'}, {'relevance': 0.00874203722923994, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.0074296207167208195, 'label': 'Technology&Computing>Computing'}, {'relevance': 0.005631883163005114, 'label': 'Technology&Computing>Robotics'}, {'relevance': 0.005414582323282957, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.005204832646995783, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.002813836559653282, 'label': 'Science'}, {'relevance': 0.002288072369992733, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}, {'relevance': 0.001611029845662415, 'label': 'Automotive>AutoType>DriverlessCars'}], 'timestamp': {'start': 6490990, 'end': 6520546}, 'sentences_idx_start': 653, 'sentences_idx_end': 655}, {'text': "And so you can have this kind of virtuous cycle between the biology and the field, but you keep going with that before we get there. We'll keep going, but before we get there. Very interested in the implications for best practices. So for instance, oftentimes you might want semantically neutral energy to kind of get them. You're just turning up the heat, you're just maybe at first breaking up, I call them defenses, but the usual structure.", 'labels': [{'relevance': 0.9965469241142273, 'label': 'Science>BiologicalSciences'}, {'relevance': 0.15194034576416016, 'label': 'Science>Genetics'}, {'relevance': 0.009704873897135258, 'label': 'Science>Environment'}, {'relevance': 0.009324651211500168, 'label': 'Science'}, {'relevance': 0.006019089836627245, 'label': 'BusinessAndFinance>Industries>BiotechAndBiomedicalIndustry'}, {'relevance': 0.002698949771001935, 'label': 'MedicalHealth>DiseasesAndConditions>InfectiousDiseases'}, {'relevance': 0.0011262031039223075, 'label': 'Pets>Reptiles'}, {'relevance': 0.0007980988011695445, 'label': 'MedicalHealth>DiseasesAndConditions>EndocrineAndMetabolicDiseases>HormonalDisorders'}, {'relevance': 0.0006108548259362578, 'label': 'BusinessAndFinance>Industries>EnvironmentalServicesIndustry'}, {'relevance': 0.0005606552003882825, 'label': 'Science>Chemistry'}], 'timestamp': {'start': 6520568, 'end': 6550214}, 'sentences_idx_start': 656, 'sentences_idx_end': 660}, {'text': "But then the question is at what point do you try to direct the canalization process? Do you wait till after or maybe when the metal is hot, is that a really good time to do it? And maybe there's no one single question. This might depend on the substance, the set, the setting, the dose, the person. So getting clarity on that could be fateful for many people in terms of the outcomes they have.", 'labels': [{'relevance': 0.9321682453155518, 'label': 'BusinessAndFinance>Industries>MetalsIndustry'}, {'relevance': 0.008296272717416286, 'label': 'Science>Chemistry'}, {'relevance': 0.002065467182546854, 'label': 'Hobbies&Interests>ArtsAndCrafts>JewelryMaking'}, {'relevance': 0.0009319453383795917, 'label': 'Science>Geology'}, {'relevance': 0.0007609048043377697, 'label': 'MedicalHealth>DiseasesAndConditions>BoneAndJointConditions'}, {'relevance': 0.0006182544748298824, 'label': 'BusinessAndFinance>Industries>MechanicalAndIndustrialEngineeringIndustry'}, {'relevance': 0.0005986662581562996, 'label': 'BusinessAndFinance>Economy>Commodities'}, {'relevance': 0.00043570908019319177, 'label': 'Science>Physics'}, {'relevance': 0.000405960192438215, 'label': 'BusinessAndFinance>Industries>ManufacturingIndustry'}, {'relevance': 0.00022926372184883803, 'label': 'BusinessAndFinance>Industries>BiotechAndBiomedicalIndustry'}], 'timestamp': {'start': 6550342, 'end': 6575126}, 'sentences_idx_start': 661, 'sentences_idx_end': 665}, {'text': "And specifically what I'm gunning for is I'm on a mission to make compassion meditation treatment as usual for all psychedelic psychotherapy and preferably all therapy. And so the question is if you're in a state of enhanced imaginative capacity, maybe you're having more ability to tune into your interceptive system, whether you've just increased the channels or maybe you're better capable of because maybe your inflammation went down a bit and you can tune in better because it feels better to do so.", 'labels': [{'relevance': 0.43970999121665955, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.24682551622390747, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}, {'relevance': 0.08330333977937698, 'label': 'HealthyLiving>Wellness>AlternativeMedicine'}, {'relevance': 0.07814880460500717, 'label': 'MedicalHealth>DiseasesAndConditions>MentalHealth'}, {'relevance': 0.02939726784825325, 'label': 'Religion&Spirituality>Buddhism'}, {'relevance': 0.026752740144729614, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.022458167746663094, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.02026589773595333, 'label': 'Religion&Spirituality'}, {'relevance': 0.0017691954271867871, 'label': 'FamilyAndRelationships>Bereavement'}, {'relevance': 0.0012968686642125249, 'label': 'Technology&Computing>VirtualReality'}], 'timestamp': {'start': 6575148, 'end': 6604446}, 'sentences_idx_start': 666, 'sentences_idx_end': 667}, {'text': "Some combination that might be a really good opportunity to do certain meditations that might update you in particular ways like try to direct the re Annealing process, maybe not just like afterwards integration, but during the session. And so if we could get clarity on something like how to canalize and recanalyze, like Annealing schedules. It's going to be complicated, but that's, I think, where we need to head. And then finally for all this, that would be enough.", 'labels': [{'relevance': 0.09945571422576904, 'label': 'HealthyLiving>Wellness>AlternativeMedicine>HolisticHealth'}, {'relevance': 0.05630970001220703, 'label': 'HealthyLiving>Wellness>AlternativeMedicine'}, {'relevance': 0.04864341765642166, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.01673246920108795, 'label': 'Religion&Spirituality>Buddhism'}, {'relevance': 0.005160246975719929, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.0024667857214808464, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}, {'relevance': 0.0013262558495625854, 'label': 'FamilyAndRelationships>Bereavement'}, {'relevance': 0.0012898576678708196, 'label': 'Religion&Spirituality'}, {'relevance': 0.0010034670121967793, 'label': 'Education>OnlineEducation'}, {'relevance': 0.0008323582587763667, 'label': 'MedicalHealth>DiseasesAndConditions>BrainAndNervousSystemDisorders'}], 'timestamp': {'start': 6604548, 'end': 6633062}, 'sentences_idx_start': 668, 'sentences_idx_end': 671}, {'text': "But recentering the conversation on psychedelics, on basically meaning and connection would be enough. But I'm wondering down the line, when we talk of alignment, we're talking about our alignment with our values and maybe the alignments of machines with our values. And so does this actually end up going to some of the conversations that are happening now about increasingly advanced AI and our relationships to it? Could there be a story of cannibalization and recalyzation?", 'labels': [{'relevance': 0.9988769888877869, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.45077770948410034, 'label': 'Technology&Computing'}, {'relevance': 0.08113447576761246, 'label': 'Technology&Computing>Robotics'}, {'relevance': 0.008587989956140518, 'label': 'BusinessAndFinance>Industries>TechnologyIndustry'}, {'relevance': 0.0058118728920817375, 'label': 'Technology&Computing>Computing'}, {'relevance': 0.003262936370447278, 'label': 'Religion&Spirituality>Spirituality'}, {'relevance': 0.003229720052331686, 'label': 'Hobbies&Interests>ParanormalPhenomena'}, {'relevance': 0.002136272843927145, 'label': 'Science'}, {'relevance': 0.0017511233454570174, 'label': 'Automotive>AutoType>DriverlessCars'}, {'relevance': 0.0016017199959605932, 'label': 'MedicalHealth>DiseasesAndConditions>SleepDisorders'}], 'timestamp': {'start': 6633196, 'end': 6663550}, 'sentences_idx_start': 672, 'sentences_idx_end': 675}, {'text': "You want some things to hold fast and you want some things to be more fluid. This might be it's always been a timely conversation. We've always been dealing with this with us, the alignment problem of us, which we often fail, but the alignment problem with these technologies we're developing. Okay, wow. Well, so many great topics. Thank you all. All I have in closing, turn on, tune in, act in, first serve. Thank you.", 'labels': [{'relevance': 0.5772928595542908, 'label': 'Technology&Computing'}, {'relevance': 0.22731617093086243, 'label': 'BusinessAndFinance>Industries>TechnologyIndustry'}, {'relevance': 0.11502291262149811, 'label': 'Technology&Computing>Computing>Internet>ITAndInternetSupport'}, {'relevance': 0.04141128435730934, 'label': 'BusinessAndFinance>Industries>TelecommunicationsIndustry'}, {'relevance': 0.027638591825962067, 'label': 'BusinessAndFinance>Industries>InformationServicesIndustry'}, {'relevance': 0.026623627170920372, 'label': 'Sports>Golf'}, {'relevance': 0.016815025359392166, 'label': 'BusinessAndFinance>Industries>MediaIndustry'}, {'relevance': 0.016517678275704384, 'label': 'Technology&Computing>ArtificialIntelligence'}, {'relevance': 0.01343061774969101, 'label': 'Technology&Computing>Computing>ComputerSoftwareAndApplications>WebConferencing'}, {'relevance': 0.01285101380199194, 'label': 'Careers>RemoteWorking'}], 'timestamp': {'start': 6663970, 'end': 6696600}, 'sentences_idx_start': 676, 'sentences_idx_end': 683}, {'text': 'See you all next time. Bye.', 'labels': [{'relevance': 0.011156873777508736, 'label': "MusicAndAudio>Children'sMusic"}, {'relevance': 0.003193780779838562, 'label': 'MusicAndAudio>TalkRadio'}, {'relevance': 0.0030101914890110493, 'label': 'PopCulture>CelebrityDeaths'}, {'relevance': 0.0023673896212130785, 'label': 'MusicAndAudio>World/InternationalMusic'}, {'relevance': 0.0022971522994339466, 'label': 'Technology&Computing>Computing>Internet>Email'}, {'relevance': 0.001892007072456181, 'label': 'MusicAndAudio>Soundtracks,TVAndShowtunes'}, {'relevance': 0.0015916420379653573, 'label': 'EventsAndAttractions>FanConventions'}, {'relevance': 0.0013020996702834964, 'label': 'Hobbies&Interests>Collecting>ComicBooks'}, {'relevance': 0.0012765080900862813, 'label': 'VideoGaming>VideoGameGenres>CasualGames'}, {'relevance': 0.001249442808330059, 'label': 'Technology&Computing>Computing>ComputerSoftwareAndApp